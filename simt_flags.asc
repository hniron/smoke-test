#include "aicpu_poll_kernel.h"

#include "acl/acl.h"
#include "simt_api/device_atomic_functions.h"

#include <cstdint>

extern "C" __global__ void simt_write_flags_store(uint32_t *flags, uint32_t taskCount, uint32_t delayIters)
{
    if (blockIdx.x != 0 || threadIdx.x != 0) {
        return;
    }

    volatile uint32_t *out = reinterpret_cast<volatile uint32_t *>(flags);
    volatile uint32_t sink = 0;
    for (uint32_t task = 0; task < taskCount; ++task) {
        for (uint32_t i = 0; i < delayIters; ++i) {
            sink = sink + i + task + 1U;
        }
        out[task * kFlagPadCount] = task + 1U;
    }
}

extern "C" __global__ void simt_write_flags_atomic(uint32_t *flags, uint32_t taskCount, uint32_t delayIters)
{
    if (blockIdx.x != 0 || threadIdx.x != 0) {
        return;
    }

    volatile uint32_t sink = 0;
    for (uint32_t task = 0; task < taskCount; ++task) {
        for (uint32_t i = 0; i < delayIters; ++i) {
            sink = sink + i + task + 1U;
        }
#ifdef __NPU_COMPILER_INTERNAL_PURE_SIMT__
        (void)asc_atomic_exch(&flags[task * kFlagPadCount], task + 1U);
#else
        (void)asc_atomic_exch(reinterpret_cast<__gm__ uint32_t *>(&flags[task * kFlagPadCount]), task + 1U);
#endif
    }
}


extern "C" int LaunchSimtWriteFlagsStore(void *flags, uint32_t taskCount, uint32_t delayIters,
    uint32_t simtThreads, aclrtStream stream)
{
    simt_write_flags_store<<<1, simtThreads, 0, stream>>>(
        reinterpret_cast<uint32_t *>(flags), taskCount, delayIters);
    return 0;
}

extern "C" int LaunchSimtWriteFlagsAtomic(void *flags, uint32_t taskCount, uint32_t delayIters,
    uint32_t simtThreads, aclrtStream stream)
{
    simt_write_flags_atomic<<<1, simtThreads, 0, stream>>>(
        reinterpret_cast<uint32_t *>(flags), taskCount, delayIters);
    return 0;
}
