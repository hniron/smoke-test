class KernelHostPayloadFlag {
public:
    __aicore__ inline KernelHostPayloadFlag() {}

    __aicore__ inline void Init(GM_ADDR payload, GM_ADDR flags, uint32_t taskCount)
    {
        taskCount_ = taskCount;
        payloadGm_.SetGlobalBuffer((__gm__ int32_t *)payload, taskCount_ * kPayloadTokenCount);
        flagGm_.SetGlobalBuffer((__gm__ int32_t *)flags, taskCount_ * kFlagStrideWords);
        pipe_.InitBuffer(payloadQueue_, 1, kPayloadTokenCount * sizeof(int32_t));
        pipe_.InitBuffer(flagQueue_, 1, kFlagStrideWords * sizeof(int32_t));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t task = 0; task < taskCount_; ++task) {
            LocalTensor<int32_t> payloadLocal = payloadQueue_.AllocTensor<int32_t>();
            for (uint32_t token = 0; token < kPayloadTokenCount; ++token) {
                payloadLocal.SetValue(token,
                    static_cast<int32_t>(task * kPayloadBatchStride + token));
            }
            LocalSync<HardEvent::S_MTE3>();
            DataCopy(payloadGm_[task * kPayloadTokenCount], payloadLocal, kPayloadTokenCount);
            LocalSync<HardEvent::MTE3_S>();
            payloadQueue_.FreeTensor(payloadLocal);

            LocalTensor<int32_t> flagLocal = flagQueue_.AllocTensor<int32_t>();
            Duplicate<int32_t>(flagLocal, 0, kFlagStrideWords);
            flagLocal.SetValue(0, static_cast<int32_t>(task + 1U));
            LocalSync<HardEvent::S_MTE3>();
            DataCopy(flagGm_[task * kFlagStrideWords], flagLocal, kFlagStrideWords);
            flagQueue_.FreeTensor(flagLocal);
            PipeBarrier<PIPE_ALL>();
        }
    }

private:
    TPipe pipe_;
    TQue<TPosition::VECOUT, 1> payloadQueue_;
    TQue<TPosition::VECOUT, 1> flagQueue_;
    GlobalTensor<int32_t> payloadGm_;
    GlobalTensor<int32_t> flagGm_;
    uint32_t taskCount_ = 0;
};

extern "C" __global__ __aicore__ void aiv_host_payload_flag(GM_ADDR payload, GM_ADDR flags,
    uint32_t taskCount)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    KernelHostPayloadFlag op;
    op.Init(payload, flags, taskCount);
    op.Process();
}

class KernelHostIndexerPayload {
public:
    __aicore__ inline KernelHostIndexerPayload() {}

    __aicore__ inline void Init(GM_ADDR payload, GM_ADDR flags, uint32_t taskCount)
    {
        taskCount_ = taskCount;
        payloadGm_.SetGlobalBuffer((__gm__ int32_t *)payload, taskCount_ * kPayloadTokenCount);
        flagGm_.SetGlobalBuffer((__gm__ int32_t *)flags, taskCount_ * kFlagStrideWords);
        pipe_.InitBuffer(payloadQueue_, 1, kPayloadTokenCount * sizeof(int32_t));
        pipe_.InitBuffer(flagQueue_, 1, kFlagStrideWords * sizeof(int32_t));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t task = 0; task < taskCount_; ++task) {
            LocalTensor<int32_t> payloadLocal = payloadQueue_.AllocTensor<int32_t>();
            for (uint32_t token = 0; token < kPayloadTokenCount; ++token) {
                // Keep all IDs in [0, seq_len). The Host CPU test initializes
                // hits for [0, 1024) and reusable entries for [2048, 3072).
                payloadLocal.SetValue(token, static_cast<int32_t>(token));
            }
            LocalSync<HardEvent::S_MTE3>();
            DataCopy(payloadGm_[task * kPayloadTokenCount], payloadLocal, kPayloadTokenCount);
            LocalSync<HardEvent::MTE3_S>();
            payloadQueue_.FreeTensor(payloadLocal);

            LocalTensor<int32_t> flagLocal = flagQueue_.AllocTensor<int32_t>();
            Duplicate<int32_t>(flagLocal, 0, kFlagStrideWords);
            flagLocal.SetValue(0, static_cast<int32_t>(task + 1U));
            LocalSync<HardEvent::S_MTE3>();
            DataCopy(flagGm_[task * kFlagStrideWords], flagLocal, kFlagStrideWords);
            flagQueue_.FreeTensor(flagLocal);
            PipeBarrier<PIPE_ALL>();
        }
    }

private:
    TPipe pipe_;
    TQue<TPosition::VECOUT, 1> payloadQueue_;
    TQue<TPosition::VECOUT, 1> flagQueue_;
    GlobalTensor<int32_t> payloadGm_;
    GlobalTensor<int32_t> flagGm_;
    uint32_t taskCount_ = 0;
};

extern "C" __global__ __aicore__ void aiv_host_indexer_payload(GM_ADDR payload, GM_ADDR flags,
    uint32_t taskCount)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    KernelHostIndexerPayload op;
    op.Init(payload, flags, taskCount);
    op.Process();
}

namespace {
struct Options {
    int32_t device = 0;
    uint32_t tasks = kDefaultTasks;
    uint32_t seqLen = kIndexerSeqLen;
    uint32_t elements = kDefaultElements;
    uint32_t tile = kDefaultTile;
    uint32_t repeat = kDefaultRepeat;
    uint32_t events = kDefaultEvents;
    uint32_t calibrationEvents = kDefaultEvents;
    uint32_t delayIters = kDefaultDelayIters;
    uint32_t aivPollLimit = kDefaultAivPollLimit;
    uint32_t iters = kDefaultIters;
    uint32_t warmup = kDefaultWarmup;
    uint64_t timeoutMs = kDefaultTimeoutMs;
    bool flushAfterReset = false;
    bool invalidateBeforeRead = false;
    std::string mode = "host_poll_plain";
};

struct Buffers {
    void *x = nullptr;
    void *y = nullptr;
    void *z = nullptr;
    void *flagHost = nullptr;
    void *flagDev = nullptr;
    void *payloadHost = nullptr;
    void *payloadDev = nullptr;
    size_t dataBytes = 0;
    size_t flagBytes = 0;
    size_t flagAllocBytes = 0;
    size_t payloadBytes = 0;
    size_t payloadAllocBytes = 0;
};

struct RunResult {
    double hostTotalUs = 0.0;
    uint64_t startNs = 0;
    uint32_t status = kStatusOk;
    std::vector<uint64_t> seenNs;
    std::vector<uint64_t> pollIters;
    std::vector<uint64_t> aivPollIters;
    std::vector<uint64_t> hostStartNs;
    std::vector<uint64_t> hostEndNs;
    std::vector<uint64_t> deviceRecvCycles;
    std::vector<uint64_t> deviceSendCycles;
    std::vector<uint32_t> finalFlags;
    uint64_t payloadErrors = 0;
    uint64_t indexerPayloadErrors = 0;
    uint64_t indexerOutputErrors = 0;
    uint64_t indexerDoneErrors = 0;
    uint64_t indexerHitTotal = 0;
    uint64_t indexerMissTotal = 0;
    uint32_t indexerCpuStatus = HIXL_INDEXER_UPDATE_STATUS_SUCCESS;
    double indexerCpuUs = 0.0;
    uint64_t timestampErrors = 0;
    std::vector<double> pacedLatencyUs;
    struct ClockCalibration {
        bool valid = false;
        long double scaleNsPerCycle = 0.0L;
        long double offsetNs = 0.0L;
        uint64_t originCycle = 0;
        long double originHostNs = 0.0L;
        double residualP50Us = 0.0;
        double residualP99Us = 0.0;
        double minRttUs = 0.0;
        uint32_t sampleCount = 0;
    } calibration;
};

uint64_t HostNowNs()
{
    return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
        std::chrono::steady_clock::now().time_since_epoch()).count());
}

int Fail(const char *expr, int ret, int line)
{
    std::cerr << "FAIL line " << line << ": " << expr << " ret=" << ret << std::endl;
    const char *recent = aclGetRecentErrMsg();
    if (recent != nullptr && recent[0] != '\0') {
        std::cerr << "ACL recent error: " << recent << std::endl;
    }
    return ret == 0 ? 1 : ret;
}

#define CHECK_ACL(expr) do { aclError _ret = (expr); if (_ret != ACL_SUCCESS) return Fail(#expr, static_cast<int>(_ret), __LINE__); } while (0)

bool ParseU32(const char *arg, const char *name, uint32_t *out)
{
    const size_t n = std::strlen(name);
    if (std::strncmp(arg, name, n) != 0 || arg[n] != '=') return false;
    *out = static_cast<uint32_t>(std::strtoul(arg + n + 1, nullptr, 0));
    return true;
}

bool ParseU64(const char *arg, const char *name, uint64_t *out)
{
    const size_t n = std::strlen(name);
    if (std::strncmp(arg, name, n) != 0 || arg[n] != '=') return false;
    *out = std::strtoull(arg + n + 1, nullptr, 0);
    return true;
}

bool ParseI32(const char *arg, const char *name, int32_t *out)
{
    const size_t n = std::strlen(name);
    if (std::strncmp(arg, name, n) != 0 || arg[n] != '=') return false;
    *out = static_cast<int32_t>(std::strtol(arg + n + 1, nullptr, 0));
    return true;
}

bool ParseBool(const char *arg, const char *name, bool *out)
{
    uint32_t value = 0;
    if (!ParseU32(arg, name, &value)) return false;
    *out = value != 0;
    return true;
}

bool ParseStr(const char *arg, const char *name, std::string *out)
{
    const size_t n = std::strlen(name);
    if (std::strncmp(arg, name, n) != 0 || arg[n] != '=') return false;
    *out = arg + n + 1;
    return true;
}

void Usage(const char *prog)
{
    std::cerr
        << "usage: " << prog << " [--device=0] [--tasks=4] [--seq-len=65536] [--elements=262144]\n"
        << "       [--tile=1024] [--repeat=1] [--events=256] [--calibration-events=256] [--delay-iters=0]\n"
        << "       [--aiv-poll-limit=1000000] [--iters=5] [--warmup=1]\n"
        << "       [--timeout-ms=5000] [--flush-after-reset=0] [--invalidate-before-read=0]\n"
        << "       [--mode=host_poll_plain|host_poll_postcheck|host_payload_poll|host_indexer_update|flag_latency|delay_calib|host_aiv_roundtrip|host_aiv_roundtrip_fast|aiv_host_paced_timestamp|aiv_snoop|all]\n";
}

bool ParseOptions(int argc, char **argv, Options *opt)
{
    for (int i = 1; i < argc; ++i) {
        if (ParseI32(argv[i], "--device", &opt->device) ||
            ParseU32(argv[i], "--tasks", &opt->tasks) ||
            ParseU32(argv[i], "--seq-len", &opt->seqLen) ||
            ParseU32(argv[i], "--elements", &opt->elements) ||
            ParseU32(argv[i], "--tile", &opt->tile) ||
            ParseU32(argv[i], "--repeat", &opt->repeat) ||
            ParseU32(argv[i], "--events", &opt->events) ||
            ParseU32(argv[i], "--calibration-events", &opt->calibrationEvents) ||
            ParseU32(argv[i], "--delay-iters", &opt->delayIters) ||
            ParseU32(argv[i], "--aiv-poll-limit", &opt->aivPollLimit) ||
            ParseU32(argv[i], "--iters", &opt->iters) ||
            ParseU32(argv[i], "--warmup", &opt->warmup) ||
            ParseU64(argv[i], "--timeout-ms", &opt->timeoutMs) ||
            ParseBool(argv[i], "--flush-after-reset", &opt->flushAfterReset) ||
            ParseBool(argv[i], "--invalidate-before-read", &opt->invalidateBeforeRead) ||
            ParseStr(argv[i], "--mode", &opt->mode)) {
            continue;
        }
        return false;
    }
    const bool validMode = opt->mode == "host_poll_plain" || opt->mode == "host_poll_postcheck" ||
        opt->mode == "host_payload_poll" || opt->mode == "host_indexer_update" ||
        opt->mode == "flag_latency" || opt->mode == "delay_calib" ||
        opt->mode == "host_aiv_roundtrip" || opt->mode == "host_aiv_roundtrip_fast" ||
        opt->mode == "aiv_host_paced_timestamp" || opt->mode == "aiv_snoop" ||
        opt->mode == "aiv_noop" || opt->mode == "all";
    if (!validMode || opt->events == 0 || opt->iters == 0 || opt->calibrationEvents == 0) {
        return false;
    }
    if (opt->mode == "host_indexer_update" &&
        (opt->seqLen < kIndexerEvictTokenStart + kIndexerHitTokenCount ||
         opt->seqLen > 262144U)) {
        return false;
    }
    if (opt->mode == "host_aiv_roundtrip") {
        return opt->timeoutMs > 0 && opt->aivPollLimit > 0;
    }
    if (opt->mode == "host_aiv_roundtrip_fast") {
        return opt->timeoutMs > 0;
    }
    if (opt->mode == "aiv_host_paced_timestamp") {
        return opt->timeoutMs > 0;
    }
    return opt->tasks > 0 && opt->elements > 0 && opt->tile > 0 &&
        opt->repeat > 0 && (opt->elements % opt->tile == 0);
}

bool NeedHostPollPlain(const Options &opt)
{
    return opt.mode == "host_poll_plain" || opt.mode == "all";
}

bool NeedHostPollPostcheck(const Options &opt)
{
    return opt.mode == "host_poll_postcheck" || opt.mode == "all";
}

bool NeedHostPayloadPoll(const Options &opt)
{
    return opt.mode == "host_payload_poll";
}

bool NeedHostIndexerUpdate(const Options &opt)
{
    return opt.mode == "host_indexer_update";
}

bool NeedAivSnoop(const Options &opt)
{
    return opt.mode == "aiv_snoop" || opt.mode == "aiv_noop";
}

bool NeedFlagLatency(const Options &opt)
{
    return opt.mode == "flag_latency";
}

bool NeedDelayCalib(const Options &opt)
{
    return opt.mode == "delay_calib";
}

bool NeedHostAivRoundtrip(const Options &opt)
{
    return opt.mode == "host_aiv_roundtrip";
}

bool NeedHostAivRoundtripFast(const Options &opt)
{
    return opt.mode == "host_aiv_roundtrip_fast";
}

bool NeedAivHostPacedTimestamp(const Options &opt)
{
    return opt.mode == "aiv_host_paced_timestamp";
}

bool NeedHostAivRoundtripAny(const Options &opt)
{
    return NeedHostAivRoundtrip(opt) || NeedHostAivRoundtripFast(opt);
}

bool NeedStageData(const Options &opt)
{
    return NeedHostPollPlain(opt) || NeedHostPollPostcheck(opt);
}

bool NeedMappedFlag(const Options &opt)
{
    return NeedStageData(opt) || NeedHostPayloadPoll(opt) || NeedHostIndexerUpdate(opt) || NeedFlagLatency(opt) ||
        NeedHostAivRoundtripAny(opt) || NeedAivHostPacedTimestamp(opt);
}

uint32_t FlagSlotCount(const Options &opt)
{
    if (NeedFlagLatency(opt)) {
        return opt.events;
    }
    if (NeedHostAivRoundtrip(opt)) {
        return RoundtripSlotCount(opt.events);
    }
    if (NeedHostAivRoundtripFast(opt)) {
        return kRoundtripAivPollBaseSlot;
    }
    if (NeedAivHostPacedTimestamp(opt)) {
        return std::max(RoundtripSlotCount(opt.calibrationEvents), PacedSlotCount(opt.events));
    }
    return opt.tasks;
}

double Average(const std::vector<double> &values)
{
    if (values.empty()) return 0.0;
    return std::accumulate(values.begin(), values.end(), 0.0) / static_cast<double>(values.size());
}

std::vector<double> SeenIntervalsUs(const RunResult &result)
{
    std::vector<double> intervals;
    for (size_t i = 1; i < result.seenNs.size(); ++i) {
        if (result.seenNs[i] != 0 && result.seenNs[i - 1] != 0 && result.seenNs[i] >= result.seenNs[i - 1]) {
            intervals.push_back(static_cast<double>(result.seenNs[i] - result.seenNs[i - 1]) / 1000.0);
        }
    }
    return intervals;
}

double PollItersAvg(const RunResult &result)
{
    if (result.pollIters.empty()) return 0.0;
    return static_cast<double>(std::accumulate(result.pollIters.begin(), result.pollIters.end(), uint64_t{0})) /
        static_cast<double>(result.pollIters.size());
}

double MinOrZero(const std::vector<double> &values)
{
    if (values.empty()) return 0.0;
    return *std::min_element(values.begin(), values.end());
}

double MaxOrZero(const std::vector<double> &values)
{
    if (values.empty()) return 0.0;
    return *std::max_element(values.begin(), values.end());
}

uint64_t OnePollCount(const RunResult &result)
{
    return static_cast<uint64_t>(std::count(result.pollIters.begin(), result.pollIters.end(), uint64_t{1}));
}

double FirstSeenUs(const RunResult &result)
{
    if (result.seenNs.empty() || result.startNs == 0 || result.seenNs.front() < result.startNs) return 0.0;
    return static_cast<double>(result.seenNs.front() - result.startNs) / 1000.0;
}

size_t AlignUp(size_t value, size_t align)
{
    return ((value + align - 1) / align) * align;
}

int InitBuffers(const Options &opt, Buffers *buf)
{
    const uint32_t flagSlots = FlagSlotCount(opt);
    buf->flagBytes = static_cast<size_t>(flagSlots) * kFlagStrideWords * sizeof(uint32_t);
    buf->flagAllocBytes = AlignUp(buf->flagBytes, kHostPageAlign);

    if (NeedStageData(opt)) {
        const uint64_t totalElements = static_cast<uint64_t>(opt.tasks) * static_cast<uint64_t>(opt.elements);
        buf->dataBytes = static_cast<size_t>(totalElements) * sizeof(float);
        CHECK_ACL(aclrtMalloc(&buf->x, buf->dataBytes, ACL_MEM_MALLOC_HUGE_FIRST));
        CHECK_ACL(aclrtMalloc(&buf->y, buf->dataBytes, ACL_MEM_MALLOC_HUGE_FIRST));
        CHECK_ACL(aclrtMalloc(&buf->z, buf->dataBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    }
    CHECK_ACL(aclrtMallocHost(&buf->flagHost, buf->flagAllocBytes));
    if (buf->flagHost == nullptr) {
        return Fail("aclrtMallocHost(flagHost)", 1, __LINE__);
    }
    std::memset(buf->flagHost, 0, buf->flagAllocBytes);
    CHECK_ACL(aclrtHostRegister(buf->flagHost, buf->flagAllocBytes, ACL_HOST_REGISTER_MAPPED, &buf->flagDev));

    if (NeedHostPayloadPoll(opt) || NeedHostIndexerUpdate(opt)) {
        buf->payloadBytes = static_cast<size_t>(opt.tasks) * kPayloadTokenCount * sizeof(int32_t);
        buf->payloadAllocBytes = AlignUp(buf->payloadBytes, kHostPageAlign);
        CHECK_ACL(aclrtMallocHost(&buf->payloadHost, buf->payloadAllocBytes));
        if (buf->payloadHost == nullptr) {
            return Fail("aclrtMallocHost(payloadHost)", 1, __LINE__);
        }
        std::memset(buf->payloadHost, 0xa5, buf->payloadAllocBytes);
        CHECK_ACL(aclrtHostRegister(buf->payloadHost, buf->payloadAllocBytes,
            ACL_HOST_REGISTER_MAPPED, &buf->payloadDev));
    }

    if (NeedStageData(opt)) {
        const uint64_t totalElements = static_cast<uint64_t>(opt.tasks) * static_cast<uint64_t>(opt.elements);
        std::vector<float> host(totalElements, 1.0f);
        CHECK_ACL(aclrtMemcpy(buf->x, buf->dataBytes, host.data(), buf->dataBytes, ACL_MEMCPY_HOST_TO_DEVICE));
        CHECK_ACL(aclrtMemcpy(buf->y, buf->dataBytes, host.data(), buf->dataBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    }
    return 0;
}

void FreeBuffers(Buffers *buf)
{
    if (buf->flagHost != nullptr && buf->flagDev != nullptr) {
        (void)aclrtHostUnregister(buf->flagHost);
    }
    if (buf->payloadHost != nullptr && buf->payloadDev != nullptr) {
        (void)aclrtHostUnregister(buf->payloadHost);
    }
    if (buf->x != nullptr) (void)aclrtFree(buf->x);
    if (buf->y != nullptr) (void)aclrtFree(buf->y);
    if (buf->z != nullptr) (void)aclrtFree(buf->z);
    if (buf->flagHost != nullptr) (void)aclrtFreeHost(buf->flagHost);
    if (buf->payloadHost != nullptr) (void)aclrtFreeHost(buf->payloadHost);
    *buf = Buffers{};
}

int ResetBuffers(const Options &opt, const Buffers &buf)
{
    if (buf.z != nullptr && buf.dataBytes > 0) {
        CHECK_ACL(aclrtMemset(buf.z, buf.dataBytes, 0, buf.dataBytes));
    }
    std::memset(buf.flagHost, 0, buf.flagAllocBytes);
    if (buf.payloadHost != nullptr && buf.payloadAllocBytes > 0) {
        std::memset(buf.payloadHost, 0xa5, buf.payloadAllocBytes);
    }
    std::atomic_thread_fence(std::memory_order_seq_cst);
    if (opt.flushAfterReset) {
        CHECK_ACL(aclrtMemFlush(buf.flagDev, buf.flagAllocBytes));
    }
    return 0;
}

void FillFinalFlags(uint32_t count, const Buffers &buf, RunResult *result)
{
    result->finalFlags.assign(count, 0);
    volatile const uint32_t *flags = reinterpret_cast<volatile const uint32_t *>(buf.flagHost);
    for (uint32_t i = 0; i < count; ++i) {
        result->finalFlags[i] = flags[i * kFlagStrideWords];
    }
}

uint32_t ReadHostFlagSlot(const Buffers &buf, uint32_t slot)
{
    volatile const uint32_t *flags = reinterpret_cast<volatile const uint32_t *>(buf.flagHost);
    return flags[slot * kFlagStrideWords];
}

void WriteHostFlagSlot(const Buffers &buf, uint32_t slot, uint32_t value)
{
    volatile uint32_t *flags = reinterpret_cast<volatile uint32_t *>(buf.flagHost);
    flags[slot * kFlagStrideWords] = value;
    std::atomic_thread_fence(std::memory_order_seq_cst);
}

struct DeviceTimestampPair {
    uint64_t recvCycle = 0;
    uint64_t sendCycle = 0;
};

DeviceTimestampPair ReadDeviceTimestampPair(const Buffers &buf, uint32_t slot)
{
    volatile const uint32_t *timestamps = reinterpret_cast<volatile const uint32_t *>(buf.flagHost);
    const size_t index = static_cast<size_t>(slot) * kTimestampWords;
    const uint64_t recvCycle = static_cast<uint64_t>(timestamps[index]) |
        (static_cast<uint64_t>(timestamps[index + 1U]) << 32);
    const uint64_t sendCycle = static_cast<uint64_t>(timestamps[index + 2U]) |
        (static_cast<uint64_t>(timestamps[index + 3U]) << 32);
    return DeviceTimestampPair{recvCycle, sendCycle};
}

uint64_t ReadPacedDeviceCycle(const Buffers &buf, uint32_t event)
{
    volatile const uint32_t *timestamps = reinterpret_cast<volatile const uint32_t *>(buf.flagHost);
    const size_t index = static_cast<size_t>(event) * kTimestampWords;
    return static_cast<uint64_t>(timestamps[index + kPacedCycleLowWord]) |
        (static_cast<uint64_t>(timestamps[index + kPacedCycleHighWord]) << 32);
}

uint64_t ReadPacedSequence(const Buffers &buf, uint32_t event)
{
    volatile const uint32_t *timestamps = reinterpret_cast<volatile const uint32_t *>(buf.flagHost);
    return timestamps[static_cast<size_t>(event) * kTimestampWords + kPacedSequenceWord];
}

void FillAivPollIters(const Options &opt, const Buffers &buf, RunResult *result)
{
    result->aivPollIters.assign(opt.events, 0);
    for (uint32_t i = 0; i < opt.events; ++i) {
        result->aivPollIters[i] = ReadHostFlagSlot(buf, kRoundtripAivPollBaseSlot + i);
    }
}

std::vector<double> NonZeroNsToUs(const std::vector<uint64_t> &values)
{
    std::vector<double> out;
    for (uint64_t value : values) {
        if (value != 0) {
            out.push_back(static_cast<double>(value) / 1000.0);
        }
    }
    return out;
}

double U64Average(const std::vector<uint64_t> &values)
{
    if (values.empty()) return 0.0;
    return static_cast<double>(std::accumulate(values.begin(), values.end(), uint64_t{0})) /
        static_cast<double>(values.size());
}

void PollHostFlags(uint32_t count, const Options &opt, const Buffers &buf, uint64_t startNs, RunResult *result)
{
    result->startNs = startNs;
    result->status = kStatusOk;
    result->seenNs.assign(count, 0);
    result->pollIters.assign(count, 0);
    volatile const uint32_t *flags = reinterpret_cast<volatile const uint32_t *>(buf.flagHost);
    const uint64_t timeoutNs = opt.timeoutMs * 1000000ULL;
    for (uint32_t i = 0; i < count; ++i) {
        const uint32_t expected = i + 1U;
        uint64_t iters = 0;
        for (;;) {
            const uint32_t value = flags[i * kFlagStrideWords];
            ++iters;
            if (value >= expected) {
                result->seenNs[i] = HostNowNs();
                result->pollIters[i] = iters;
                break;
            }
            if ((HostNowNs() - startNs) > timeoutNs) {
                result->status = kStatusTimeout;
                result->seenNs[i] = HostNowNs();
                result->pollIters[i] = iters;
                return;
            }
            if ((iters & 0xffffU) == 0) {
                std::this_thread::yield();
            }
        }
    }
}

double Percentile(std::vector<double> values, double q)
{
    if (values.empty()) return 0.0;
    std::sort(values.begin(), values.end());
    if (q <= 0.0) return values.front();
    if (q >= 1.0) return values.back();
    const double position = q * static_cast<double>(values.size() - 1U);
    const size_t lower = static_cast<size_t>(position);
    const size_t upper = lower + (lower + 1U < values.size() ? 1U : 0U);
    const double fraction = position - static_cast<double>(lower);
    return values[lower] + (values[upper] - values[lower]) * fraction;
}

RunResult::ClockCalibration FitClockCalibration(const RunResult &result)
{
    RunResult::ClockCalibration calibration;
    const size_t count = std::min({result.hostStartNs.size(), result.hostEndNs.size(),
        result.deviceRecvCycles.size(), result.deviceSendCycles.size()});
    if (count < 2U) return calibration;

    size_t firstValid = count;
    for (size_t i = 0; i < count; ++i) {
        if (result.hostStartNs[i] != 0 && result.hostEndNs[i] != 0 &&
            result.deviceRecvCycles[i] != 0 && result.deviceSendCycles[i] != 0 &&
            result.deviceSendCycles[i] >= result.deviceRecvCycles[i]) {
            firstValid = i;
            break;
        }
    }
    if (firstValid == count) return calibration;

    const uint64_t firstDeviceMid = (result.deviceRecvCycles[firstValid] +
        result.deviceSendCycles[firstValid]) / 2U;
    const long double originCycle = static_cast<long double>(firstDeviceMid);
    long double sumDx = 0.0L;
    long double sumY = 0.0L;
    uint32_t validSamples = 0;
    std::vector<long double> x;
    std::vector<long double> y;
    std::vector<double> rttUs;
    x.reserve(count);
    y.reserve(count);
    rttUs.reserve(count);

    for (size_t i = 0; i < count; ++i) {
        if (result.hostStartNs[i] == 0 || result.hostEndNs[i] == 0 ||
            result.deviceRecvCycles[i] == 0 || result.deviceSendCycles[i] == 0 ||
            result.deviceSendCycles[i] < result.deviceRecvCycles[i]) {
            continue;
        }
        const uint64_t deviceMid = (result.deviceRecvCycles[i] + result.deviceSendCycles[i]) / 2U;
        const long double dx = static_cast<long double>(deviceMid) - originCycle;
        const long double hostMid = (static_cast<long double>(result.hostStartNs[i]) +
            static_cast<long double>(result.hostEndNs[i])) / 2.0L;
        x.push_back(dx);
        y.push_back(hostMid);
        sumDx += dx;
        sumY += hostMid;
        rttUs.push_back(static_cast<double>(result.hostEndNs[i] - result.hostStartNs[i]) / 1000.0);
        ++validSamples;
    }
    if (validSamples < 2U) return calibration;

    const long double meanDx = sumDx / static_cast<long double>(validSamples);
    const long double meanY = sumY / static_cast<long double>(validSamples);
    long double covariance = 0.0L;
    long double variance = 0.0L;
    for (size_t i = 0; i < x.size(); ++i) {
        const long double centeredX = x[i] - meanDx;
        const long double centeredY = y[i] - meanY;
        covariance += centeredX * centeredY;
        variance += centeredX * centeredX;
    }
    if (variance <= 0.0L) return calibration;

    calibration.valid = true;
    calibration.scaleNsPerCycle = covariance / variance;
    calibration.originCycle = firstDeviceMid;
    calibration.originHostNs = meanY - calibration.scaleNsPerCycle * meanDx;
    calibration.offsetNs = calibration.originHostNs -
        calibration.scaleNsPerCycle * static_cast<long double>(calibration.originCycle);
    calibration.sampleCount = validSamples;
    calibration.minRttUs = MinOrZero(rttUs);

    std::vector<double> residualUs;
    residualUs.reserve(x.size());
    for (size_t i = 0; i < x.size(); ++i) {
        const long double predicted = calibration.originHostNs + calibration.scaleNsPerCycle * x[i];
        residualUs.push_back(static_cast<double>(std::abs(y[i] - predicted)) / 1000.0);
    }
    calibration.residualP50Us = Percentile(residualUs, 0.50);
    calibration.residualP99Us = Percentile(residualUs, 0.99);
    return calibration;
}

long double DeviceCycleToHostNs(const RunResult::ClockCalibration &calibration, uint64_t deviceCycle)
{
    return calibration.originHostNs + calibration.scaleNsPerCycle *
        (static_cast<long double>(deviceCycle) - static_cast<long double>(calibration.originCycle));
}

void LaunchAivHostPayload(const Options &opt, const Buffers &buf, aclrtStream stream)
{
    aiv_host_payload_flag<<<1, nullptr, stream>>>(
        reinterpret_cast<uint8_t *>(buf.payloadDev),
        reinterpret_cast<uint8_t *>(buf.flagDev), opt.tasks);
}

void LaunchAivHostIndexerPayload(const Options &opt, const Buffers &buf, aclrtStream stream)
{
    aiv_host_indexer_payload<<<1, nullptr, stream>>>(
        reinterpret_cast<uint8_t *>(buf.payloadDev),
        reinterpret_cast<uint8_t *>(buf.flagDev), opt.tasks);
}

void PrepareIndexerCpuCase(const Options &opt, std::vector<int32_t> *seqLens,
    std::vector<int32_t> *cachedSlots, std::vector<int32_t> *hitCount,
    std::vector<int32_t> *hitSlots, std::vector<int32_t> *missCount,
    std::vector<int32_t> *missIds, std::vector<int32_t> *evictSlots,
    std::vector<int32_t> *debugInfo, std::vector<uint32_t> *doneFlags)
{
    const size_t cacheElements = static_cast<size_t>(opt.tasks) * opt.seqLen;
    const size_t outputElements = static_cast<size_t>(opt.tasks) * kPayloadTokenCount;
    seqLens->assign(opt.tasks, static_cast<int32_t>(opt.seqLen));
    cachedSlots->assign(cacheElements, -1);
    hitCount->assign(opt.tasks, -1);
    hitSlots->assign(outputElements, -1);
    missCount->assign(opt.tasks, -1);
    missIds->assign(outputElements, -1);
    evictSlots->assign(outputElements, -1);
    debugInfo->assign(HIXL_INDEXER_UPDATE_DEBUG_COUNT, 0);
    doneFlags->assign(static_cast<size_t>(opt.tasks) * kFlagStrideWords, 0U);

    for (uint32_t batch = 0; batch < opt.tasks; ++batch) {
        const size_t cacheBase = static_cast<size_t>(batch) * opt.seqLen;
        for (uint32_t token = 0; token < kIndexerHitTokenCount; ++token) {
            (*cachedSlots)[cacheBase + token] =
                kIndexerHitSlotBase + static_cast<int32_t>(batch * kPayloadTokenCount + token);
            (*cachedSlots)[cacheBase + kIndexerEvictTokenStart + token] =
                kIndexerEvictSlotBase + static_cast<int32_t>(batch * kPayloadTokenCount + token);
        }
    }
}

void ValidateIndexerCpuCase(const Options &opt, const Buffers &buf,
    const std::vector<int32_t> &cachedSlots, const std::vector<int32_t> &hitCount,
    const std::vector<int32_t> &hitSlots, const std::vector<int32_t> &missCount,
    const std::vector<int32_t> &missIds, const std::vector<int32_t> &evictSlots,
    const std::vector<uint32_t> &doneFlags, RunResult *result)
{
    const volatile int32_t *payload = reinterpret_cast<const volatile int32_t *>(buf.payloadHost);
    for (uint32_t batch = 0; batch < opt.tasks; ++batch) {
        const size_t payloadBase = static_cast<size_t>(batch) * kPayloadTokenCount;
        for (uint32_t token = 0; token < kPayloadTokenCount; ++token) {
            if (payload[payloadBase + token] != static_cast<int32_t>(token)) {
                ++result->indexerPayloadErrors;
            }
        }

        result->indexerHitTotal += hitCount[batch] > 0 ? static_cast<uint64_t>(hitCount[batch]) : 0U;
        result->indexerMissTotal += missCount[batch] > 0 ? static_cast<uint64_t>(missCount[batch]) : 0U;
        if (hitCount[batch] != static_cast<int32_t>(kIndexerHitTokenCount) ||
            missCount[batch] != static_cast<int32_t>(kIndexerHitTokenCount)) {
            ++result->indexerOutputErrors;
        }

        const size_t outputBase = static_cast<size_t>(batch) * kPayloadTokenCount;
        const size_t cacheBase = static_cast<size_t>(batch) * opt.seqLen;
        for (uint32_t token = 0; token < kIndexerHitTokenCount; ++token) {
            const int32_t expectedHitSlot =
                kIndexerHitSlotBase + static_cast<int32_t>(batch * kPayloadTokenCount + token);
            const int32_t expectedEvictSlot =
                kIndexerEvictSlotBase + static_cast<int32_t>(batch * kPayloadTokenCount + token);
            if (hitSlots[outputBase + token] != expectedHitSlot ||
                missIds[outputBase + token] != static_cast<int32_t>(kIndexerHitTokenCount + token) ||
                evictSlots[outputBase + token] != expectedEvictSlot ||
                cachedSlots[cacheBase + kIndexerHitTokenCount + token] != expectedEvictSlot ||
                cachedSlots[cacheBase + kIndexerEvictTokenStart + token] != -1) {
                ++result->indexerOutputErrors;
            }
        }
        if (doneFlags[static_cast<size_t>(batch) * kFlagStrideWords] != 1U) {
            ++result->indexerDoneErrors;
        }
    }
}

int RunHostIndexerUpdate(const Options &opt, const Buffers &buf, aclrtStream stream,
    RunResult *result)
{
    CHECK_ACL(aclrtSynchronizeStream(stream));
    int ret = ResetBuffers(opt, buf);
    if (ret != 0) return ret;

    std::vector<int32_t> seqLens;
    std::vector<int32_t> cachedSlots;
    std::vector<int32_t> hitCount;
    std::vector<int32_t> hitSlots;
    std::vector<int32_t> missCount;
    std::vector<int32_t> missIds;
    std::vector<int32_t> evictSlots;
    std::vector<int32_t> debugInfo;
    std::vector<uint32_t> doneFlags;
    PrepareIndexerCpuCase(opt, &seqLens, &cachedSlots, &hitCount, &hitSlots, &missCount,
                          &missIds, &evictSlots, &debugInfo, &doneFlags);

    HixlIndexerUpdateCpuParam cpuParam{};
    cpuParam.update.magic = HIXL_INDEXER_UPDATE_PARAM_MAGIC;
    cpuParam.update.version = HIXL_INDEXER_UPDATE_PARAM_VERSION;
    cpuParam.update.ready_flags = reinterpret_cast<volatile uint32_t *>(buf.flagHost);
    cpuParam.update.topk_token_ids = reinterpret_cast<const int32_t *>(buf.payloadHost);
    cpuParam.update.seq_lens = seqLens.data();
    cpuParam.update.cached_token_slots = cachedSlots.data();
    cpuParam.update.hit_count = hitCount.data();
    cpuParam.update.hit_token_slots = hitSlots.data();
    cpuParam.update.miss_count = missCount.data();
    cpuParam.update.miss_token_ids = missIds.data();
    cpuParam.update.evict_token_slots = evictSlots.data();
    cpuParam.update.debug_info = debugInfo.data();
    cpuParam.update.batch_size = opt.tasks;
    cpuParam.update.topk = kPayloadTokenCount;
    cpuParam.update.max_seq_len = opt.seqLen;
    cpuParam.update.ready_flag_stride = kFlagStrideWords;
    cpuParam.update.timeout_ns = opt.timeoutMs * 1000000ULL;
    cpuParam.update.poll_mode = 1U;
    cpuParam.update.debug_info_len = static_cast<uint32_t>(debugInfo.size());
    cpuParam.done_flags = reinterpret_cast<volatile uint32_t *>(doneFlags.data());
    cpuParam.done_flag_stride = kFlagStrideWords;
    cpuParam.done_flag_mode = HIXL_INDEXER_UPDATE_CPU_DONE_FLAG_PER_BATCH;

    const uint64_t startNs = HostNowNs();
    LaunchAivHostIndexerPayload(opt, buf, stream);
    const uint64_t cpuStartNs = HostNowNs();
    result->indexerCpuStatus = HixlIndexerUpdateCpu(&cpuParam);
    const uint64_t cpuEndNs = HostNowNs();
    result->indexerCpuUs = static_cast<double>(cpuEndNs - cpuStartNs) / 1000.0;

    aclError syncRet = aclrtSynchronizeStream(stream);
    if (syncRet != ACL_SUCCESS) {
        return Fail("aclrtSynchronizeStream(stream)", static_cast<int>(syncRet), __LINE__);
    }
    const uint64_t endNs = HostNowNs();
    result->startNs = startNs;
    result->hostTotalUs = static_cast<double>(endNs - startNs) / 1000.0;
    result->status = result->indexerCpuStatus == HIXL_INDEXER_UPDATE_STATUS_SUCCESS
        ? kStatusOk : kStatusIndexerUpdateFailed;

    ValidateIndexerCpuCase(opt, buf, cachedSlots, hitCount, hitSlots, missCount, missIds,
                           evictSlots, doneFlags, result);
    if (result->indexerPayloadErrors != 0 || result->indexerOutputErrors != 0 ||
        result->indexerDoneErrors != 0) {
        result->status = kStatusIndexerOutputMismatch;
    }
    FillFinalFlags(opt.tasks, buf, result);
    return 0;
}

int RunHostPayloadPoll(const Options &opt, const Buffers &buf, aclrtStream stream, RunResult *result)
{
    CHECK_ACL(aclrtSynchronizeStream(stream));
    int ret = ResetBuffers(opt, buf);
    if (ret != 0) return ret;

    std::atomic<bool> ready{false};
    std::atomic<bool> go{false};
    uint64_t startNs = 0;
    std::thread poller([&]() {
        ready.store(true, std::memory_order_release);
        while (!go.load(std::memory_order_acquire)) {
            std::this_thread::yield();
        }

        result->startNs = startNs;
        result->status = kStatusOk;
        result->payloadErrors = 0;
        result->seenNs.assign(opt.tasks, 0);
        result->pollIters.assign(opt.tasks, 0);
        volatile const uint32_t *flags = reinterpret_cast<volatile const uint32_t *>(buf.flagHost);
        volatile const int32_t *payload = reinterpret_cast<volatile const int32_t *>(buf.payloadHost);
        const uint64_t timeoutNs = opt.timeoutMs * 1000000ULL;

        for (uint32_t task = 0; task < opt.tasks; ++task) {
            const uint32_t expectedFlag = task + 1U;
            const size_t payloadBase = static_cast<size_t>(task) * kPayloadTokenCount;
            uint64_t iters = 0;
            for (;;) {
                const uint32_t value = flags[task * kFlagStrideWords];
                ++iters;
                if (value >= expectedFlag) {
                    uint64_t errors = 0;
                    for (uint32_t token = 0; token < kPayloadTokenCount; ++token) {
                        const int32_t expected = static_cast<int32_t>(
                            task * kPayloadBatchStride + token);
                        if (payload[payloadBase + token] != expected) {
                            ++errors;
                        }
                    }
                    result->payloadErrors += errors;
                    result->seenNs[task] = HostNowNs();
                    result->pollIters[task] = iters;
                    break;
                }
                if ((HostNowNs() - startNs) > timeoutNs) {
                    result->status = kStatusTimeout;
                    result->seenNs[task] = HostNowNs();
                    result->pollIters[task] = iters;
                    return;
                }
                if ((iters & 0xffffU) == 0) {
                    std::this_thread::yield();
                }
            }
        }
        if (result->payloadErrors != 0) {
            result->status = kStatusPayloadMismatch;
        }
    });

    while (!ready.load(std::memory_order_acquire)) {
        std::this_thread::yield();
    }
    startNs = HostNowNs();
    go.store(true, std::memory_order_release);
    LaunchAivHostPayload(opt, buf, stream);
    aclError syncRet = aclrtSynchronizeStream(stream);
    poller.join();
    if (syncRet != ACL_SUCCESS) {
        return Fail("aclrtSynchronizeStream(stream)", static_cast<int>(syncRet), __LINE__);
    }
    const uint64_t endNs = HostNowNs();
    result->hostTotalUs = static_cast<double>(endNs - startNs) / 1000.0;
    FillFinalFlags(opt.tasks, buf, result);
    return 0;
}

void LaunchAivStageAdd(const Options &opt, const Buffers &buf, aclrtStream stream)
{
    const AivHostCpuTiling tiling{opt.tasks, opt.elements, opt.tile, opt.repeat};
    aiv_multi_stage_add_host_flag<<<1, nullptr, stream>>>(reinterpret_cast<uint8_t *>(buf.x),
        reinterpret_cast<uint8_t *>(buf.y), reinterpret_cast<uint8_t *>(buf.z),
        reinterpret_cast<uint8_t *>(buf.flagDev), tiling);
}

void LaunchAivHostFlagSeries(const Options &opt, const Buffers &buf, aclrtStream stream)
{
    aiv_host_flag_series<<<1, nullptr, stream>>>(
        reinterpret_cast<uint8_t *>(buf.flagDev), opt.events, opt.delayIters);
}

void LaunchAivDelayCalib(const Options &opt, aclrtStream stream)
{
    aiv_delay_calib<<<1, nullptr, stream>>>(opt.events, opt.delayIters);
}

void LaunchHostAivRoundtrip(const Options &opt, const Buffers &buf, aclrtStream stream)
{
    aiv_host_aiv_roundtrip<<<1, nullptr, stream>>>(
        reinterpret_cast<uint8_t *>(buf.flagDev), opt.events, opt.aivPollLimit);
}

void LaunchHostAivRoundtripFast(const Options &opt, const Buffers &buf, aclrtStream stream)
{
    aiv_host_aiv_roundtrip_fast<<<1, nullptr, stream>>>(
        reinterpret_cast<uint8_t *>(buf.flagDev), opt.events);
}

void LaunchAivHostPacedTimestamp(const Options &opt, const Buffers &buf, aclrtStream stream)
{
    aiv_host_paced_timestamp<<<1, nullptr, stream>>>(
        reinterpret_cast<uint8_t *>(buf.flagDev), opt.events, opt.delayIters);
}

int RunAivSnoop(aclrtStream stream, double *hostUs)
{
    CHECK_ACL(aclrtSynchronizeStream(stream));
    const uint64_t start = HostNowNs();
    aiv_snoop<<<1, nullptr, stream>>>();
    CHECK_ACL(aclrtSynchronizeStream(stream));
    const uint64_t end = HostNowNs();
    *hostUs = static_cast<double>(end - start) / 1000.0;
    return 0;
}

int RunHostPollPlain(const Options &opt, const Buffers &buf, aclrtStream stream, RunResult *result)
{
    CHECK_ACL(aclrtSynchronizeStream(stream));
    int ret = ResetBuffers(opt, buf);
    if (ret != 0) return ret;

    std::atomic<bool> ready{false};
    std::atomic<bool> go{false};
    uint64_t startNs = 0;
    std::thread poller([&]() {
        ready.store(true, std::memory_order_release);
        while (!go.load(std::memory_order_acquire)) {
            std::this_thread::yield();
        }
        PollHostFlags(opt.tasks, opt, buf, startNs, result);
    });
    while (!ready.load(std::memory_order_acquire)) {
        std::this_thread::yield();
    }

    startNs = HostNowNs();
    go.store(true, std::memory_order_release);
    LaunchAivStageAdd(opt, buf, stream);
    aclError syncRet = aclrtSynchronizeStream(stream);
    poller.join();
    if (syncRet != ACL_SUCCESS) {
        return Fail("aclrtSynchronizeStream(stream)", static_cast<int>(syncRet), __LINE__);
    }
    const uint64_t endNs = HostNowNs();
    result->hostTotalUs = static_cast<double>(endNs - startNs) / 1000.0;
    FillFinalFlags(opt.tasks, buf, result);
    return 0;
}

int RunHostPollPostcheck(const Options &opt, const Buffers &buf, aclrtStream stream, RunResult *result)
{
    CHECK_ACL(aclrtSynchronizeStream(stream));
    int ret = ResetBuffers(opt, buf);
    if (ret != 0) return ret;

    const uint64_t startNs = HostNowNs();
    LaunchAivStageAdd(opt, buf, stream);
    CHECK_ACL(aclrtSynchronizeStream(stream));
    if (opt.invalidateBeforeRead) {
        CHECK_ACL(aclrtMemInvalidate(buf.flagDev, buf.flagAllocBytes));
    }
    const uint64_t endNs = HostNowNs();

    result->hostTotalUs = static_cast<double>(endNs - startNs) / 1000.0;
    result->startNs = startNs;
    result->status = kStatusOk;
    result->seenNs.assign(opt.tasks, 0);
    result->pollIters.assign(opt.tasks, 1);
    FillFinalFlags(opt.tasks, buf, result);
    for (uint32_t i = 0; i < opt.tasks; ++i) {
        result->seenNs[i] = endNs;
        if (result->finalFlags[i] < i + 1U) {
            result->status = kStatusPostcheckFailed;
        }
    }
    return 0;
}

int RunFlagLatency(const Options &opt, const Buffers &buf, aclrtStream stream, RunResult *result)
{
    CHECK_ACL(aclrtSynchronizeStream(stream));
    int ret = ResetBuffers(opt, buf);
    if (ret != 0) return ret;

    std::atomic<bool> ready{false};
    std::atomic<bool> go{false};
    uint64_t startNs = 0;
    std::thread poller([&]() {
        ready.store(true, std::memory_order_release);
        while (!go.load(std::memory_order_acquire)) {
            std::this_thread::yield();
        }
        PollHostFlags(opt.events, opt, buf, startNs, result);
    });
    while (!ready.load(std::memory_order_acquire)) {
        std::this_thread::yield();
    }

    startNs = HostNowNs();
    go.store(true, std::memory_order_release);
    LaunchAivHostFlagSeries(opt, buf, stream);
    aclError syncRet = aclrtSynchronizeStream(stream);
    poller.join();
    if (syncRet != ACL_SUCCESS) {
        return Fail("aclrtSynchronizeStream(stream)", static_cast<int>(syncRet), __LINE__);
    }
    const uint64_t endNs = HostNowNs();
    result->hostTotalUs = static_cast<double>(endNs - startNs) / 1000.0;
    FillFinalFlags(opt.events, buf, result);
    return 0;
}

int RunDelayCalib(const Options &opt, aclrtStream stream, double *hostUs)
{
    CHECK_ACL(aclrtSynchronizeStream(stream));
    const uint64_t start = HostNowNs();
    LaunchAivDelayCalib(opt, stream);
    CHECK_ACL(aclrtSynchronizeStream(stream));
    const uint64_t end = HostNowNs();
    *hostUs = static_cast<double>(end - start) / 1000.0;
    return 0;
}

int RunHostAivRoundtrip(const Options &opt, const Buffers &buf, aclrtStream stream, RunResult *result)
{
    CHECK_ACL(aclrtSynchronizeStream(stream));
    int ret = ResetBuffers(opt, buf);
    if (ret != 0) return ret;

    result->status = kStatusOk;
    result->seenNs.assign(opt.events, 0);
    result->pollIters.assign(opt.events, 0);
    result->aivPollIters.assign(opt.events, 0);
    result->hostStartNs.assign(opt.events, 0);
    result->hostEndNs.assign(opt.events, 0);
    result->deviceRecvCycles.assign(opt.events, 0);
    result->deviceSendCycles.assign(opt.events, 0);
    result->calibration = RunResult::ClockCalibration{};
    const uint64_t timeoutNs = opt.timeoutMs * 1000000ULL;

    const uint64_t launchNs = HostNowNs();
    LaunchHostAivRoundtrip(opt, buf, stream);

    uint64_t readyPolls = 0;
    while (ReadHostFlagSlot(buf, kRoundtripReadySlot) == 0) {
        ++readyPolls;
        if ((HostNowNs() - launchNs) > timeoutNs) {
            result->status = kStatusTimeout;
            WriteHostFlagSlot(buf, kRoundtripAbortSlot, 1);
            break;
        }
        if ((readyPolls & 0xffffU) == 0) {
            std::this_thread::yield();
        }
    }

    uint64_t endNs = HostNowNs();
    if (result->status == kStatusOk) {
        result->startNs = HostNowNs();
        for (uint32_t seq = 1; seq <= opt.events; ++seq) {
            const uint32_t idx = seq - 1U;
            const uint64_t seqStart = HostNowNs();
            WriteHostFlagSlot(buf, kRoundtripCpuReqSlot, seq);
            uint64_t hostPolls = 0;
            for (;;) {
                ++hostPolls;
                if (ReadHostFlagSlot(buf, kRoundtripAivAckSlot) >= seq) {
                    const uint64_t seqEnd = HostNowNs();
                    result->seenNs[idx] = seqEnd - seqStart;
                    result->pollIters[idx] = hostPolls;
                    result->hostStartNs[idx] = seqStart;
                    result->hostEndNs[idx] = seqEnd;
                    const DeviceTimestampPair timestamp = ReadDeviceTimestampPair(
                        buf, RoundtripTimestampBaseSlot(opt.events) + idx);
                    result->deviceRecvCycles[idx] = timestamp.recvCycle;
                    result->deviceSendCycles[idx] = timestamp.sendCycle;
                    break;
                }
                const uint32_t aivStatus = ReadHostFlagSlot(buf, kRoundtripStatusSlot);
                if (aivStatus != kStatusOk) {
                    result->status = aivStatus;
                    result->pollIters[idx] = hostPolls;
                    break;
                }
                if ((HostNowNs() - seqStart) > timeoutNs) {
                    result->status = kStatusTimeout;
                    result->pollIters[idx] = hostPolls;
                    WriteHostFlagSlot(buf, kRoundtripAbortSlot, 1);
                    break;
                }
                if ((hostPolls & 0xffffU) == 0) {
                    std::this_thread::yield();
                }
            }
            if (result->status != kStatusOk) {
                break;
            }
        }
        endNs = HostNowNs();
        result->hostTotalUs = static_cast<double>(endNs - result->startNs) / 1000.0;
    } else {
        result->startNs = launchNs;
        result->hostTotalUs = static_cast<double>(endNs - launchNs) / 1000.0;
    }

    aclError syncRet = aclrtSynchronizeStream(stream);
    if (syncRet != ACL_SUCCESS) {
        return Fail("aclrtSynchronizeStream(stream)", static_cast<int>(syncRet), __LINE__);
    }
    FillFinalFlags(kRoundtripAivPollBaseSlot, buf, result);
    FillAivPollIters(opt, buf, result);
    const uint32_t finalStatus = ReadHostFlagSlot(buf, kRoundtripStatusSlot);
    if (result->status == kStatusOk && finalStatus != kStatusOk) {
        result->status = finalStatus;
    }
    if (result->status == kStatusOk) {
        result->calibration = FitClockCalibration(*result);
    }
    return 0;
}

void FillPacedFinalFlags(const Options &opt, const Buffers &buf, RunResult *result)
{
    result->finalFlags.assign(opt.events, 0);
    volatile const uint32_t *flags = reinterpret_cast<volatile const uint32_t *>(buf.flagHost);
    for (uint32_t event = 0; event < opt.events; ++event) {
        result->finalFlags[event] = flags[event * kFlagStrideWords + kPacedReadyWord];
    }
}

int RunAivHostPacedTimestamp(const Options &opt, const Buffers &buf, aclrtStream stream,
    RunResult *result)
{
    Options calibrationOpt = opt;
    calibrationOpt.mode = "host_aiv_roundtrip";
    calibrationOpt.events = opt.calibrationEvents;

    RunResult calibrationResult;
    int ret = RunHostAivRoundtrip(calibrationOpt, buf, stream, &calibrationResult);
    if (ret != 0) return ret;

    result->calibration = calibrationResult.calibration;
    result->status = calibrationResult.status;
    if (result->status != kStatusOk || !result->calibration.valid) {
        if (result->status == kStatusOk) result->status = kStatusCalibrationInvalid;
        return 0;
    }

    ret = ResetBuffers(opt, buf);
    if (ret != 0) return ret;

    result->seenNs.assign(opt.events, 0);
    result->pollIters.assign(opt.events, 0);
    result->pacedLatencyUs.assign(opt.events, 0.0);
    result->timestampErrors = 0;

    std::atomic<bool> ready{false};
    std::atomic<bool> go{false};
    uint64_t startNs = 0;
    std::thread poller([&]() {
        ready.store(true, std::memory_order_release);
        while (!go.load(std::memory_order_acquire)) {
            std::this_thread::yield();
        }

        result->startNs = startNs;
        result->status = kStatusOk;
        volatile const uint32_t *flags = reinterpret_cast<volatile const uint32_t *>(buf.flagHost);
        const uint64_t timeoutNs = opt.timeoutMs * 1000000ULL;

        for (uint32_t event = 0; event < opt.events; ++event) {
            const uint32_t expected = event + 1U;
            uint64_t polls = 0;
            for (;;) {
                const uint32_t value = flags[event * kFlagStrideWords + kPacedReadyWord];
                ++polls;
                if (value >= expected) {
                    const uint64_t hostSeenNs = HostNowNs();
                    const uint64_t deviceCycle = ReadPacedDeviceCycle(buf, event);
                    const uint64_t recordSequence = ReadPacedSequence(buf, event);
                    if (recordSequence != expected) {
                        ++result->timestampErrors;
                    }
                    const long double deviceWriteHostNs = DeviceCycleToHostNs(
                        result->calibration, deviceCycle);
                    result->seenNs[event] = hostSeenNs;
                    result->pollIters[event] = polls;
                    result->pacedLatencyUs[event] = static_cast<double>(
                        (static_cast<long double>(hostSeenNs) - deviceWriteHostNs) / 1000.0L);
                    break;
                }
                if ((HostNowNs() - startNs) > timeoutNs) {
                    result->status = kStatusTimeout;
                    result->pollIters[event] = polls;
                    return;
                }
                if ((polls & 0xffffU) == 0) {
                    std::this_thread::yield();
                }
            }
        }
        if (result->timestampErrors != 0) {
            result->status = kStatusPostcheckFailed;
        }
    });

    while (!ready.load(std::memory_order_acquire)) {
        std::this_thread::yield();
    }
    startNs = HostNowNs();
    go.store(true, std::memory_order_release);
    LaunchAivHostPacedTimestamp(opt, buf, stream);
    aclError syncRet = aclrtSynchronizeStream(stream);
    poller.join();
    if (syncRet != ACL_SUCCESS) {
        return Fail("aclrtSynchronizeStream(stream)", static_cast<int>(syncRet), __LINE__);
    }
    const uint64_t endNs = HostNowNs();
    result->hostTotalUs = static_cast<double>(endNs - startNs) / 1000.0;
    FillPacedFinalFlags(opt, buf, result);
    return 0;
}

int RunHostAivRoundtripFast(const Options &opt, const Buffers &buf, aclrtStream stream, RunResult *result)
{
    CHECK_ACL(aclrtSynchronizeStream(stream));
    int ret = ResetBuffers(opt, buf);
    if (ret != 0) return ret;

    result->status = kStatusOk;
    result->seenNs.assign(opt.events, 0);
    result->pollIters.clear();
    result->aivPollIters.clear();
    const uint64_t timeoutNs = opt.timeoutMs * 1000000ULL;

    const uint64_t launchNs = HostNowNs();
    LaunchHostAivRoundtripFast(opt, buf, stream);

    while (ReadHostFlagSlot(buf, kRoundtripReadySlot) == 0) {
        if ((HostNowNs() - launchNs) > timeoutNs) {
            result->status = kStatusTimeout;
            WriteHostFlagSlot(buf, kRoundtripCpuReqSlot, opt.events);
            break;
        }
    }

    uint64_t endNs = HostNowNs();
    if (result->status == kStatusOk) {
        volatile uint32_t *flags = reinterpret_cast<volatile uint32_t *>(buf.flagHost);
        const uint32_t reqIndex = kRoundtripCpuReqSlot * kFlagStrideWords;
        const uint32_t ackIndex = kRoundtripAivAckSlot * kFlagStrideWords;
        result->startNs = HostNowNs();
        for (uint32_t seq = 1; seq <= opt.events; ++seq) {
            const uint32_t idx = seq - 1U;
            const uint64_t seqStart = HostNowNs();
            flags[reqIndex] = seq;
            std::atomic_thread_fence(std::memory_order_seq_cst);
            while (flags[ackIndex] < seq) {}
            const uint64_t seqEnd = HostNowNs();
            result->seenNs[idx] = seqEnd - seqStart;
        }
        endNs = HostNowNs();
        result->hostTotalUs = static_cast<double>(endNs - result->startNs) / 1000.0;
    } else {
        result->startNs = launchNs;
        result->hostTotalUs = static_cast<double>(endNs - launchNs) / 1000.0;
    }

    aclError syncRet = aclrtSynchronizeStream(stream);
    if (syncRet != ACL_SUCCESS) {
        return Fail("aclrtSynchronizeStream(stream)", static_cast<int>(syncRet), __LINE__);
    }
    FillFinalFlags(kRoundtripAivPollBaseSlot, buf, result);
    const uint32_t finalStatus = ReadHostFlagSlot(buf, kRoundtripStatusSlot);
    if (result->status == kStatusOk && finalStatus != kStatusOk) {
        result->status = finalStatus;
    }
    if (result->status == kStatusOk && ReadHostFlagSlot(buf, kRoundtripAivAckSlot) < opt.events) {
        result->status = kStatusPostcheckFailed;
    }
    return 0;
}

void PrintRun(const char *name, const Options &opt, const RunResult &result)
{
    const auto intervals = SeenIntervalsUs(result);
    const uint32_t firstFlag = result.finalFlags.empty() ? 0 : result.finalFlags.front();
    const uint32_t lastFlag = result.finalFlags.empty() ? 0 : result.finalFlags.back();
    const uint64_t firstPoll = result.pollIters.empty() ? 0 : result.pollIters.front();
    const uint64_t lastPoll = result.pollIters.empty() ? 0 : result.pollIters.back();
    std::cout << name
              << " status=" << result.status
              << " host_total_us=" << std::fixed << std::setprecision(2) << result.hostTotalUs
              << " host_per_task_us=" << (result.hostTotalUs / static_cast<double>(opt.tasks))
              << " host_seen_interval_avg_us=" << Average(intervals)
              << " poll_iters_avg=" << PollItersAvg(result)
              << " first_poll_iters=" << firstPoll
              << " last_poll_iters=" << lastPoll
              << " first_flag=" << firstFlag
              << " last_flag=" << lastFlag
              << std::endl;
}

void PrintHostPayload(const Options &opt, const RunResult &result)
{
    const uint32_t firstFlag = result.finalFlags.empty() ? 0 : result.finalFlags.front();
    const uint32_t lastFlag = result.finalFlags.empty() ? 0 : result.finalFlags.back();
    const uint64_t firstPoll = result.pollIters.empty() ? 0 : result.pollIters.front();
    const uint64_t lastPoll = result.pollIters.empty() ? 0 : result.pollIters.back();
    std::cout << "host_payload_poll"
              << " status=" << result.status
              << " host_total_us=" << std::fixed << std::setprecision(2) << result.hostTotalUs
              << " host_per_batch_us=" << (result.hostTotalUs / static_cast<double>(opt.tasks))
              << " payload_errors=" << result.payloadErrors
              << " poll_iters_avg=" << PollItersAvg(result)
              << " first_poll_iters=" << firstPoll
              << " last_poll_iters=" << lastPoll
              << " first_flag=" << firstFlag
              << " last_flag=" << lastFlag
              << std::endl;
}

void PrintHostIndexerUpdate(const RunResult &result)
{
    const uint32_t firstFlag = result.finalFlags.empty() ? 0 : result.finalFlags.front();
    const uint32_t lastFlag = result.finalFlags.empty() ? 0 : result.finalFlags.back();
    std::cout << "host_indexer_update"
              << " status=" << result.status
              << " cpu_status=" << result.indexerCpuStatus
              << " host_total_us=" << std::fixed << std::setprecision(2) << result.hostTotalUs
              << " cpu_update_us=" << result.indexerCpuUs
              << " payload_errors=" << result.indexerPayloadErrors
              << " output_errors=" << result.indexerOutputErrors
              << " done_errors=" << result.indexerDoneErrors
              << " hit_total=" << result.indexerHitTotal
              << " miss_total=" << result.indexerMissTotal
              << " first_flag=" << firstFlag
              << " last_flag=" << lastFlag
              << std::endl;
}

void PrintFlagLatency(const Options &opt, const RunResult &result)
{
    const auto intervals = SeenIntervalsUs(result);
    const uint32_t firstFlag = result.finalFlags.empty() ? 0 : result.finalFlags.front();
    const uint32_t lastFlag = result.finalFlags.empty() ? 0 : result.finalFlags.back();
    const uint64_t firstPoll = result.pollIters.empty() ? 0 : result.pollIters.front();
    const uint64_t lastPoll = result.pollIters.empty() ? 0 : result.pollIters.back();
    std::cout << "flag_latency"
              << " status=" << result.status
              << " host_total_us=" << std::fixed << std::setprecision(2) << result.hostTotalUs
              << " host_per_event_us=" << (result.hostTotalUs / static_cast<double>(opt.events))
              << " first_seen_us=" << FirstSeenUs(result)
              << " seen_interval_avg_us=" << Average(intervals)
              << " seen_interval_min_us=" << MinOrZero(intervals)
              << " seen_interval_max_us=" << MaxOrZero(intervals)
              << " poll_iters_avg=" << PollItersAvg(result)
              << " one_poll_count=" << OnePollCount(result)
              << " first_poll_iters=" << firstPoll
              << " last_poll_iters=" << lastPoll
              << " first_flag=" << firstFlag
              << " last_flag=" << lastFlag
              << std::endl;
}

void PrintHostAivRoundtrip(const Options &opt, const RunResult &result)
{
    const auto roundtripUs = NonZeroNsToUs(result.seenNs);
    const uint64_t firstHostPoll = result.pollIters.empty() ? 0 : result.pollIters.front();
    const uint64_t lastHostPoll = result.pollIters.empty() ? 0 : result.pollIters.back();
    const uint64_t firstAivPoll = result.aivPollIters.empty() ? 0 : result.aivPollIters.front();
    const uint64_t lastAivPoll = result.aivPollIters.empty() ? 0 : result.aivPollIters.back();
    const uint32_t ready = result.finalFlags.size() > kRoundtripReadySlot ? result.finalFlags[kRoundtripReadySlot] : 0;
    const uint32_t req = result.finalFlags.size() > kRoundtripCpuReqSlot ? result.finalFlags[kRoundtripCpuReqSlot] : 0;
    const uint32_t ack = result.finalFlags.size() > kRoundtripAivAckSlot ? result.finalFlags[kRoundtripAivAckSlot] : 0;
    const uint32_t status = result.finalFlags.size() > kRoundtripStatusSlot ? result.finalFlags[kRoundtripStatusSlot] : result.status;
    const uint32_t abort = result.finalFlags.size() > kRoundtripAbortSlot ? result.finalFlags[kRoundtripAbortSlot] : 0;
    std::cout << "host_aiv_roundtrip"
              << " status=" << result.status
              << " host_total_us=" << std::fixed << std::setprecision(2) << result.hostTotalUs
              << " roundtrip_avg_us=" << Average(roundtripUs)
              << " roundtrip_min_us=" << MinOrZero(roundtripUs)
              << " roundtrip_max_us=" << MaxOrZero(roundtripUs)
              << " host_poll_iters_avg=" << PollItersAvg(result)
              << " aiv_poll_iters_avg=" << U64Average(result.aivPollIters)
              << " first_host_poll_iters=" << firstHostPoll
              << " last_host_poll_iters=" << lastHostPoll
              << " first_aiv_poll_iters=" << firstAivPoll
              << " last_aiv_poll_iters=" << lastAivPoll
              << " ready=" << ready
              << " final_req=" << req
              << " final_ack=" << ack
              << " final_status=" << status
              << " abort=" << abort
              << " clock_valid=" << (result.calibration.valid ? 1 : 0)
              << " clock_samples=" << result.calibration.sampleCount
              << " clock_scale_ns_per_cycle=" << std::setprecision(12)
              << static_cast<double>(result.calibration.scaleNsPerCycle)
              << " clock_offset_ns=" << std::setprecision(3)
              << static_cast<double>(result.calibration.offsetNs)
              << std::setprecision(2)
              << " clock_min_rtt_us=" << result.calibration.minRttUs
              << " clock_residual_p50_us=" << result.calibration.residualP50Us
              << " clock_residual_p99_us=" << result.calibration.residualP99Us
              << std::endl;
}

void PrintAivHostPacedTimestamp(const Options &opt, const RunResult &result)
{
    const std::vector<double> &latencies = result.pacedLatencyUs;
    std::cout << "aiv_host_paced_timestamp"
              << " status=" << result.status
              << " host_total_us=" << std::fixed << std::setprecision(2) << result.hostTotalUs
              << " host_per_event_us=" << (result.hostTotalUs / static_cast<double>(opt.events))
              << " latency_avg_us=" << Average(latencies)
              << " latency_p50_us=" << Percentile(latencies, 0.50)
              << " latency_p99_us=" << Percentile(latencies, 0.99)
              << " latency_min_us=" << MinOrZero(latencies)
              << " latency_max_us=" << MaxOrZero(latencies)
              << " calibration_samples=" << result.calibration.sampleCount
              << " calibration_min_rtt_us=" << result.calibration.minRttUs
              << " calibration_scale_ns_per_cycle="
              << std::setprecision(12) << static_cast<double>(result.calibration.scaleNsPerCycle)
              << std::setprecision(2)
              << " calibration_residual_p50_us=" << result.calibration.residualP50Us
              << " calibration_residual_p99_us=" << result.calibration.residualP99Us
              << " timestamp_errors=" << result.timestampErrors
              << " one_poll_count=" << OnePollCount(result)
              << std::endl;
}

void PrintHostAivRoundtripFast(const RunResult &result)
{
    const auto roundtripUs = NonZeroNsToUs(result.seenNs);
    const uint32_t ready = result.finalFlags.size() > kRoundtripReadySlot ? result.finalFlags[kRoundtripReadySlot] : 0;
    const uint32_t req = result.finalFlags.size() > kRoundtripCpuReqSlot ? result.finalFlags[kRoundtripCpuReqSlot] : 0;
    const uint32_t ack = result.finalFlags.size() > kRoundtripAivAckSlot ? result.finalFlags[kRoundtripAivAckSlot] : 0;
    const uint32_t status = result.finalFlags.size() > kRoundtripStatusSlot ? result.finalFlags[kRoundtripStatusSlot] : result.status;
    const uint32_t abort = result.finalFlags.size() > kRoundtripAbortSlot ? result.finalFlags[kRoundtripAbortSlot] : 0;
    std::cout << "host_aiv_roundtrip_fast"
              << " status=" << result.status
              << " host_total_us=" << std::fixed << std::setprecision(2) << result.hostTotalUs
              << " roundtrip_avg_us=" << Average(roundtripUs)
              << " roundtrip_min_us=" << MinOrZero(roundtripUs)
              << " roundtrip_max_us=" << MaxOrZero(roundtripUs)
              << " ready=" << ready
              << " final_req=" << req
              << " final_ack=" << ack
              << " final_status=" << status
              << " abort=" << abort
              << std::endl;
}

void PrintDelayCalib(const Options &opt, double hostUs)
{
    std::cout << "delay_calib"
              << " status=0"
              << " host_total_us=" << std::fixed << std::setprecision(2) << hostUs
              << " host_per_event_us=" << (hostUs / static_cast<double>(opt.events))
              << " events=" << opt.events
              << " delay_iters=" << opt.delayIters
              << std::endl;
}
} // namespace

int32_t main(int32_t argc, char **argv)
{
    Options opt;
    if (!ParseOptions(argc, argv, &opt)) {
        Usage(argv[0]);
        return 1;
    }

    std::cout << "config:"
              << " device=" << opt.device
              << " tasks=" << opt.tasks
              << " seq_len=" << opt.seqLen
              << " elements=" << opt.elements
              << " tile=" << opt.tile
              << " repeat=" << opt.repeat
              << " events=" << opt.events
              << " calibration_events=" << opt.calibrationEvents
              << " delay_iters=" << opt.delayIters
              << " aiv_poll_limit=" << opt.aivPollLimit
              << " iters=" << opt.iters
              << " warmup=" << opt.warmup
              << " timeout_ms=" << opt.timeoutMs
              << " flag_stride_words=" << kFlagStrideWords
              << " payload_tokens=" << kPayloadTokenCount
              << " flush_after_reset=" << (opt.flushAfterReset ? 1 : 0)
              << " invalidate_before_read=" << (opt.invalidateBeforeRead ? 1 : 0)
              << " mode=" << opt.mode
              << std::endl;

    CHECK_ACL(aclInit(nullptr));
    CHECK_ACL(aclrtSetDevice(opt.device));

    aclrtStream stream = nullptr;
    CHECK_ACL(aclrtCreateStream(&stream));

    Buffers buf;
    int ret = 0;
    if (NeedMappedFlag(opt)) {
        ret = InitBuffers(opt, &buf);
        if (ret != 0) return ret;
        std::cout << "mapped_flag:"
                  << " host=" << buf.flagHost
                  << " dev=" << buf.flagDev
                  << " flag_bytes=" << buf.flagBytes
                  << " registered_bytes=" << buf.flagAllocBytes
                  << " host_alloc=aclrtMallocHost"
                  << std::endl;
        if (NeedHostPayloadPoll(opt) || NeedHostIndexerUpdate(opt)) {
            std::cout << "mapped_payload:"
                      << " host=" << buf.payloadHost
                      << " dev=" << buf.payloadDev
                      << " payload_bytes=" << buf.payloadBytes
                      << " registered_bytes=" << buf.payloadAllocBytes
                      << " token_count=" << kPayloadTokenCount
                      << std::endl;
        }
    }

    std::vector<double> snoopUs;
    std::vector<double> plainUs;
    std::vector<double> postcheckUs;
    std::vector<double> payloadUs;
    std::vector<double> indexerUs;
    std::vector<double> indexerCpuUs;
    std::vector<double> latencyHostUs;
    std::vector<double> latencyIntervalUs;
    std::vector<double> roundtripHostUs;
    std::vector<double> roundtripAvgUs;
    std::vector<double> pacedHostUs;
    std::vector<double> pacedLatencyAvgUs;
    std::vector<double> delayCalibUs;
    std::vector<double> delayCalibPerEventUs;
    RunResult lastPlain;
    RunResult lastPostcheck;
    RunResult lastPayload;
    RunResult lastIndexer;
    RunResult lastLatency;
    RunResult lastRoundtrip;
    RunResult lastPaced;
    const uint32_t totalLoops = opt.warmup + opt.iters;
    for (uint32_t loop = 0; loop < totalLoops; ++loop) {
        double snoop = 0.0;
        double delayCalib = 0.0;
        RunResult plain;
        RunResult postcheck;
        RunResult payload;
        RunResult indexer;
        RunResult latency;
        RunResult roundtrip;
        RunResult paced;
        if (NeedAivSnoop(opt)) {
            ret = RunAivSnoop(stream, &snoop);
            if (ret != 0) return ret;
        }
        if (NeedDelayCalib(opt)) {
            ret = RunDelayCalib(opt, stream, &delayCalib);
            if (ret != 0) return ret;
        }
        if (NeedHostPollPlain(opt)) {
            ret = RunHostPollPlain(opt, buf, stream, &plain);
            if (ret != 0) return ret;
        }
        if (NeedHostPollPostcheck(opt)) {
            ret = RunHostPollPostcheck(opt, buf, stream, &postcheck);
            if (ret != 0) return ret;
        }
        if (NeedHostPayloadPoll(opt)) {
            ret = RunHostPayloadPoll(opt, buf, stream, &payload);
            if (ret != 0) return ret;
        }
        if (NeedHostIndexerUpdate(opt)) {
            ret = RunHostIndexerUpdate(opt, buf, stream, &indexer);
            if (ret != 0) return ret;
        }
        if (NeedFlagLatency(opt)) {
            ret = RunFlagLatency(opt, buf, stream, &latency);
            if (ret != 0) return ret;
        }
        if (NeedHostAivRoundtrip(opt)) {
            ret = RunHostAivRoundtrip(opt, buf, stream, &roundtrip);
            if (ret != 0) return ret;
        }
        if (NeedHostAivRoundtripFast(opt)) {
            ret = RunHostAivRoundtripFast(opt, buf, stream, &roundtrip);
            if (ret != 0) return ret;
        }
        if (NeedAivHostPacedTimestamp(opt)) {
            ret = RunAivHostPacedTimestamp(opt, buf, stream, &paced);
            if (ret != 0) return ret;
        }
        if (loop >= opt.warmup) {
            std::cout << "iter=" << (loop - opt.warmup) << std::endl;
            if (NeedAivSnoop(opt)) {
                snoopUs.push_back(snoop);
                std::cout << "aiv_snoop status=0 host_total_us=" << std::fixed << std::setprecision(2) << snoop
                          << " host_per_launch_us=" << snoop << std::endl;
            }
            if (NeedDelayCalib(opt)) {
                delayCalibUs.push_back(delayCalib);
                delayCalibPerEventUs.push_back(delayCalib / static_cast<double>(opt.events));
                PrintDelayCalib(opt, delayCalib);
            }
            if (NeedHostPollPlain(opt)) {
                plainUs.push_back(plain.hostTotalUs);
                lastPlain = plain;
                PrintRun("host_poll_plain", opt, plain);
            }
            if (NeedHostPollPostcheck(opt)) {
                postcheckUs.push_back(postcheck.hostTotalUs);
                lastPostcheck = postcheck;
                PrintRun("host_poll_postcheck", opt, postcheck);
            }
            if (NeedHostPayloadPoll(opt)) {
                payloadUs.push_back(payload.hostTotalUs);
                lastPayload = payload;
                PrintHostPayload(opt, payload);
            }
            if (NeedHostIndexerUpdate(opt)) {
                indexerUs.push_back(indexer.hostTotalUs);
                indexerCpuUs.push_back(indexer.indexerCpuUs);
                lastIndexer = indexer;
                PrintHostIndexerUpdate(indexer);
            }
            if (NeedFlagLatency(opt)) {
                const auto intervals = SeenIntervalsUs(latency);
                latencyHostUs.push_back(latency.hostTotalUs);
                latencyIntervalUs.push_back(Average(intervals));
                lastLatency = latency;
                PrintFlagLatency(opt, latency);
            }
            if (NeedHostAivRoundtrip(opt)) {
                const auto samples = NonZeroNsToUs(roundtrip.seenNs);
                roundtripHostUs.push_back(roundtrip.hostTotalUs);
                roundtripAvgUs.push_back(Average(samples));
                lastRoundtrip = roundtrip;
                PrintHostAivRoundtrip(opt, roundtrip);
            }
            if (NeedHostAivRoundtripFast(opt)) {
                const auto samples = NonZeroNsToUs(roundtrip.seenNs);
                roundtripHostUs.push_back(roundtrip.hostTotalUs);
                roundtripAvgUs.push_back(Average(samples));
                lastRoundtrip = roundtrip;
                PrintHostAivRoundtripFast(roundtrip);
            }
            if (NeedAivHostPacedTimestamp(opt)) {
                pacedHostUs.push_back(paced.hostTotalUs);
                pacedLatencyAvgUs.push_back(Average(paced.pacedLatencyUs));
                lastPaced = paced;
                PrintAivHostPacedTimestamp(opt, paced);
            }
        }
    }

    std::cout << "summary:";
    if (NeedAivSnoop(opt)) {
        std::cout << " aiv_snoop_avg_us=" << Average(snoopUs);
    }
    if (NeedHostPollPlain(opt)) {
        std::cout << " host_poll_plain_avg_us=" << Average(plainUs);
    }
    if (NeedHostPollPostcheck(opt)) {
        std::cout << " host_poll_postcheck_avg_us=" << Average(postcheckUs);
    }
    if (NeedHostPayloadPoll(opt)) {
        std::cout << " host_payload_poll_avg_us=" << Average(payloadUs);
    }
    if (NeedHostIndexerUpdate(opt)) {
        std::cout << " host_indexer_update_avg_us=" << Average(indexerUs)
                  << " host_indexer_cpu_avg_us=" << Average(indexerCpuUs);
    }
    if (NeedFlagLatency(opt)) {
        std::cout << " flag_latency_host_avg_us=" << Average(latencyHostUs)
                  << " flag_latency_seen_interval_avg_us=" << Average(latencyIntervalUs);
    }
    if (NeedHostAivRoundtrip(opt)) {
        std::cout << " host_aiv_roundtrip_host_avg_us=" << Average(roundtripHostUs)
                  << " host_aiv_roundtrip_avg_us=" << Average(roundtripAvgUs);
    }
    if (NeedHostAivRoundtripFast(opt)) {
        std::cout << " host_aiv_roundtrip_fast_host_avg_us=" << Average(roundtripHostUs)
                  << " host_aiv_roundtrip_fast_avg_us=" << Average(roundtripAvgUs);
    }
    if (NeedAivHostPacedTimestamp(opt)) {
        std::cout << " aiv_host_paced_timestamp_host_avg_us=" << Average(pacedHostUs)
                  << " aiv_host_paced_timestamp_latency_avg_us=" << Average(pacedLatencyAvgUs);
    }
    if (NeedDelayCalib(opt)) {
        std::cout << " delay_calib_avg_us=" << Average(delayCalibUs)
                  << " delay_calib_per_event_avg_us=" << Average(delayCalibPerEventUs);
    }
    std::cout << std::endl;
    if (NeedHostPollPlain(opt)) {
        PrintRun("last_host_poll_plain_detail", opt, lastPlain);
    }
    if (NeedHostPollPostcheck(opt)) {
        PrintRun("last_host_poll_postcheck_detail", opt, lastPostcheck);
    }
    if (NeedHostPayloadPoll(opt)) {
        PrintHostPayload(opt, lastPayload);
    }
    if (NeedHostIndexerUpdate(opt)) {
        PrintHostIndexerUpdate(lastIndexer);
    }
    if (NeedFlagLatency(opt)) {
        std::cout << "last_";
        PrintFlagLatency(opt, lastLatency);
    }
    if (NeedHostAivRoundtrip(opt)) {
        std::cout << "last_";
        PrintHostAivRoundtrip(opt, lastRoundtrip);
    }
    if (NeedHostAivRoundtripFast(opt)) {
        std::cout << "last_";
        PrintHostAivRoundtripFast(lastRoundtrip);
    }
    if (NeedAivHostPacedTimestamp(opt)) {
        std::cout << "last_";
        PrintAivHostPacedTimestamp(opt, lastPaced);
    }

    FreeBuffers(&buf);
    if (stream != nullptr) (void)aclrtDestroyStream(stream);
    (void)aclrtResetDevice(opt.device);
    (void)aclFinalize();
    return 0;
}
