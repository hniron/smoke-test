#include "acl/acl.h"
#include "acl/acl_rt.h"
#include "kernel_operator.h"

#include <algorithm>
#include <atomic>
#include <chrono>
#include <cstdint>
#include <cstdlib>
#include <cstring>
#include <iomanip>
#include <iostream>
#include <numeric>
#include <string>
#include <thread>
#include <vector>

#ifndef GM_ADDR
#define GM_ADDR __gm__ uint8_t *
#endif

using namespace AscendC;

constexpr int32_t kBufferNum = 2;
constexpr uint32_t kDefaultTasks = 4;
constexpr uint32_t kDefaultElements = 262144;
constexpr uint32_t kDefaultTile = 1024;
constexpr uint32_t kDefaultRepeat = 1;
constexpr uint32_t kDefaultEvents = 256;
constexpr uint32_t kDefaultDelayIters = 0;
constexpr uint32_t kDefaultIters = 5;
constexpr uint32_t kDefaultWarmup = 1;
constexpr uint64_t kDefaultTimeoutMs = 5000;
constexpr uint32_t kFlagStrideWords = 16; // 64B per flag row, one common host cache line.
constexpr size_t kHostPageAlign = 4096;
constexpr uint32_t kStatusOk = 0;
constexpr uint32_t kStatusParamInvalid = 1;
constexpr uint32_t kStatusTimeout = 2;
constexpr uint32_t kStatusPostcheckFailed = 3;

struct AivHostCpuTiling {
    uint32_t taskCount;
    uint32_t elementsPerTask;
    uint32_t tileLength;
    uint32_t repeat;
};

template<HardEvent event>
__aicore__ inline void LocalSync()
{
    int32_t eventId = static_cast<int32_t>(GetTPipePtr()->FetchEventID(event));
    SetFlag<event>(eventId);
    WaitFlag<event>(eventId);
}

__aicore__ inline void AivDelay(uint32_t delayIters)
{
    for (uint32_t i = 0; i < delayIters; ++i) {
        PipeBarrier<PIPE_ALL>();
    }
}

class KernelStageAdd {
public:
    __aicore__ inline KernelStageAdd() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, GM_ADDR flags, AivHostCpuTiling tiling)
    {
        taskCount_ = tiling.taskCount;
        elementsPerTask_ = tiling.elementsPerTask;
        tileLength_ = tiling.tileLength;
        repeat_ = tiling.repeat;
        xGm_.SetGlobalBuffer((__gm__ float *)x, taskCount_ * elementsPerTask_);
        yGm_.SetGlobalBuffer((__gm__ float *)y, taskCount_ * elementsPerTask_);
        zGm_.SetGlobalBuffer((__gm__ float *)z, taskCount_ * elementsPerTask_);
        flagGm_.SetGlobalBuffer((__gm__ int32_t *)flags, taskCount_ * kFlagStrideWords);
        pipe_.InitBuffer(inQueueX_, kBufferNum, tileLength_ * sizeof(float));
        pipe_.InitBuffer(inQueueY_, kBufferNum, tileLength_ * sizeof(float));
        pipe_.InitBuffer(outQueueZ_, kBufferNum, tileLength_ * sizeof(float));
        pipe_.InitBuffer(flagQueue_, 1, kFlagStrideWords * sizeof(int32_t));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t task = 0; task < taskCount_; ++task) {
            RunStage(task);
            SetStageFlag(task);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t base)
    {
        LocalTensor<float> xLocal = inQueueX_.AllocTensor<float>();
        LocalTensor<float> yLocal = inQueueY_.AllocTensor<float>();
        DataCopy(xLocal, xGm_[base], tileLength_);
        DataCopy(yLocal, yGm_[base], tileLength_);
        inQueueX_.EnQue(xLocal);
        inQueueY_.EnQue(yLocal);
    }

    __aicore__ inline void Compute()
    {
        LocalTensor<float> xLocal = inQueueX_.DeQue<float>();
        LocalTensor<float> yLocal = inQueueY_.DeQue<float>();
        LocalTensor<float> zLocal = outQueueZ_.AllocTensor<float>();
        Add(zLocal, xLocal, yLocal, tileLength_);
        outQueueZ_.EnQue<float>(zLocal);
        inQueueX_.FreeTensor(xLocal);
        inQueueY_.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t base)
    {
        LocalTensor<float> zLocal = outQueueZ_.DeQue<float>();
        DataCopy(zGm_[base], zLocal, tileLength_);
        outQueueZ_.FreeTensor(zLocal);
    }

    __aicore__ inline void RunStage(uint32_t task)
    {
        const uint32_t stageBase = task * elementsPerTask_;
        for (uint32_t r = 0; r < repeat_; ++r) {
            for (uint32_t offset = 0; offset < elementsPerTask_; offset += tileLength_) {
                const uint32_t base = stageBase + offset;
                CopyIn(base);
                Compute();
                CopyOut(base);
            }
        }
        PipeBarrier<PIPE_ALL>();
    }

    __aicore__ inline void SetStageFlag(uint32_t task)
    {
        LocalTensor<int32_t> local = flagQueue_.AllocTensor<int32_t>();
        Duplicate<int32_t>(local, 0, kFlagStrideWords);
        local.SetValue(0, static_cast<int32_t>(task + 1U));
        LocalSync<HardEvent::S_MTE3>();
        DataCopy(flagGm_[task * kFlagStrideWords], local, kFlagStrideWords);
        flagQueue_.FreeTensor(local);
        PipeBarrier<PIPE_ALL>();
    }

private:
    TPipe pipe_;
    TQue<TPosition::VECIN, kBufferNum> inQueueX_;
    TQue<TPosition::VECIN, kBufferNum> inQueueY_;
    TQue<TPosition::VECOUT, kBufferNum> outQueueZ_;
    TQue<TPosition::VECOUT, 1> flagQueue_;
    GlobalTensor<float> xGm_;
    GlobalTensor<float> yGm_;
    GlobalTensor<float> zGm_;
    GlobalTensor<int32_t> flagGm_;
    uint32_t taskCount_;
    uint32_t elementsPerTask_;
    uint32_t tileLength_;
    uint32_t repeat_;
};

extern "C" __global__ __aicore__ void aiv_multi_stage_add_host_flag(GM_ADDR x, GM_ADDR y, GM_ADDR z,
    GM_ADDR flags, AivHostCpuTiling tiling)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    KernelStageAdd op;
    op.Init(x, y, z, flags, tiling);
    op.Process();
}

class KernelHostFlagSeries {
public:
    __aicore__ inline KernelHostFlagSeries() {}

    __aicore__ inline void Init(GM_ADDR flags, uint32_t events, uint32_t delayIters)
    {
        events_ = events;
        delayIters_ = delayIters;
        flagGm_.SetGlobalBuffer((__gm__ int32_t *)flags, events_ * kFlagStrideWords);
        pipe_.InitBuffer(flagQueue_, 1, kFlagStrideWords * sizeof(int32_t));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t event = 0; event < events_; ++event) {
            AivDelay(delayIters_);
            SetEventFlag(event);
        }
    }

private:
    __aicore__ inline void SetEventFlag(uint32_t event)
    {
        LocalTensor<int32_t> local = flagQueue_.AllocTensor<int32_t>();
        Duplicate<int32_t>(local, 0, kFlagStrideWords);
        local.SetValue(0, static_cast<int32_t>(event + 1U));
        LocalSync<HardEvent::S_MTE3>();
        DataCopy(flagGm_[event * kFlagStrideWords], local, kFlagStrideWords);
        flagQueue_.FreeTensor(local);
        PipeBarrier<PIPE_ALL>();
    }

private:
    TPipe pipe_;
    TQue<TPosition::VECOUT, 1> flagQueue_;
    GlobalTensor<int32_t> flagGm_;
    uint32_t events_;
    uint32_t delayIters_;
};

extern "C" __global__ __aicore__ void aiv_host_flag_series(GM_ADDR flags, uint32_t events, uint32_t delayIters)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    KernelHostFlagSeries op;
    op.Init(flags, events, delayIters);
    op.Process();
}

extern "C" __global__ __aicore__ void aiv_delay_calib(uint32_t events, uint32_t delayIters)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    for (uint32_t event = 0; event < events; ++event) {
        AivDelay(delayIters);
    }
    PipeBarrier<PIPE_ALL>();
}

extern "C" __global__ __aicore__ void aiv_snoop()
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    PipeBarrier<PIPE_ALL>();
}

namespace {
struct Options {
    int32_t device = 0;
    uint32_t tasks = kDefaultTasks;
    uint32_t elements = kDefaultElements;
    uint32_t tile = kDefaultTile;
    uint32_t repeat = kDefaultRepeat;
    uint32_t events = kDefaultEvents;
    uint32_t delayIters = kDefaultDelayIters;
    uint32_t iters = kDefaultIters;
    uint32_t warmup = kDefaultWarmup;
    uint64_t timeoutMs = kDefaultTimeoutMs;
    bool flushAfterReset = false;
    bool invalidateBeforeRead = false;
    std::string mode = "host_poll_plain";
};

struct Buffers {
    void *x = nullptr;
    void *y = nullptr;
    void *z = nullptr;
    void *flagHost = nullptr;
    void *flagDev = nullptr;
    size_t dataBytes = 0;
    size_t flagBytes = 0;
    size_t flagAllocBytes = 0;
};

struct RunResult {
    double hostTotalUs = 0.0;
    uint64_t startNs = 0;
    uint32_t status = kStatusOk;
    std::vector<uint64_t> seenNs;
    std::vector<uint64_t> pollIters;
    std::vector<uint32_t> finalFlags;
};

uint64_t HostNowNs()
{
    return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
        std::chrono::steady_clock::now().time_since_epoch()).count());
}

int Fail(const char *expr, int ret, int line)
{
    std::cerr << "FAIL line " << line << ": " << expr << " ret=" << ret << std::endl;
    const char *recent = aclGetRecentErrMsg();
    if (recent != nullptr && recent[0] != '\0') {
        std::cerr << "ACL recent error: " << recent << std::endl;
    }
    return ret == 0 ? 1 : ret;
}

#define CHECK_ACL(expr) do { aclError _ret = (expr); if (_ret != ACL_SUCCESS) return Fail(#expr, static_cast<int>(_ret), __LINE__); } while (0)

bool ParseU32(const char *arg, const char *name, uint32_t *out)
{
    const size_t n = std::strlen(name);
    if (std::strncmp(arg, name, n) != 0 || arg[n] != '=') return false;
    *out = static_cast<uint32_t>(std::strtoul(arg + n + 1, nullptr, 0));
    return true;
}

bool ParseU64(const char *arg, const char *name, uint64_t *out)
{
    const size_t n = std::strlen(name);
    if (std::strncmp(arg, name, n) != 0 || arg[n] != '=') return false;
    *out = std::strtoull(arg + n + 1, nullptr, 0);
    return true;
}

bool ParseI32(const char *arg, const char *name, int32_t *out)
{
    const size_t n = std::strlen(name);
    if (std::strncmp(arg, name, n) != 0 || arg[n] != '=') return false;
    *out = static_cast<int32_t>(std::strtol(arg + n + 1, nullptr, 0));
    return true;
}

bool ParseBool(const char *arg, const char *name, bool *out)
{
    uint32_t value = 0;
    if (!ParseU32(arg, name, &value)) return false;
    *out = value != 0;
    return true;
}

bool ParseStr(const char *arg, const char *name, std::string *out)
{
    const size_t n = std::strlen(name);
    if (std::strncmp(arg, name, n) != 0 || arg[n] != '=') return false;
    *out = arg + n + 1;
    return true;
}

void Usage(const char *prog)
{
    std::cerr
        << "usage: " << prog << " [--device=0] [--tasks=4] [--elements=262144]\n"
        << "       [--tile=1024] [--repeat=1] [--events=256] [--delay-iters=0]\n"
        << "       [--iters=5] [--warmup=1]\n"
        << "       [--timeout-ms=5000] [--flush-after-reset=0] [--invalidate-before-read=0]\n"
        << "       [--mode=host_poll_plain|host_poll_postcheck|flag_latency|delay_calib|aiv_snoop|all]\n";
}

bool ParseOptions(int argc, char **argv, Options *opt)
{
    for (int i = 1; i < argc; ++i) {
        if (ParseI32(argv[i], "--device", &opt->device) ||
            ParseU32(argv[i], "--tasks", &opt->tasks) ||
            ParseU32(argv[i], "--elements", &opt->elements) ||
            ParseU32(argv[i], "--tile", &opt->tile) ||
            ParseU32(argv[i], "--repeat", &opt->repeat) ||
            ParseU32(argv[i], "--events", &opt->events) ||
            ParseU32(argv[i], "--delay-iters", &opt->delayIters) ||
            ParseU32(argv[i], "--iters", &opt->iters) ||
            ParseU32(argv[i], "--warmup", &opt->warmup) ||
            ParseU64(argv[i], "--timeout-ms", &opt->timeoutMs) ||
            ParseBool(argv[i], "--flush-after-reset", &opt->flushAfterReset) ||
            ParseBool(argv[i], "--invalidate-before-read", &opt->invalidateBeforeRead) ||
            ParseStr(argv[i], "--mode", &opt->mode)) {
            continue;
        }
        return false;
    }
    const bool validMode = opt->mode == "host_poll_plain" || opt->mode == "host_poll_postcheck" ||
        opt->mode == "flag_latency" || opt->mode == "delay_calib" ||
        opt->mode == "aiv_snoop" || opt->mode == "aiv_noop" || opt->mode == "all";
    return validMode && opt->tasks > 0 && opt->elements > 0 && opt->tile > 0 &&
        opt->repeat > 0 && opt->events > 0 && opt->iters > 0 && (opt->elements % opt->tile == 0);
}

bool NeedHostPollPlain(const Options &opt)
{
    return opt.mode == "host_poll_plain" || opt.mode == "all";
}

bool NeedHostPollPostcheck(const Options &opt)
{
    return opt.mode == "host_poll_postcheck" || opt.mode == "all";
}

bool NeedAivSnoop(const Options &opt)
{
    return opt.mode == "aiv_snoop" || opt.mode == "aiv_noop";
}

bool NeedFlagLatency(const Options &opt)
{
    return opt.mode == "flag_latency";
}

bool NeedDelayCalib(const Options &opt)
{
    return opt.mode == "delay_calib";
}

bool NeedStageData(const Options &opt)
{
    return NeedHostPollPlain(opt) || NeedHostPollPostcheck(opt);
}

bool NeedMappedFlag(const Options &opt)
{
    return NeedStageData(opt) || NeedFlagLatency(opt);
}

uint32_t FlagSlotCount(const Options &opt)
{
    return NeedFlagLatency(opt) ? opt.events : opt.tasks;
}

double Average(const std::vector<double> &values)
{
    if (values.empty()) return 0.0;
    return std::accumulate(values.begin(), values.end(), 0.0) / static_cast<double>(values.size());
}

std::vector<double> SeenIntervalsUs(const RunResult &result)
{
    std::vector<double> intervals;
    for (size_t i = 1; i < result.seenNs.size(); ++i) {
        if (result.seenNs[i] != 0 && result.seenNs[i - 1] != 0 && result.seenNs[i] >= result.seenNs[i - 1]) {
            intervals.push_back(static_cast<double>(result.seenNs[i] - result.seenNs[i - 1]) / 1000.0);
        }
    }
    return intervals;
}

double PollItersAvg(const RunResult &result)
{
    if (result.pollIters.empty()) return 0.0;
    return static_cast<double>(std::accumulate(result.pollIters.begin(), result.pollIters.end(), uint64_t{0})) /
        static_cast<double>(result.pollIters.size());
}

double MinOrZero(const std::vector<double> &values)
{
    if (values.empty()) return 0.0;
    return *std::min_element(values.begin(), values.end());
}

double MaxOrZero(const std::vector<double> &values)
{
    if (values.empty()) return 0.0;
    return *std::max_element(values.begin(), values.end());
}

uint64_t OnePollCount(const RunResult &result)
{
    return static_cast<uint64_t>(std::count(result.pollIters.begin(), result.pollIters.end(), uint64_t{1}));
}

double FirstSeenUs(const RunResult &result)
{
    if (result.seenNs.empty() || result.startNs == 0 || result.seenNs.front() < result.startNs) return 0.0;
    return static_cast<double>(result.seenNs.front() - result.startNs) / 1000.0;
}

size_t AlignUp(size_t value, size_t align)
{
    return ((value + align - 1) / align) * align;
}

int InitBuffers(const Options &opt, Buffers *buf)
{
    const uint32_t flagSlots = FlagSlotCount(opt);
    buf->flagBytes = static_cast<size_t>(flagSlots) * kFlagStrideWords * sizeof(uint32_t);
    buf->flagAllocBytes = AlignUp(buf->flagBytes, kHostPageAlign);

    if (NeedStageData(opt)) {
        const uint64_t totalElements = static_cast<uint64_t>(opt.tasks) * static_cast<uint64_t>(opt.elements);
        buf->dataBytes = static_cast<size_t>(totalElements) * sizeof(float);
        CHECK_ACL(aclrtMalloc(&buf->x, buf->dataBytes, ACL_MEM_MALLOC_HUGE_FIRST));
        CHECK_ACL(aclrtMalloc(&buf->y, buf->dataBytes, ACL_MEM_MALLOC_HUGE_FIRST));
        CHECK_ACL(aclrtMalloc(&buf->z, buf->dataBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    }
    CHECK_ACL(aclrtMallocHost(&buf->flagHost, buf->flagAllocBytes));
    if (buf->flagHost == nullptr) {
        return Fail("aclrtMallocHost(flagHost)", 1, __LINE__);
    }
    std::memset(buf->flagHost, 0, buf->flagAllocBytes);
    CHECK_ACL(aclrtHostRegister(buf->flagHost, buf->flagAllocBytes, ACL_HOST_REGISTER_MAPPED, &buf->flagDev));

    if (NeedStageData(opt)) {
        const uint64_t totalElements = static_cast<uint64_t>(opt.tasks) * static_cast<uint64_t>(opt.elements);
        std::vector<float> host(totalElements, 1.0f);
        CHECK_ACL(aclrtMemcpy(buf->x, buf->dataBytes, host.data(), buf->dataBytes, ACL_MEMCPY_HOST_TO_DEVICE));
        CHECK_ACL(aclrtMemcpy(buf->y, buf->dataBytes, host.data(), buf->dataBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    }
    return 0;
}

void FreeBuffers(Buffers *buf)
{
    if (buf->flagHost != nullptr && buf->flagDev != nullptr) {
        (void)aclrtHostUnregister(buf->flagHost);
    }
    if (buf->x != nullptr) (void)aclrtFree(buf->x);
    if (buf->y != nullptr) (void)aclrtFree(buf->y);
    if (buf->z != nullptr) (void)aclrtFree(buf->z);
    if (buf->flagHost != nullptr) (void)aclrtFreeHost(buf->flagHost);
    *buf = Buffers{};
}

int ResetBuffers(const Options &opt, const Buffers &buf)
{
    if (buf.z != nullptr && buf.dataBytes > 0) {
        CHECK_ACL(aclrtMemset(buf.z, buf.dataBytes, 0, buf.dataBytes));
    }
    std::memset(buf.flagHost, 0, buf.flagAllocBytes);
    std::atomic_thread_fence(std::memory_order_seq_cst);
    if (opt.flushAfterReset) {
        CHECK_ACL(aclrtMemFlush(buf.flagDev, buf.flagAllocBytes));
    }
    return 0;
}

void FillFinalFlags(uint32_t count, const Buffers &buf, RunResult *result)
{
    result->finalFlags.assign(count, 0);
    volatile const uint32_t *flags = reinterpret_cast<volatile const uint32_t *>(buf.flagHost);
    for (uint32_t i = 0; i < count; ++i) {
        result->finalFlags[i] = flags[i * kFlagStrideWords];
    }
}

void PollHostFlags(uint32_t count, const Options &opt, const Buffers &buf, uint64_t startNs, RunResult *result)
{
    result->startNs = startNs;
    result->status = kStatusOk;
    result->seenNs.assign(count, 0);
    result->pollIters.assign(count, 0);
    volatile const uint32_t *flags = reinterpret_cast<volatile const uint32_t *>(buf.flagHost);
    const uint64_t timeoutNs = opt.timeoutMs * 1000000ULL;
    for (uint32_t i = 0; i < count; ++i) {
        const uint32_t expected = i + 1U;
        uint64_t iters = 0;
        for (;;) {
            const uint32_t value = flags[i * kFlagStrideWords];
            ++iters;
            if (value >= expected) {
                result->seenNs[i] = HostNowNs();
                result->pollIters[i] = iters;
                break;
            }
            if ((HostNowNs() - startNs) > timeoutNs) {
                result->status = kStatusTimeout;
                result->seenNs[i] = HostNowNs();
                result->pollIters[i] = iters;
                return;
            }
            if ((iters & 0xffffU) == 0) {
                std::this_thread::yield();
            }
        }
    }
}

void LaunchAivStageAdd(const Options &opt, const Buffers &buf, aclrtStream stream)
{
    const AivHostCpuTiling tiling{opt.tasks, opt.elements, opt.tile, opt.repeat};
    aiv_multi_stage_add_host_flag<<<1, nullptr, stream>>>(reinterpret_cast<uint8_t *>(buf.x),
        reinterpret_cast<uint8_t *>(buf.y), reinterpret_cast<uint8_t *>(buf.z),
        reinterpret_cast<uint8_t *>(buf.flagDev), tiling);
}

void LaunchAivHostFlagSeries(const Options &opt, const Buffers &buf, aclrtStream stream)
{
    aiv_host_flag_series<<<1, nullptr, stream>>>(
        reinterpret_cast<uint8_t *>(buf.flagDev), opt.events, opt.delayIters);
}

void LaunchAivDelayCalib(const Options &opt, aclrtStream stream)
{
    aiv_delay_calib<<<1, nullptr, stream>>>(opt.events, opt.delayIters);
}

int RunAivSnoop(aclrtStream stream, double *hostUs)
{
    CHECK_ACL(aclrtSynchronizeStream(stream));
    const uint64_t start = HostNowNs();
    aiv_snoop<<<1, nullptr, stream>>>();
    CHECK_ACL(aclrtSynchronizeStream(stream));
    const uint64_t end = HostNowNs();
    *hostUs = static_cast<double>(end - start) / 1000.0;
    return 0;
}

int RunHostPollPlain(const Options &opt, const Buffers &buf, aclrtStream stream, RunResult *result)
{
    CHECK_ACL(aclrtSynchronizeStream(stream));
    int ret = ResetBuffers(opt, buf);
    if (ret != 0) return ret;

    std::atomic<bool> ready{false};
    std::atomic<bool> go{false};
    uint64_t startNs = 0;
    std::thread poller([&]() {
        ready.store(true, std::memory_order_release);
        while (!go.load(std::memory_order_acquire)) {
            std::this_thread::yield();
        }
        PollHostFlags(opt.tasks, opt, buf, startNs, result);
    });
    while (!ready.load(std::memory_order_acquire)) {
        std::this_thread::yield();
    }

    startNs = HostNowNs();
    go.store(true, std::memory_order_release);
    LaunchAivStageAdd(opt, buf, stream);
    aclError syncRet = aclrtSynchronizeStream(stream);
    poller.join();
    if (syncRet != ACL_SUCCESS) {
        return Fail("aclrtSynchronizeStream(stream)", static_cast<int>(syncRet), __LINE__);
    }
    const uint64_t endNs = HostNowNs();
    result->hostTotalUs = static_cast<double>(endNs - startNs) / 1000.0;
    FillFinalFlags(opt.tasks, buf, result);
    return 0;
}

int RunHostPollPostcheck(const Options &opt, const Buffers &buf, aclrtStream stream, RunResult *result)
{
    CHECK_ACL(aclrtSynchronizeStream(stream));
    int ret = ResetBuffers(opt, buf);
    if (ret != 0) return ret;

    const uint64_t startNs = HostNowNs();
    LaunchAivStageAdd(opt, buf, stream);
    CHECK_ACL(aclrtSynchronizeStream(stream));
    if (opt.invalidateBeforeRead) {
        CHECK_ACL(aclrtMemInvalidate(buf.flagDev, buf.flagAllocBytes));
    }
    const uint64_t endNs = HostNowNs();

    result->hostTotalUs = static_cast<double>(endNs - startNs) / 1000.0;
    result->startNs = startNs;
    result->status = kStatusOk;
    result->seenNs.assign(opt.tasks, 0);
    result->pollIters.assign(opt.tasks, 1);
    FillFinalFlags(opt.tasks, buf, result);
    for (uint32_t i = 0; i < opt.tasks; ++i) {
        result->seenNs[i] = endNs;
        if (result->finalFlags[i] < i + 1U) {
            result->status = kStatusPostcheckFailed;
        }
    }
    return 0;
}

int RunFlagLatency(const Options &opt, const Buffers &buf, aclrtStream stream, RunResult *result)
{
    CHECK_ACL(aclrtSynchronizeStream(stream));
    int ret = ResetBuffers(opt, buf);
    if (ret != 0) return ret;

    std::atomic<bool> ready{false};
    std::atomic<bool> go{false};
    uint64_t startNs = 0;
    std::thread poller([&]() {
        ready.store(true, std::memory_order_release);
        while (!go.load(std::memory_order_acquire)) {
            std::this_thread::yield();
        }
        PollHostFlags(opt.events, opt, buf, startNs, result);
    });
    while (!ready.load(std::memory_order_acquire)) {
        std::this_thread::yield();
    }

    startNs = HostNowNs();
    go.store(true, std::memory_order_release);
    LaunchAivHostFlagSeries(opt, buf, stream);
    aclError syncRet = aclrtSynchronizeStream(stream);
    poller.join();
    if (syncRet != ACL_SUCCESS) {
        return Fail("aclrtSynchronizeStream(stream)", static_cast<int>(syncRet), __LINE__);
    }
    const uint64_t endNs = HostNowNs();
    result->hostTotalUs = static_cast<double>(endNs - startNs) / 1000.0;
    FillFinalFlags(opt.events, buf, result);
    return 0;
}

int RunDelayCalib(const Options &opt, aclrtStream stream, double *hostUs)
{
    CHECK_ACL(aclrtSynchronizeStream(stream));
    const uint64_t start = HostNowNs();
    LaunchAivDelayCalib(opt, stream);
    CHECK_ACL(aclrtSynchronizeStream(stream));
    const uint64_t end = HostNowNs();
    *hostUs = static_cast<double>(end - start) / 1000.0;
    return 0;
}

void PrintRun(const char *name, const Options &opt, const RunResult &result)
{
    const auto intervals = SeenIntervalsUs(result);
    const uint32_t firstFlag = result.finalFlags.empty() ? 0 : result.finalFlags.front();
    const uint32_t lastFlag = result.finalFlags.empty() ? 0 : result.finalFlags.back();
    const uint64_t firstPoll = result.pollIters.empty() ? 0 : result.pollIters.front();
    const uint64_t lastPoll = result.pollIters.empty() ? 0 : result.pollIters.back();
    std::cout << name
              << " status=" << result.status
              << " host_total_us=" << std::fixed << std::setprecision(2) << result.hostTotalUs
              << " host_per_task_us=" << (result.hostTotalUs / static_cast<double>(opt.tasks))
              << " host_seen_interval_avg_us=" << Average(intervals)
              << " poll_iters_avg=" << PollItersAvg(result)
              << " first_poll_iters=" << firstPoll
              << " last_poll_iters=" << lastPoll
              << " first_flag=" << firstFlag
              << " last_flag=" << lastFlag
              << std::endl;
}

void PrintFlagLatency(const Options &opt, const RunResult &result)
{
    const auto intervals = SeenIntervalsUs(result);
    const uint32_t firstFlag = result.finalFlags.empty() ? 0 : result.finalFlags.front();
    const uint32_t lastFlag = result.finalFlags.empty() ? 0 : result.finalFlags.back();
    const uint64_t firstPoll = result.pollIters.empty() ? 0 : result.pollIters.front();
    const uint64_t lastPoll = result.pollIters.empty() ? 0 : result.pollIters.back();
    std::cout << "flag_latency"
              << " status=" << result.status
              << " host_total_us=" << std::fixed << std::setprecision(2) << result.hostTotalUs
              << " host_per_event_us=" << (result.hostTotalUs / static_cast<double>(opt.events))
              << " first_seen_us=" << FirstSeenUs(result)
              << " seen_interval_avg_us=" << Average(intervals)
              << " seen_interval_min_us=" << MinOrZero(intervals)
              << " seen_interval_max_us=" << MaxOrZero(intervals)
              << " poll_iters_avg=" << PollItersAvg(result)
              << " one_poll_count=" << OnePollCount(result)
              << " first_poll_iters=" << firstPoll
              << " last_poll_iters=" << lastPoll
              << " first_flag=" << firstFlag
              << " last_flag=" << lastFlag
              << std::endl;
}

void PrintDelayCalib(const Options &opt, double hostUs)
{
    std::cout << "delay_calib"
              << " status=0"
              << " host_total_us=" << std::fixed << std::setprecision(2) << hostUs
              << " host_per_event_us=" << (hostUs / static_cast<double>(opt.events))
              << " events=" << opt.events
              << " delay_iters=" << opt.delayIters
              << std::endl;
}
} // namespace

int32_t main(int32_t argc, char **argv)
{
    Options opt;
    if (!ParseOptions(argc, argv, &opt)) {
        Usage(argv[0]);
        return 1;
    }

    std::cout << "config:"
              << " device=" << opt.device
              << " tasks=" << opt.tasks
              << " elements=" << opt.elements
              << " tile=" << opt.tile
              << " repeat=" << opt.repeat
              << " events=" << opt.events
              << " delay_iters=" << opt.delayIters
              << " iters=" << opt.iters
              << " warmup=" << opt.warmup
              << " timeout_ms=" << opt.timeoutMs
              << " flag_stride_words=" << kFlagStrideWords
              << " flush_after_reset=" << (opt.flushAfterReset ? 1 : 0)
              << " invalidate_before_read=" << (opt.invalidateBeforeRead ? 1 : 0)
              << " mode=" << opt.mode
              << std::endl;

    CHECK_ACL(aclInit(nullptr));
    CHECK_ACL(aclrtSetDevice(opt.device));

    aclrtStream stream = nullptr;
    CHECK_ACL(aclrtCreateStream(&stream));

    Buffers buf;
    int ret = 0;
    if (NeedMappedFlag(opt)) {
        ret = InitBuffers(opt, &buf);
        if (ret != 0) return ret;
        std::cout << "mapped_flag:"
                  << " host=" << buf.flagHost
                  << " dev=" << buf.flagDev
                  << " flag_bytes=" << buf.flagBytes
                  << " registered_bytes=" << buf.flagAllocBytes
                  << " host_alloc=aclrtMallocHost"
                  << std::endl;
    }

    std::vector<double> snoopUs;
    std::vector<double> plainUs;
    std::vector<double> postcheckUs;
    std::vector<double> latencyHostUs;
    std::vector<double> latencyIntervalUs;
    std::vector<double> delayCalibUs;
    std::vector<double> delayCalibPerEventUs;
    RunResult lastPlain;
    RunResult lastPostcheck;
    RunResult lastLatency;
    const uint32_t totalLoops = opt.warmup + opt.iters;
    for (uint32_t loop = 0; loop < totalLoops; ++loop) {
        double snoop = 0.0;
        double delayCalib = 0.0;
        RunResult plain;
        RunResult postcheck;
        RunResult latency;
        if (NeedAivSnoop(opt)) {
            ret = RunAivSnoop(stream, &snoop);
            if (ret != 0) return ret;
        }
        if (NeedDelayCalib(opt)) {
            ret = RunDelayCalib(opt, stream, &delayCalib);
            if (ret != 0) return ret;
        }
        if (NeedHostPollPlain(opt)) {
            ret = RunHostPollPlain(opt, buf, stream, &plain);
            if (ret != 0) return ret;
        }
        if (NeedHostPollPostcheck(opt)) {
            ret = RunHostPollPostcheck(opt, buf, stream, &postcheck);
            if (ret != 0) return ret;
        }
        if (NeedFlagLatency(opt)) {
            ret = RunFlagLatency(opt, buf, stream, &latency);
            if (ret != 0) return ret;
        }
        if (loop >= opt.warmup) {
            std::cout << "iter=" << (loop - opt.warmup) << std::endl;
            if (NeedAivSnoop(opt)) {
                snoopUs.push_back(snoop);
                std::cout << "aiv_snoop status=0 host_total_us=" << std::fixed << std::setprecision(2) << snoop
                          << " host_per_launch_us=" << snoop << std::endl;
            }
            if (NeedDelayCalib(opt)) {
                delayCalibUs.push_back(delayCalib);
                delayCalibPerEventUs.push_back(delayCalib / static_cast<double>(opt.events));
                PrintDelayCalib(opt, delayCalib);
            }
            if (NeedHostPollPlain(opt)) {
                plainUs.push_back(plain.hostTotalUs);
                lastPlain = plain;
                PrintRun("host_poll_plain", opt, plain);
            }
            if (NeedHostPollPostcheck(opt)) {
                postcheckUs.push_back(postcheck.hostTotalUs);
                lastPostcheck = postcheck;
                PrintRun("host_poll_postcheck", opt, postcheck);
            }
            if (NeedFlagLatency(opt)) {
                const auto intervals = SeenIntervalsUs(latency);
                latencyHostUs.push_back(latency.hostTotalUs);
                latencyIntervalUs.push_back(Average(intervals));
                lastLatency = latency;
                PrintFlagLatency(opt, latency);
            }
        }
    }

    std::cout << "summary:";
    if (NeedAivSnoop(opt)) {
        std::cout << " aiv_snoop_avg_us=" << Average(snoopUs);
    }
    if (NeedHostPollPlain(opt)) {
        std::cout << " host_poll_plain_avg_us=" << Average(plainUs);
    }
    if (NeedHostPollPostcheck(opt)) {
        std::cout << " host_poll_postcheck_avg_us=" << Average(postcheckUs);
    }
    if (NeedFlagLatency(opt)) {
        std::cout << " flag_latency_host_avg_us=" << Average(latencyHostUs)
                  << " flag_latency_seen_interval_avg_us=" << Average(latencyIntervalUs);
    }
    if (NeedDelayCalib(opt)) {
        std::cout << " delay_calib_avg_us=" << Average(delayCalibUs)
                  << " delay_calib_per_event_avg_us=" << Average(delayCalibPerEventUs);
    }
    std::cout << std::endl;
    if (NeedHostPollPlain(opt)) {
        PrintRun("last_host_poll_plain_detail", opt, lastPlain);
    }
    if (NeedHostPollPostcheck(opt)) {
        PrintRun("last_host_poll_postcheck_detail", opt, lastPostcheck);
    }
    if (NeedFlagLatency(opt)) {
        std::cout << "last_";
        PrintFlagLatency(opt, lastLatency);
    }

    FreeBuffers(&buf);
    if (stream != nullptr) (void)aclrtDestroyStream(stream);
    (void)aclrtResetDevice(opt.device);
    (void)aclFinalize();
    return 0;
}
