#define GM_ADDR __gm__ uint8_t *
#endif

using namespace AscendC;

constexpr int32_t kBufferNum = 2;
constexpr uint32_t kDefaultTasks = 4;
constexpr uint32_t kDefaultElements = 262144;
constexpr uint32_t kDefaultTile = 1024;
constexpr uint32_t kDefaultRepeat = 1;
constexpr uint32_t kDefaultEvents = 256;
constexpr uint32_t kDefaultDelayIters = 0;
constexpr uint32_t kDefaultIters = 5;
constexpr uint32_t kDefaultWarmup = 1;
constexpr uint64_t kDefaultTimeoutMs = 5000;
constexpr uint32_t kDefaultAivPollLimit = 1000000;
constexpr uint32_t kFlagStrideWords = 16; // Match aiv_aicpu_bench kFlagPadCount: 64B per flag row.
constexpr size_t kHostPageAlign = 4096;
constexpr uint32_t kStatusOk = 0;
constexpr uint32_t kStatusParamInvalid = 1;
constexpr uint32_t kStatusTimeout = 2;
constexpr uint32_t kStatusPostcheckFailed = 3;
constexpr uint32_t kStatusPayloadMismatch = 4;
constexpr uint32_t kStatusCalibrationInvalid = 5;
constexpr uint32_t kStatusIndexerUpdateFailed = 6;
constexpr uint32_t kStatusIndexerOutputMismatch = 7;
constexpr uint32_t kRoundtripReadySlot = 0;
constexpr uint32_t kRoundtripCpuReqSlot = 1;
constexpr uint32_t kRoundtripAivAckSlot = 2;
constexpr uint32_t kRoundtripStatusSlot = 3;
constexpr uint32_t kRoundtripAbortSlot = 4;
constexpr uint32_t kRoundtripAivPollBaseSlot = 5;
constexpr uint32_t kTimestampWords = kFlagStrideWords; // 64B record as uint32_t[16].
constexpr uint32_t kPacedCycleLowWord = 0;
constexpr uint32_t kPacedCycleHighWord = 1;
constexpr uint32_t kPacedSequenceWord = 2;
constexpr uint32_t kPacedReadyWord = 3;
constexpr uint32_t kPayloadTokenCount = 2048;
constexpr uint32_t kPayloadBatchStride = 100000;
constexpr uint32_t kIndexerHitTokenCount = kPayloadTokenCount / 2;
constexpr uint32_t kIndexerEvictTokenStart = kPayloadTokenCount;
constexpr uint32_t kIndexerSeqLen = 65536;
constexpr int32_t kIndexerHitSlotBase = 100000;
constexpr int32_t kIndexerEvictSlotBase = 200000;

inline uint32_t RoundtripTimestampBaseSlot(uint32_t events)
{
    return kRoundtripAivPollBaseSlot + events;
}

inline uint32_t RoundtripSlotCount(uint32_t events)
{
    return RoundtripTimestampBaseSlot(events) + events;
}

inline uint32_t PacedSlotCount(uint32_t events)
{
    return events;
}

struct AivHostCpuTiling {
    uint32_t taskCount;
    uint32_t elementsPerTask;
    uint32_t tileLength;
    uint32_t repeat;
};

template<HardEvent event>
__aicore__ inline void LocalSync()
{
    int32_t eventId = static_cast<int32_t>(GetTPipePtr()->FetchEventID(event));
    SetFlag<event>(eventId);
    WaitFlag<event>(eventId);
}

__aicore__ inline void AivDelay(uint32_t delayIters)
{
    for (uint32_t i = 0; i < delayIters; ++i) {
        PipeBarrier<PIPE_ALL>();
    }
}

class KernelStageAdd {
public:
    __aicore__ inline KernelStageAdd() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, GM_ADDR flags, AivHostCpuTiling tiling)
    {
        taskCount_ = tiling.taskCount;
        elementsPerTask_ = tiling.elementsPerTask;
        tileLength_ = tiling.tileLength;
        repeat_ = tiling.repeat;
        xGm_.SetGlobalBuffer((__gm__ float *)x, taskCount_ * elementsPerTask_);
        yGm_.SetGlobalBuffer((__gm__ float *)y, taskCount_ * elementsPerTask_);
        zGm_.SetGlobalBuffer((__gm__ float *)z, taskCount_ * elementsPerTask_);
        flagGm_.SetGlobalBuffer((__gm__ int32_t *)flags, taskCount_ * kFlagStrideWords);
        pipe_.InitBuffer(inQueueX_, kBufferNum, tileLength_ * sizeof(float));
        pipe_.InitBuffer(inQueueY_, kBufferNum, tileLength_ * sizeof(float));
        pipe_.InitBuffer(outQueueZ_, kBufferNum, tileLength_ * sizeof(float));
        pipe_.InitBuffer(flagQueue_, 1, kFlagStrideWords * sizeof(int32_t));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t task = 0; task < taskCount_; ++task) {
            RunStage(task);
            SetStageFlag(task);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t base)
    {
        LocalTensor<float> xLocal = inQueueX_.AllocTensor<float>();
        LocalTensor<float> yLocal = inQueueY_.AllocTensor<float>();
        DataCopy(xLocal, xGm_[base], tileLength_);
        DataCopy(yLocal, yGm_[base], tileLength_);
        inQueueX_.EnQue(xLocal);
        inQueueY_.EnQue(yLocal);
    }

    __aicore__ inline void Compute()
    {
        LocalTensor<float> xLocal = inQueueX_.DeQue<float>();
        LocalTensor<float> yLocal = inQueueY_.DeQue<float>();
        LocalTensor<float> zLocal = outQueueZ_.AllocTensor<float>();
        Add(zLocal, xLocal, yLocal, tileLength_);
        outQueueZ_.EnQue<float>(zLocal);
        inQueueX_.FreeTensor(xLocal);
        inQueueY_.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t base)
    {
        LocalTensor<float> zLocal = outQueueZ_.DeQue<float>();
        DataCopy(zGm_[base], zLocal, tileLength_);
        outQueueZ_.FreeTensor(zLocal);
    }

    __aicore__ inline void RunStage(uint32_t task)
    {
        const uint32_t stageBase = task * elementsPerTask_;
        for (uint32_t r = 0; r < repeat_; ++r) {
            for (uint32_t offset = 0; offset < elementsPerTask_; offset += tileLength_) {
                const uint32_t base = stageBase + offset;
                CopyIn(base);
                Compute();
                CopyOut(base);
            }
        }
        PipeBarrier<PIPE_ALL>();
    }

    __aicore__ inline void SetStageFlag(uint32_t task)
    {
        LocalTensor<int32_t> local = flagQueue_.AllocTensor<int32_t>();
        Duplicate<int32_t>(local, 0, kFlagStrideWords);
        local.SetValue(0, static_cast<int32_t>(task + 1U));
        LocalSync<HardEvent::S_MTE3>();
        DataCopy(flagGm_[task * kFlagStrideWords], local, kFlagStrideWords);
        flagQueue_.FreeTensor(local);
        PipeBarrier<PIPE_ALL>();
    }

private:
    TPipe pipe_;
    TQue<TPosition::VECIN, kBufferNum> inQueueX_;
    TQue<TPosition::VECIN, kBufferNum> inQueueY_;
    TQue<TPosition::VECOUT, kBufferNum> outQueueZ_;
    TQue<TPosition::VECOUT, 1> flagQueue_;
    GlobalTensor<float> xGm_;
    GlobalTensor<float> yGm_;
    GlobalTensor<float> zGm_;
    GlobalTensor<int32_t> flagGm_;
    uint32_t taskCount_;
    uint32_t elementsPerTask_;
    uint32_t tileLength_;
    uint32_t repeat_;
};

extern "C" __global__ __aicore__ void aiv_multi_stage_add_host_flag(GM_ADDR x, GM_ADDR y, GM_ADDR z,
    GM_ADDR flags, AivHostCpuTiling tiling)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    KernelStageAdd op;
    op.Init(x, y, z, flags, tiling);
    op.Process();
}

class KernelHostFlagSeries {
public:
    __aicore__ inline KernelHostFlagSeries() {}

    __aicore__ inline void Init(GM_ADDR flags, uint32_t events, uint32_t delayIters)
    {
        events_ = events;
        delayIters_ = delayIters;
        flagGm_.SetGlobalBuffer((__gm__ int32_t *)flags, events_ * kFlagStrideWords);
        pipe_.InitBuffer(flagQueue_, 1, kFlagStrideWords * sizeof(int32_t));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t event = 0; event < events_; ++event) {
            AivDelay(delayIters_);
            SetEventFlag(event);
        }
    }

private:
    __aicore__ inline void SetEventFlag(uint32_t event)
    {
        LocalTensor<int32_t> local = flagQueue_.AllocTensor<int32_t>();
        Duplicate<int32_t>(local, 0, kFlagStrideWords);
        local.SetValue(0, static_cast<int32_t>(event + 1U));
        LocalSync<HardEvent::S_MTE3>();
        DataCopy(flagGm_[event * kFlagStrideWords], local, kFlagStrideWords);
        flagQueue_.FreeTensor(local);
        PipeBarrier<PIPE_ALL>();
    }

private:
    TPipe pipe_;
    TQue<TPosition::VECOUT, 1> flagQueue_;
    GlobalTensor<int32_t> flagGm_;
    uint32_t events_;
    uint32_t delayIters_;
};

extern "C" __global__ __aicore__ void aiv_host_flag_series(GM_ADDR flags, uint32_t events, uint32_t delayIters)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    KernelHostFlagSeries op;
    op.Init(flags, events, delayIters);
    op.Process();
}

extern "C" __global__ __aicore__ void aiv_delay_calib(uint32_t events, uint32_t delayIters)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    for (uint32_t event = 0; event < events; ++event) {
        AivDelay(delayIters);
    }
    PipeBarrier<PIPE_ALL>();
}

class KernelHostAivRoundtrip {
public:
    __aicore__ inline KernelHostAivRoundtrip() {}

    __aicore__ inline void Init(GM_ADDR flags, uint32_t events, uint32_t aivPollLimit)
    {
        events_ = events;
        aivPollLimit_ = aivPollLimit;
        const uint32_t slots = kRoundtripAivPollBaseSlot + events_ + events_;
        flagGm_.SetGlobalBuffer((__gm__ int32_t *)flags, slots * kFlagStrideWords);
        timestampGm_.SetGlobalBuffer((__gm__ uint32_t *)flags, slots * kTimestampWords);
        pipe_.InitBuffer(readQueue_, 1, kFlagStrideWords * sizeof(int32_t));
        pipe_.InitBuffer(writeQueue_, 1, kFlagStrideWords * sizeof(int32_t));
        pipe_.InitBuffer(timestampQueue_, 1, kFlagStrideWords * sizeof(int32_t));
    }

    __aicore__ inline void Process()
    {
        WriteSlot(kRoundtripReadySlot, 1);
        for (uint32_t seq = 1; seq <= events_; ++seq) {
            uint32_t polls = 0;
            while (ReadSlot(kRoundtripCpuReqSlot) < seq) {
                if (ReadSlot(kRoundtripAbortSlot) != 0) {
                    WriteSlot(kRoundtripStatusSlot, kStatusTimeout);
                    return;
                }
                ++polls;
                if (polls >= aivPollLimit_) {
                    WriteSlot(kRoundtripAivPollBaseSlot + seq - 1U, polls);
                    WriteSlot(kRoundtripStatusSlot, kStatusTimeout);
                    return;
                }
            }
            const uint64_t recvCycle = static_cast<uint64_t>(GetSystemCycle());
            const uint64_t sendCycle = static_cast<uint64_t>(GetSystemCycle());
            WriteTimestampSlot(kRoundtripAivPollBaseSlot + events_ + seq - 1U, recvCycle, sendCycle);
            WriteSlot(kRoundtripAivPollBaseSlot + seq - 1U, polls);
            WriteSlot(kRoundtripAivAckSlot, seq);
        }
        WriteSlot(kRoundtripStatusSlot, kStatusOk);
    }

private:
    __aicore__ inline uint32_t ReadSlot(uint32_t slot)
    {
        LocalTensor<int32_t> local = readQueue_.AllocTensor<int32_t>();
        DataCopy(local, flagGm_[slot * kFlagStrideWords], kFlagStrideWords);
        LocalSync<HardEvent::MTE2_S>();
        const uint32_t value = static_cast<uint32_t>(local.GetValue(0));
        readQueue_.FreeTensor(local);
        return value;
    }

    __aicore__ inline void WriteSlot(uint32_t slot, uint32_t value)
    {
        LocalTensor<int32_t> local = writeQueue_.AllocTensor<int32_t>();
        Duplicate<int32_t>(local, 0, kFlagStrideWords);
        local.SetValue(0, static_cast<int32_t>(value));
        LocalSync<HardEvent::S_MTE3>();
        DataCopy(flagGm_[slot * kFlagStrideWords], local, kFlagStrideWords);
        writeQueue_.FreeTensor(local);
        PipeBarrier<PIPE_ALL>();
    }

    __aicore__ inline void WriteTimestampSlot(uint32_t slot, uint64_t recvCycle, uint64_t sendCycle)
    {
        LocalTensor<uint32_t> local = timestampQueue_.AllocTensor<uint32_t>();
        Duplicate<uint32_t>(local, 0, kTimestampWords);
        local.SetValue(0, static_cast<uint32_t>(recvCycle));
        local.SetValue(1, static_cast<uint32_t>(recvCycle >> 32));
        local.SetValue(2, static_cast<uint32_t>(sendCycle));
        local.SetValue(3, static_cast<uint32_t>(sendCycle >> 32));
        LocalSync<HardEvent::S_MTE3>();
        DataCopy(timestampGm_[slot * kTimestampWords], local, kTimestampWords);
        timestampQueue_.FreeTensor(local);
        PipeBarrier<PIPE_ALL>();
    }

private:
    TPipe pipe_;
    TQue<TPosition::VECIN, 1> readQueue_;
    TQue<TPosition::VECOUT, 1> writeQueue_;
    TQue<TPosition::VECOUT, 1> timestampQueue_;
    GlobalTensor<int32_t> flagGm_;
    GlobalTensor<uint32_t> timestampGm_;
    uint32_t events_;
    uint32_t aivPollLimit_;
};

extern "C" __global__ __aicore__ void aiv_host_aiv_roundtrip(GM_ADDR flags, uint32_t events, uint32_t aivPollLimit)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    KernelHostAivRoundtrip op;
    op.Init(flags, events, aivPollLimit);
    op.Process();
}

class KernelHostAivRoundtripFast {
public:
    __aicore__ inline KernelHostAivRoundtripFast() {}

    __aicore__ inline void Init(GM_ADDR flags, uint32_t events)
    {
        events_ = events;
        flagGm_.SetGlobalBuffer((__gm__ int32_t *)flags, kRoundtripAivPollBaseSlot * kFlagStrideWords);
        pipe_.InitBuffer(readQueue_, 1, kFlagStrideWords * sizeof(int32_t));
        pipe_.InitBuffer(writeQueue_, 1, kFlagStrideWords * sizeof(int32_t));
    }

    __aicore__ inline void Process()
    {
        WriteSlot(kRoundtripReadySlot, 1);
        for (uint32_t seq = 1; seq <= events_; ++seq) {
            while (ReadSlot(kRoundtripCpuReqSlot) < seq) {}
            WriteSlot(kRoundtripAivAckSlot, seq);
        }
        WriteSlot(kRoundtripStatusSlot, kStatusOk);
    }

private:
    __aicore__ inline uint32_t ReadSlot(uint32_t slot)
    {
        LocalTensor<int32_t> local = readQueue_.AllocTensor<int32_t>();
        DataCopy(local, flagGm_[slot * kFlagStrideWords], kFlagStrideWords);
        LocalSync<HardEvent::MTE2_S>();
        const uint32_t value = static_cast<uint32_t>(local.GetValue(0));
        readQueue_.FreeTensor(local);
        return value;
    }

    __aicore__ inline void WriteSlot(uint32_t slot, uint32_t value)
    {
        LocalTensor<int32_t> local = writeQueue_.AllocTensor<int32_t>();
        Duplicate<int32_t>(local, 0, kFlagStrideWords);
        local.SetValue(0, static_cast<int32_t>(value));
        LocalSync<HardEvent::S_MTE3>();
        DataCopy(flagGm_[slot * kFlagStrideWords], local, kFlagStrideWords);
        writeQueue_.FreeTensor(local);
        PipeBarrier<PIPE_ALL>();
    }

private:
    TPipe pipe_;
    TQue<TPosition::VECIN, 1> readQueue_;
    TQue<TPosition::VECOUT, 1> writeQueue_;
    GlobalTensor<int32_t> flagGm_;
    uint32_t events_;
};

extern "C" __global__ __aicore__ void aiv_host_aiv_roundtrip_fast(GM_ADDR flags, uint32_t events)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    KernelHostAivRoundtripFast op;
    op.Init(flags, events);
    op.Process();
}

class KernelAivHostPacedTimestamp {
public:
    __aicore__ inline KernelAivHostPacedTimestamp() {}

    __aicore__ inline void Init(GM_ADDR flags, uint32_t events, uint32_t delayIters)
    {
        events_ = events;
        delayIters_ = delayIters;
        recordGm_.SetGlobalBuffer((__gm__ uint32_t *)flags, events_ * kTimestampWords);
        pipe_.InitBuffer(recordQueue_, 1, kTimestampWords * sizeof(uint32_t));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t event = 0; event < events_; ++event) {
            AivDelay(delayIters_);
            const uint64_t deviceCycle = static_cast<uint64_t>(GetSystemCycle());
            WriteRecord(event, deviceCycle, event + 1U);
        }
    }

private:
    __aicore__ inline void WriteRecord(uint32_t event, uint64_t deviceCycle, uint32_t sequence)
    {
        LocalTensor<uint32_t> local = recordQueue_.AllocTensor<uint32_t>();
        Duplicate<uint32_t>(local, 0, kTimestampWords);
        local.SetValue(kPacedCycleLowWord, static_cast<uint32_t>(deviceCycle));
        local.SetValue(kPacedCycleHighWord, static_cast<uint32_t>(deviceCycle >> 32));
        local.SetValue(kPacedSequenceWord, sequence);
        local.SetValue(kPacedReadyWord, sequence);
        LocalSync<HardEvent::S_MTE3>();
        DataCopy(recordGm_[event * kTimestampWords], local, kTimestampWords);
        recordQueue_.FreeTensor(local);
        PipeBarrier<PIPE_ALL>();
    }

private:
    TPipe pipe_;
    TQue<TPosition::VECOUT, 1> recordQueue_;
    GlobalTensor<uint32_t> recordGm_;
    uint32_t events_ = 0;
    uint32_t delayIters_ = 0;
};

extern "C" __global__ __aicore__ void aiv_host_paced_timestamp(GM_ADDR flags,
    uint32_t events, uint32_t delayIters)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    KernelAivHostPacedTimestamp op;
    op.Init(flags, events, delayIters);
    op.Process();
}

