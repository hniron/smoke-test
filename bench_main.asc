#define GM_ADDR __gm__ uint8_t *
#endif

using namespace AscendC;

constexpr uint32_t kDefaultTile = 1024;
constexpr uint32_t kDefaultRepeat = 8;
constexpr uint32_t kDefaultBlocks = 8;
constexpr uint32_t kDefaultIters = 5;
constexpr uint32_t kDefaultWarmup = 1;
constexpr uint64_t kDefaultBytes = 256ULL * 1024ULL * 1024ULL;
constexpr uint32_t kDefaultCommIters = 32;
constexpr uint32_t kDefaultHixlTimeoutMs = 10000;
constexpr uint32_t kOpRead = 0;
constexpr uint32_t kOpWrite = 1;
constexpr uint32_t kOpCopy = 2;
constexpr uint32_t kStatusOk = 0;
constexpr uint32_t kStatusParamInvalid = 1;
constexpr uint32_t kStatusAclError = 2;

struct HbmBenchTiling {
    uint32_t elements;
    uint32_t tileLength;
    uint32_t repeat;
    uint32_t op;
    uint32_t blocks;
};

template<HardEvent event>
__aicore__ inline void LocalSync()
{
    int32_t eventId = static_cast<int32_t>(GetTPipePtr()->FetchEventID(event));
    SetFlag<event>(eventId);
    WaitFlag<event>(eventId);
}

class KernelHbmBandwidth {
public:
    __aicore__ inline KernelHbmBandwidth() {}

    __aicore__ inline void Init(GM_ADDR src, GM_ADDR dst, HbmBenchTiling tiling)
    {
        elements_ = tiling.elements;
        tileLength_ = tiling.tileLength;
        repeat_ = tiling.repeat;
        op_ = tiling.op;
        blocks_ = tiling.blocks == 0 ? 1 : tiling.blocks;
        blockIdx_ = static_cast<uint32_t>(GetBlockIdx());
        srcGm_.SetGlobalBuffer((__gm__ float *)src, elements_);
        dstGm_.SetGlobalBuffer((__gm__ float *)dst, elements_);
        pipe_.InitBuffer(inQueue_, 1, tileLength_ * sizeof(float));
        pipe_.InitBuffer(outQueue_, 1, tileLength_ * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t r = 0; r < repeat_; ++r) {
            for (uint32_t base = blockIdx_ * tileLength_; base < elements_; base += blocks_ * tileLength_) {
                const uint32_t remain = elements_ - base;
                const uint32_t len = remain < tileLength_ ? remain : tileLength_;
                if (op_ == kOpRead) {
                    RunRead(base, len);
                } else if (op_ == kOpWrite) {
                    RunWrite(base, len);
                } else {
                    RunCopy(base, len);
                }
            }
        }
        PipeBarrier<PIPE_ALL>();
    }

private:
    __aicore__ inline void RunRead(uint32_t base, uint32_t len)
    {
        LocalTensor<float> local = inQueue_.AllocTensor<float>();
        DataCopy(local, srcGm_[base], len);
        inQueue_.EnQue(local);
        LocalTensor<float> done = inQueue_.DeQue<float>();
        inQueue_.FreeTensor(done);
        PipeBarrier<PIPE_ALL>();
    }

    __aicore__ inline void RunWrite(uint32_t base, uint32_t len)
    {
        LocalTensor<float> local = outQueue_.AllocTensor<float>();
        Duplicate<float>(local, 1.0f, len);
        LocalSync<HardEvent::S_MTE3>();
        DataCopy(dstGm_[base], local, len);
        outQueue_.FreeTensor(local);
        PipeBarrier<PIPE_ALL>();
    }

    __aicore__ inline void RunCopy(uint32_t base, uint32_t len)
    {
        LocalTensor<float> local = inQueue_.AllocTensor<float>();
        DataCopy(local, srcGm_[base], len);
        inQueue_.EnQue(local);
        LocalTensor<float> done = inQueue_.DeQue<float>();
        LocalSync<HardEvent::S_MTE3>();
        DataCopy(dstGm_[base], done, len);
        inQueue_.FreeTensor(done);
        PipeBarrier<PIPE_ALL>();
    }

private:
    TPipe pipe_;
    TQue<TPosition::VECIN, 1> inQueue_;
    TQue<TPosition::VECOUT, 1> outQueue_;
    GlobalTensor<float> srcGm_;
    GlobalTensor<float> dstGm_;
    uint32_t elements_;
    uint32_t tileLength_;
    uint32_t repeat_;
    uint32_t op_;
    uint32_t blocks_;
    uint32_t blockIdx_;
};

extern "C" __global__ __aicore__ void aiv_hbm_bandwidth(GM_ADDR src, GM_ADDR dst, HbmBenchTiling tiling)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    KernelHbmBandwidth op;
    op.Init(src, dst, tiling);
    op.Process();
}

namespace {
struct Options {
    int32_t device = 0;
    std::string mode = "hbm_baseline";
    std::string hbmOpName = "copy";
    std::string commOpName = "acl_write_hbm";
    uint64_t bytes = kDefaultBytes;
    uint32_t tile = kDefaultTile;
    uint32_t repeat = kDefaultRepeat;
    uint32_t blocks = kDefaultBlocks;
    uint32_t commIters = kDefaultCommIters;
    uint32_t iters = kDefaultIters;
    uint32_t warmup = kDefaultWarmup;
    std::string hixlLocalEngine = "127.0.0.1:16001";
    std::string hixlServerEngine = "127.0.0.1:16000";
    std::string hixlLocalCommRes;
    std::string hixlSourceLocalCommRes;
    std::string hixlTargetLocalCommRes;
    std::string hixlBufferPool;
    std::string hixlProtocols = "ub_ctp:host,ub_ctp:device";
    std::string hixlGlobalResourceConfig;
    bool hixlProtocolsUser = false;
    bool hixlGlobalResourceConfigUser = false;
    int32_t hixlPeerDevice = 5;
    std::string hixlHostRoceIp;
    std::string hixlNetInstanceId = "default";
    uint32_t hixlTimeoutMs = kDefaultHixlTimeoutMs;
    std::string hcommProtocol = "roce";
    std::string hcommHostIp = "127.0.0.1";
    std::string hcommDeviceIp = "127.0.0.1";
    int32_t hcommDevicePhyId = -1;
    uint32_t hcommSuperDevId = 0;
    uint32_t hcommServerIdx = 0;
    uint32_t hcommSuperPodIdx = 0;
    uint32_t hcommHostId = 0;
    uint32_t hcommCreateChannel = 0;
    std::string hcommRole = "server";
    uint32_t hcommPort = 17000;
    uint32_t hcommNotifyNum = 0;
};

struct Buffers {
    void *src = nullptr;
    void *dst = nullptr;
    void *commDst = nullptr;
    void *host = nullptr;
    uint64_t dataBytes = 0;
    uint32_t elements = 0;
    bool hostMalloc = false;
};

struct RunResult {
    uint32_t status = kStatusOk;
    double hbmUs = 0.0;
    double hbmBwGBps = 0.0;
    double commUs = 0.0;
    double commBwGBps = 0.0;
    uint64_t commBytes = 0;
    uint64_t commCopies = 0;
};

uint64_t HostNowNs()
{
    return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
        std::chrono::steady_clock::now().time_since_epoch()).count());
}

int Fail(const char *expr, int ret, int line)
{
    std::cerr << "FAIL line " << line << ": " << expr << " ret=" << ret << std::endl;
    const char *recent = aclGetRecentErrMsg();
    if (recent != nullptr && recent[0] != '\0') {
        std::cerr << "ACL recent error: " << recent << std::endl;
    }
    return ret == 0 ? 1 : ret;
}

#define CHECK_ACL(expr) do { aclError _ret = (expr); if (_ret != ACL_SUCCESS) return Fail(#expr, static_cast<int>(_ret), __LINE__); } while (0)

#ifdef ENABLE_HIXL
int FailHixl(const char *expr, uint32_t ret, int line)
{
    std::cerr << "HIXL_FAIL line " << line << ": " << expr << " ret=" << ret << std::endl;
    const char *recent = aclGetRecentErrMsg();
    if (recent != nullptr && recent[0] != '\0') {
        std::cerr << "ACL recent error: " << recent << std::endl;
    }
    return ret == 0 ? 1 : static_cast<int>(ret);
}
#define CHECK_HIXL(expr) do { hixl::Status _ret = (expr); if (_ret != hixl::SUCCESS) return FailHixl(#expr, static_cast<uint32_t>(_ret), __LINE__); } while (0)
#endif

#ifdef ENABLE_HCOMM
extern "C" HcommResult HcommChannelGetRemoteMems(ChannelHandle channelHandle, uint32_t *memNum,
    CommMem **remoteMem, char ***memInfos);

int FailHcomm(const char *expr, HcommResult ret, int line)
{
    std::cerr << "HCOMM_FAIL line " << line << ": " << expr << " ret=" << ret << std::endl;
    const char *recent = aclGetRecentErrMsg();
    if (recent != nullptr && recent[0] != '\0') {
        std::cerr << "ACL recent error: " << recent << std::endl;
    }
    return ret == 0 ? 1 : static_cast<int>(ret);
}
#endif

bool ParseU32(const char *arg, const char *name, uint32_t *out)
{
    const size_t n = std::strlen(name);
    if (std::strncmp(arg, name, n) != 0 || arg[n] != '=') return false;
    *out = static_cast<uint32_t>(std::strtoul(arg + n + 1, nullptr, 0));
    return true;
}

bool ParseI32(const char *arg, const char *name, int32_t *out)
{
    const size_t n = std::strlen(name);
    if (std::strncmp(arg, name, n) != 0 || arg[n] != '=') return false;
    *out = static_cast<int32_t>(std::strtol(arg + n + 1, nullptr, 0));
    return true;
}

bool ParseStr(const char *arg, const char *name, std::string *out)
{
    const size_t n = std::strlen(name);
    if (std::strncmp(arg, name, n) != 0 || arg[n] != '=') return false;
    *out = arg + n + 1;
    return true;
}

uint64_t ParseSizeValue(const char *value)
{
    char *end = nullptr;
    uint64_t n = std::strtoull(value, &end, 0);
    if (end == nullptr || *end == '\0') return n;
    if (*end == 'k' || *end == 'K') return n * 1024ULL;
    if (*end == 'm' || *end == 'M') return n * 1024ULL * 1024ULL;
    if (*end == 'g' || *end == 'G') return n * 1024ULL * 1024ULL * 1024ULL;
    return n;
}

bool ParseSize(const char *arg, const char *name, uint64_t *out)
{
    const size_t n = std::strlen(name);
    if (std::strncmp(arg, name, n) != 0 || arg[n] != '=') return false;
    *out = ParseSizeValue(arg + n + 1);
    return true;
}

uint32_t HbmOpCode(const std::string &name)
{
    if (name == "read") return kOpRead;
    if (name == "write") return kOpWrite;
    return kOpCopy;
}

bool ValidHbmOp(const std::string &name)
{
    return name == "read" || name == "write" || name == "copy";
}

bool IsHixlCommOp(const std::string &name)
{
    return name == "hixl_write_hbm" || name == "hixl_read_hbm" ||
        name == "hixl_host_write_hbm" || name == "hixl_host_read_hbm";
}

bool IsHixlPeerCommOp(const std::string &name)
{
    return name == "hixl_write_hbm" || name == "hixl_read_hbm";
}

bool IsHixlHostCommOp(const std::string &name)
{
    return name == "hixl_host_write_hbm" || name == "hixl_host_read_hbm";
}

bool IsHixlWriteCommOp(const std::string &name)
{
    return name == "hixl_write_hbm" || name == "hixl_host_write_hbm";
}

bool IsHcommCommOp(const std::string &name)
{
    return name == "hcomm_host_write_hbm" || name == "hcomm_host_read_hbm" ||
        name == "hcomm_host_rw_hbm";
}

bool IsHcommWriteCommOp(const std::string &name)
{
    return name == "hcomm_host_write_hbm";
}

bool IsHcommReadWriteCommOp(const std::string &name)
{
    return name == "hcomm_host_rw_hbm";
}

std::string BuildHixlProtocolConfig(const std::string &protocols)
{
    std::string config = "{\"comm_resource_config.protocol_desc\": [";
    size_t start = 0;
    bool first = true;
    while (start <= protocols.size()) {
        const size_t comma = protocols.find(',', start);
        const std::string item = protocols.substr(start, comma == std::string::npos ? std::string::npos : comma - start);
        if (!item.empty()) {
            if (!first) {
                config += ",";
            }
            config += "\"";
            config += item;
            config += "\"";
            first = false;
        }
        if (comma == std::string::npos) {
            break;
        }
        start = comma + 1;
    }
    config += "]}";
    return config;
}

std::string BuildRoceHostLocalCommRes(const std::string &roceIp, const std::string &netInstanceId)
{
    return "{\"version\":\"1.3\",\"net_instance_id\":\"" + netInstanceId +
        "\",\"endpoint_list\":[{\"protocol\":\"roce\",\"comm_id\":\"" + roceIp +
        "\",\"placement\":\"host\"}]}";
}

std::string ResolveSourceLocalCommRes(const Options &opt)
{
    if (!opt.hixlSourceLocalCommRes.empty()) return opt.hixlSourceLocalCommRes;
    if (!opt.hixlLocalCommRes.empty()) return opt.hixlLocalCommRes;
    if (IsHixlHostCommOp(opt.commOpName) && !opt.hixlHostRoceIp.empty()) {
        return BuildRoceHostLocalCommRes(opt.hixlHostRoceIp, opt.hixlNetInstanceId);
    }
    return "";
}

std::string ResolveTargetLocalCommRes(const Options &opt)
{
    if (!opt.hixlTargetLocalCommRes.empty()) return opt.hixlTargetLocalCommRes;
    if (!opt.hixlLocalCommRes.empty()) return opt.hixlLocalCommRes;
    if (IsHixlHostCommOp(opt.commOpName) && !opt.hixlHostRoceIp.empty()) {
        return BuildRoceHostLocalCommRes(opt.hixlHostRoceIp, opt.hixlNetInstanceId);
    }
    return "";
}

bool ValidCommOp(const std::string &name)
{
    return name == "acl_write_hbm" || IsHixlCommOp(name) || IsHcommCommOp(name);
}

bool ValidHcommProtocolName(const std::string &name)
{
    return name == "roce" || name == "ubc_tp" || name == "ub_tp" || name == "tp" ||
        name == "ubc_ctp" || name == "ub_ctp" || name == "ctp" || name == "urma" ||
        name == "uboe";
}

bool ValidHcommRoleName(const std::string &name)
{
    return name == "server" || name == "client" || name == "reserved";
}

bool NeedHbm(const Options &opt)
{
    return opt.mode == "hbm_baseline" || opt.mode == "interference";
}

bool NeedComm(const Options &opt)
{
    return opt.mode == "comm_baseline" || opt.mode == "interference";
}

void Usage(const char *prog)
{
    std::cerr
        << "usage: " << prog << " [--device=0]\n"
        << "       [--mode=hbm_baseline|comm_baseline|interference|hcomm_smoke]\n"
        << "       [--hbm-op=read|write|copy]\n"
        << "       [--comm-op=acl_write_hbm|hixl_write_hbm|hixl_read_hbm|hixl_host_write_hbm|hixl_host_read_hbm]\n"
        << "       [--comm-op=hcomm_host_write_hbm|hcomm_host_read_hbm|hcomm_host_rw_hbm]\n"
        << "       [--bytes=256M] [--tile=1024] [--repeat=8] [--blocks=8]\n"
        << "       [--comm-iters=32] [--iters=5] [--warmup=1]\n"
        << "       [--hixl-local-engine=127.0.0.1:16001] [--hixl-server-engine=127.0.0.1:16000]\n"
        << "       [--hixl-peer-device=5] [--hixl-protocols=ub_ctp:host,ub_ctp:device]\n"
        << "       [--hixl-global-resource-config=json] [--hixl-local-comm-res=json]\n"
        << "       [--hixl-source-local-comm-res=json] [--hixl-target-local-comm-res=json]\n"
        << "       [--hixl-host-roce-ip=10.x.x.x] [--hixl-net-instance-id=default]\n"
        << "       [--hixl-buffer-pool=0:0] [--hixl-timeout-ms=10000]\n"
        << "       [--hcomm-protocol=roce|ubc_tp|ubc_ctp|uboe] [--hcomm-host-ip=<ip-or-eid>]\n"
        << "       [--hcomm-host-addr=<ip-or-eid>] [--hcomm-device-ip=<ip-or-eid>]\n"
        << "       [--hcomm-device-addr=<ip-or-eid>] [--hcomm-device-phy-id=-1]\n"
        << "       [--hcomm-create-channel=0|1] [--hcomm-role=server|client|reserved]\n"
        << "       [--hcomm-port=17000] [--hcomm-notify-num=0]\n";
}

bool ParseOptions(int argc, char **argv, Options *opt)
{
    for (int i = 1; i < argc; ++i) {
        if (ParseStr(argv[i], "--hixl-protocols", &opt->hixlProtocols)) {
            opt->hixlProtocolsUser = true;
            continue;
        }
        if (ParseStr(argv[i], "--hixl-global-resource-config", &opt->hixlGlobalResourceConfig)) {
            opt->hixlGlobalResourceConfigUser = true;
            continue;
        }
        if (ParseI32(argv[i], "--device", &opt->device) ||
            ParseStr(argv[i], "--mode", &opt->mode) ||
            ParseStr(argv[i], "--hbm-op", &opt->hbmOpName) ||
            ParseStr(argv[i], "--comm-op", &opt->commOpName) ||
            ParseSize(argv[i], "--bytes", &opt->bytes) ||
            ParseU32(argv[i], "--tile", &opt->tile) ||
            ParseU32(argv[i], "--repeat", &opt->repeat) ||
            ParseU32(argv[i], "--blocks", &opt->blocks) ||
            ParseU32(argv[i], "--comm-iters", &opt->commIters) ||
            ParseU32(argv[i], "--iters", &opt->iters) ||
            ParseU32(argv[i], "--warmup", &opt->warmup) ||
            ParseStr(argv[i], "--hixl-local-engine", &opt->hixlLocalEngine) ||
            ParseStr(argv[i], "--hixl-server-engine", &opt->hixlServerEngine) ||
            ParseStr(argv[i], "--hixl-local-comm-res", &opt->hixlLocalCommRes) ||
            ParseStr(argv[i], "--hixl-source-local-comm-res", &opt->hixlSourceLocalCommRes) ||
            ParseStr(argv[i], "--hixl-target-local-comm-res", &opt->hixlTargetLocalCommRes) ||
            ParseStr(argv[i], "--hixl-buffer-pool", &opt->hixlBufferPool) ||
            ParseI32(argv[i], "--hixl-peer-device", &opt->hixlPeerDevice) ||
            ParseStr(argv[i], "--hixl-host-roce-ip", &opt->hixlHostRoceIp) ||
            ParseStr(argv[i], "--hixl-net-instance-id", &opt->hixlNetInstanceId) ||
            ParseU32(argv[i], "--hixl-timeout-ms", &opt->hixlTimeoutMs) ||
            ParseStr(argv[i], "--hcomm-protocol", &opt->hcommProtocol) ||
            ParseStr(argv[i], "--hcomm-host-ip", &opt->hcommHostIp) ||
            ParseStr(argv[i], "--hcomm-host-addr", &opt->hcommHostIp) ||
            ParseStr(argv[i], "--hcomm-device-ip", &opt->hcommDeviceIp) ||
            ParseStr(argv[i], "--hcomm-device-addr", &opt->hcommDeviceIp) ||
            ParseI32(argv[i], "--hcomm-device-phy-id", &opt->hcommDevicePhyId) ||
            ParseU32(argv[i], "--hcomm-super-dev-id", &opt->hcommSuperDevId) ||
            ParseU32(argv[i], "--hcomm-server-idx", &opt->hcommServerIdx) ||
            ParseU32(argv[i], "--hcomm-super-pod-idx", &opt->hcommSuperPodIdx) ||
            ParseU32(argv[i], "--hcomm-host-id", &opt->hcommHostId) ||
            ParseU32(argv[i], "--hcomm-create-channel", &opt->hcommCreateChannel) ||
            ParseStr(argv[i], "--hcomm-role", &opt->hcommRole) ||
            ParseU32(argv[i], "--hcomm-port", &opt->hcommPort) ||
            ParseU32(argv[i], "--hcomm-notify-num", &opt->hcommNotifyNum)) {
            continue;
        }
        return false;
    }
    const bool validMode = opt->mode == "hbm_baseline" || opt->mode == "comm_baseline" ||
        opt->mode == "interference" || opt->mode == "hcomm_smoke";
    if (IsHixlHostCommOp(opt->commOpName) && !opt->hixlProtocolsUser && !opt->hixlGlobalResourceConfigUser) {
        opt->hixlProtocols = "roce:host";
    }
    if (IsHcommCommOp(opt->commOpName) && opt->hcommProtocol == "roce") {
        opt->hcommProtocol = "ubc_ctp";
    }
    if (opt->hixlGlobalResourceConfig.empty()) {
        opt->hixlGlobalResourceConfig = BuildHixlProtocolConfig(opt->hixlProtocols);
    }
    const bool validHixlBase = !IsHixlCommOp(opt->commOpName) ||
        (opt->hixlLocalEngine != opt->hixlServerEngine && !opt->hixlGlobalResourceConfig.empty());
    const bool validPeerHixl = !IsHixlPeerCommOp(opt->commOpName) ||
        (opt->hixlPeerDevice >= 0 && opt->hixlPeerDevice != opt->device);
    const bool validHostHixl = !IsHixlHostCommOp(opt->commOpName) ||
        (!ResolveSourceLocalCommRes(*opt).empty() && !ResolveTargetLocalCommRes(*opt).empty());
    return validMode && validHixlBase && validPeerHixl && validHostHixl &&
        ValidHbmOp(opt->hbmOpName) && ValidCommOp(opt->commOpName) &&
        ValidHcommProtocolName(opt->hcommProtocol) && ValidHcommRoleName(opt->hcommRole) &&
        opt->bytes >= sizeof(float) && opt->tile > 0 && opt->repeat > 0 &&
        opt->blocks > 0 && opt->iters > 0 && opt->commIters > 0 && opt->hixlTimeoutMs > 0 &&
        opt->hcommCreateChannel <= 1 && opt->hcommPort <= 65535;
}

double Average(const std::vector<double> &values)
{
    if (values.empty()) return 0.0;
    return std::accumulate(values.begin(), values.end(), 0.0) / static_cast<double>(values.size());
}

double BytesToGBps(uint64_t bytes, double us)
{
    if (us <= 0.0) return 0.0;
    return static_cast<double>(bytes) / (us * 1000.0);
}

uint64_t HbmBytesPerRun(const Options &opt, const Buffers &buf)
{
    const uint64_t factor = opt.hbmOpName == "copy" ? 2ULL : 1ULL;
    return buf.dataBytes * static_cast<uint64_t>(opt.repeat) * factor;
}

int InitBuffers(const Options &opt, Buffers *buf)
{
    if ((opt.bytes / sizeof(float)) > 0xffffffffULL) {
        return Fail("bytes too large for uint32_t elements", 1, __LINE__);
    }
    buf->elements = static_cast<uint32_t>(opt.bytes / sizeof(float));
    buf->dataBytes = static_cast<uint64_t>(buf->elements) * sizeof(float);
    if (buf->elements == 0 || buf->dataBytes == 0) {
        return Fail("bytes must hold at least one float", 1, __LINE__);
    }
    CHECK_ACL(aclrtMalloc(&buf->src, buf->dataBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc(&buf->dst, buf->dataBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc(&buf->commDst, buf->dataBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    const bool usePlainHostMalloc = IsHixlHostCommOp(opt.commOpName) || IsHcommCommOp(opt.commOpName) ||
        opt.mode == "hcomm_smoke";
    if (usePlainHostMalloc) {
        if (IsHcommCommOp(opt.commOpName) || opt.mode == "hcomm_smoke") {
            if (posix_memalign(&buf->host, 4096U, static_cast<size_t>(buf->dataBytes)) != 0 ||
                buf->host == nullptr) {
                return Fail("posix_memalign(host)", 1, __LINE__);
            }
        } else {
            buf->host = std::malloc(static_cast<size_t>(buf->dataBytes));
            if (buf->host == nullptr) {
                return Fail("std::malloc(host)", 1, __LINE__);
            }
        }
        buf->hostMalloc = true;
    } else {
        CHECK_ACL(aclrtMallocHost(&buf->host, buf->dataBytes));
    }
    std::memset(buf->host, 0x5a, buf->dataBytes);
    CHECK_ACL(aclrtMemcpy(buf->src, buf->dataBytes, buf->host, buf->dataBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemset(buf->dst, buf->dataBytes, 0, buf->dataBytes));
    CHECK_ACL(aclrtMemset(buf->commDst, buf->dataBytes, 0, buf->dataBytes));
    return 0;
}

void FreeBuffers(Buffers *buf)
{
    if (buf->src != nullptr) (void)aclrtFree(buf->src);
    if (buf->dst != nullptr) (void)aclrtFree(buf->dst);
    if (buf->commDst != nullptr) (void)aclrtFree(buf->commDst);
    if (buf->host != nullptr) {
        if (buf->hostMalloc) {
            std::free(buf->host);
        } else {
            (void)aclrtFreeHost(buf->host);
        }
    }
    *buf = Buffers{};
}

#ifdef ENABLE_HIXL
std::map<hixl::AscendString, hixl::AscendString> BuildHixlOptions(const Options &opt,
    const std::string &localCommRes)
{
    std::map<hixl::AscendString, hixl::AscendString> options;
    if (!localCommRes.empty()) {
        options[hixl::OPTION_LOCAL_COMM_RES] = localCommRes.c_str();
    }
    if (!opt.hixlBufferPool.empty()) {
        options[hixl::OPTION_BUFFER_POOL] = opt.hixlBufferPool.c_str();
    }
    if (!opt.hixlGlobalResourceConfig.empty()) {
        options[hixl::OPTION_GLOBAL_RESOURCE_CONFIG] = opt.hixlGlobalResourceConfig.c_str();
    }
    return options;
}

struct HixlSession {
    hixl::Hixl target;
    hixl::Hixl source;
    hixl::MemHandle targetHandle = nullptr;
    hixl::MemHandle sourceHandle = nullptr;
    aclrtContext targetContext = nullptr;
    aclrtContext sourceContext = nullptr;
    bool targetInitialized = false;
    bool sourceInitialized = false;
    bool initialized = false;
    bool connected = false;

    int Init(const Options &opt, const Buffers &buf)
    {
        if (IsHixlHostCommOp(opt.commOpName)) {
            if (setenv("HCCL_INTRA_ROCE_ENABLE", "1", 1) != 0) {
                return Fail("setenv(HCCL_INTRA_ROCE_ENABLE)", 1, __LINE__);
            }
        }

        auto targetOptions = BuildHixlOptions(opt, ResolveTargetLocalCommRes(opt));
        auto sourceOptions = BuildHixlOptions(opt, ResolveSourceLocalCommRes(opt));

        CHECK_ACL(aclrtSetDevice(opt.device));
        CHECK_ACL(aclrtGetCurrentContext(&targetContext));
        CHECK_HIXL(target.Initialize(opt.hixlServerEngine.c_str(), targetOptions));
        targetInitialized = true;

        hixl::MemDesc remoteDesc{};
        remoteDesc.addr = reinterpret_cast<uintptr_t>(buf.commDst);
        remoteDesc.len = static_cast<size_t>(buf.dataBytes);
        CHECK_HIXL(target.RegisterMem(remoteDesc, hixl::MEM_DEVICE, targetHandle));

        if (IsHixlHostCommOp(opt.commOpName)) {
            CHECK_ACL(aclrtSetDevice(opt.device));
        } else {
            CHECK_ACL(aclrtSetDevice(opt.hixlPeerDevice));
        }
        CHECK_ACL(aclrtGetCurrentContext(&sourceContext));
        CHECK_HIXL(source.Initialize(opt.hixlLocalEngine.c_str(), sourceOptions));
        sourceInitialized = true;

        hixl::MemDesc localDesc{};
        localDesc.addr = reinterpret_cast<uintptr_t>(buf.host);
        localDesc.len = static_cast<size_t>(buf.dataBytes);
        CHECK_HIXL(source.RegisterMem(localDesc, hixl::MEM_HOST, sourceHandle));

        CHECK_HIXL(source.Connect(opt.hixlServerEngine.c_str(), static_cast<int32_t>(opt.hixlTimeoutMs)));
        connected = true;
        initialized = true;
        CHECK_ACL(aclrtSetDevice(opt.device));
        return 0;
    }

    int TransferOnce(const Options &opt, const Buffers &buf)
    {
        if (sourceContext != nullptr) {
            CHECK_ACL(aclrtSetCurrentContext(sourceContext));
        }
        hixl::TransferOpDesc desc{
            reinterpret_cast<uintptr_t>(buf.host),
            reinterpret_cast<uintptr_t>(buf.commDst),
            static_cast<size_t>(buf.dataBytes),
        };
        const hixl::TransferOp op = IsHixlWriteCommOp(opt.commOpName) ? hixl::WRITE : hixl::READ;
        CHECK_HIXL(source.TransferSync(opt.hixlServerEngine.c_str(), op, {desc},
            static_cast<int32_t>(opt.hixlTimeoutMs)));
        return 0;
    }

    void Finalize(const Options &opt)
    {
        if (sourceContext != nullptr) {
            (void)aclrtSetCurrentContext(sourceContext);
        } else if (IsHixlHostCommOp(opt.commOpName)) {
            (void)aclrtSetDevice(opt.device);
        } else {
            (void)aclrtSetDevice(opt.hixlPeerDevice);
        }
        if (connected) {
            (void)source.Disconnect(opt.hixlServerEngine.c_str(), static_cast<int32_t>(opt.hixlTimeoutMs));
            connected = false;
        }
        if (sourceHandle != nullptr) {
            (void)source.DeregisterMem(sourceHandle);
            sourceHandle = nullptr;
        }
        if (sourceInitialized) {
            source.Finalize();
            sourceInitialized = false;
        }

        if (targetContext != nullptr) {
            (void)aclrtSetCurrentContext(targetContext);
        } else {
            (void)aclrtSetDevice(opt.device);
        }
        if (targetHandle != nullptr) {
            (void)target.DeregisterMem(targetHandle);
            targetHandle = nullptr;
        }
        if (targetInitialized) {
            target.Finalize();
            targetInitialized = false;
        }
        initialized = false;
        (void)aclrtSetDevice(opt.device);
    }
};
#else
struct HixlSession {};
#endif

#ifdef ENABLE_HCOMM
::CommProtocol HcommProtocolCode(const std::string &name)
{
    if (name == "ubc_tp" || name == "ub_tp" || name == "tp") return COMM_PROTOCOL_UBC_TP;
    if (name == "ubc_ctp" || name == "ub_ctp" || name == "ctp" || name == "urma") {
        return COMM_PROTOCOL_UBC_CTP;
    }
    if (name == "uboe") return COMM_PROTOCOL_UBOE;
    return COMM_PROTOCOL_ROCE;
}

::HcommSocketRole HcommRoleCode(const std::string &name)
{
    if (name == "client") return HCOMM_SOCKET_ROLE_CLIENT;
    if (name == "reserved") return HCOMM_SOCKET_ROLE_RESERVED;
    return HCOMM_SOCKET_ROLE_SERVER;
}

int HexNibble(char value)
{
    if (value >= '0' && value <= '9') return value - '0';
    if (value >= 'a' && value <= 'f') return value - 'a' + 10;
    if (value >= 'A' && value <= 'F') return value - 'A' + 10;
    return -1;
}

std::string NormalizeEid(const std::string &eid)
{
    std::string normalized;
    normalized.reserve(eid.size());
    size_t start = 0;
    if (eid.size() > 2 && eid[0] == '0' && (eid[1] == 'x' || eid[1] == 'X')) {
        start = 2;
    }
    for (size_t i = start; i < eid.size(); ++i) {
        if (eid[i] != ':' && eid[i] != '-') {
            normalized.push_back(eid[i]);
        }
    }
    return normalized;
}

bool ParseHcommEid(const std::string &text, CommAddr *addr)
{
    const std::string normalized = NormalizeEid(text);
    if (normalized.size() != COMM_ADDR_EID_LEN * 2U) {
        return false;
    }
    addr->type = COMM_ADDR_TYPE_EID;
    for (size_t i = 0; i < COMM_ADDR_EID_LEN; ++i) {
        const int hi = HexNibble(normalized[i * 2U]);
        const int lo = HexNibble(normalized[i * 2U + 1U]);
        if (hi < 0 || lo < 0) {
            return false;
        }
        addr->eid[i] = static_cast<uint8_t>((hi << 4U) | lo);
    }
    return true;
}

int FillHcommAddress(EndpointDesc *desc, const std::string &addrText)
{
    if (ParseHcommEid(addrText, &desc->commAddr)) {
        return 0;
    }
    desc->commAddr.type = COMM_ADDR_TYPE_IP_V4;
    if (inet_pton(AF_INET, addrText.c_str(), &desc->commAddr.addr) == 1) {
        return 0;
    }
    desc->commAddr.type = COMM_ADDR_TYPE_IP_V6;
    if (inet_pton(AF_INET6, addrText.c_str(), &desc->commAddr.addr6) == 1) {
        return 0;
    }
    return Fail("invalid HCOMM address, expected IPv4/IPv6/EID", 1, __LINE__);
}

void PrintHcommStep(const char *step, HcommResult ret)
{
    std::cout << "hcomm_smoke_step=" << step << " ret=" << ret << std::endl;
}
#endif

int RunHcommSmoke(const Options &opt, const Buffers &buf, RunResult *result)
{
#ifndef ENABLE_HCOMM
    (void)opt;
    (void)buf;
    (void)result;
    return Fail("HCOMM support not enabled. Rebuild with -DENABLE_HCOMM=ON", 1, __LINE__);
#else
    EndpointDesc hostDesc{};
    EndpointDesc deviceDesc{};
    HcommResult hret = EndpointDescInit(&hostDesc, 1);
    PrintHcommStep("host_endpoint_desc_init", hret);
    if (hret != 0) return FailHcomm("EndpointDescInit(hostDesc)", hret, __LINE__);
    hret = EndpointDescInit(&deviceDesc, 1);
    PrintHcommStep("device_endpoint_desc_init", hret);
    if (hret != 0) return FailHcomm("EndpointDescInit(deviceDesc)", hret, __LINE__);

    const ::CommProtocol protocol = HcommProtocolCode(opt.hcommProtocol);
    const uint32_t devPhyId = opt.hcommDevicePhyId >= 0 ?
        static_cast<uint32_t>(opt.hcommDevicePhyId) : static_cast<uint32_t>(opt.device);

    hostDesc.protocol = protocol;
    hostDesc.loc.locType = ENDPOINT_LOC_TYPE_HOST;
    hostDesc.loc.host.id = opt.hcommHostId;
    int ret = FillHcommAddress(&hostDesc, opt.hcommHostIp);
    if (ret != 0) return ret;

    deviceDesc.protocol = protocol;
    deviceDesc.loc.locType = ENDPOINT_LOC_TYPE_DEVICE;
    deviceDesc.loc.device.devPhyId = devPhyId;
    deviceDesc.loc.device.superDevId = opt.hcommSuperDevId;
    deviceDesc.loc.device.serverIdx = opt.hcommServerIdx;
    deviceDesc.loc.device.superPodIdx = opt.hcommSuperPodIdx;
    ret = FillHcommAddress(&deviceDesc, opt.hcommDeviceIp);
    if (ret != 0) return ret;

    std::cout << "hcomm_smoke_resolved_device_phy_id=" << devPhyId << std::endl;

    EndpointHandle hostEndpoint = nullptr;
    EndpointHandle deviceEndpoint = nullptr;
    HcommMemHandle hostMem = nullptr;
    HcommMemHandle deviceMem = nullptr;
    ChannelHandle channel = 0;

    auto cleanup = [&]() {
        if (channel != 0) {
            (void)HcommChannelDestroy(&channel, 1);
            channel = 0;
        }
        if (deviceMem != nullptr && deviceEndpoint != nullptr) {
            (void)HcommMemUnreg(deviceEndpoint, deviceMem);
            deviceMem = nullptr;
        }
        if (hostMem != nullptr && hostEndpoint != nullptr) {
            (void)HcommMemUnreg(hostEndpoint, hostMem);
            hostMem = nullptr;
        }
        if (deviceEndpoint != nullptr) {
            (void)HcommEndpointDestroy(deviceEndpoint);
            deviceEndpoint = nullptr;
        }
        if (hostEndpoint != nullptr) {
            (void)HcommEndpointDestroy(hostEndpoint);
            hostEndpoint = nullptr;
        }
    };
    auto check = [&](const char *step, const char *expr, HcommResult ret, int line) -> int {
        PrintHcommStep(step, ret);
        if (ret != 0) {
            cleanup();
            return FailHcomm(expr, ret, line);
        }
        return 0;
    };

    const uint64_t start = HostNowNs();
    hret = HcommEndpointCreate(&hostDesc, &hostEndpoint);
    ret = check("host_endpoint_create", "HcommEndpointCreate(hostDesc)", hret, __LINE__);
    if (ret != 0) return ret;
    hret = HcommEndpointCreate(&deviceDesc, &deviceEndpoint);
    ret = check("device_endpoint_create", "HcommEndpointCreate(deviceDesc)", hret, __LINE__);
    if (ret != 0) return ret;

    CommMem hostMemDesc{COMM_MEM_TYPE_HOST, buf.host, buf.dataBytes};
    CommMem deviceMemDesc{COMM_MEM_TYPE_DEVICE, buf.commDst, buf.dataBytes};
    hret = HcommMemReg(hostEndpoint, "host_buf", &hostMemDesc, &hostMem);
    ret = check("host_mem_reg", "HcommMemReg(hostEndpoint, host_buf)", hret, __LINE__);
    if (ret != 0) return ret;
    hret = HcommMemReg(deviceEndpoint, "device_hbm", &deviceMemDesc, &deviceMem);
    ret = check("device_mem_reg", "HcommMemReg(deviceEndpoint, device_hbm)", hret, __LINE__);
    if (ret != 0) return ret;

    if (opt.hcommCreateChannel != 0) {
        HcommChannelDesc channelDesc{};
        hret = HcommChannelDescInit(&channelDesc, 1);
        ret = check("channel_desc_init", "HcommChannelDescInit(channelDesc)", hret, __LINE__);
        if (ret != 0) return ret;
        channelDesc.remoteEndpoint = deviceDesc;
        channelDesc.notifyNum = opt.hcommNotifyNum;
        channelDesc.exchangeAllMems = false;
        channelDesc.memHandles = &hostMem;
        channelDesc.memHandleNum = 1;
        channelDesc.socket = nullptr;
        channelDesc.role = HcommRoleCode(opt.hcommRole);
        channelDesc.port = static_cast<uint16_t>(opt.hcommPort);
        if (protocol == COMM_PROTOCOL_ROCE) {
            channelDesc.roceAttr.queueNum = 1;
            channelDesc.roceAttr.retryCnt = 7;
            channelDesc.roceAttr.retryInterval = 100;
            channelDesc.roceAttr.tc = 0;
            channelDesc.roceAttr.sl = 0;
            channelDesc.roceAttr.qpThreshold = 0;
        } else {
            channelDesc.ubAttr.sqDepth = 0;
        }
        hret = HcommChannelCreate(hostEndpoint, COMM_ENGINE_CPU, &channelDesc, 1, &channel);
        ret = check("channel_create", "HcommChannelCreate(hostEndpoint, COMM_ENGINE_CPU)", hret, __LINE__);
        if (ret != 0) return ret;
    }

    const uint64_t end = HostNowNs();
    result->status = kStatusOk;
    result->commUs = static_cast<double>(end - start) / 1000.0;
    result->commCopies = opt.hcommCreateChannel != 0 ? 1 : 0;
    result->commBytes = 0;
    result->commBwGBps = 0.0;
    cleanup();
    PrintHcommStep("cleanup", 0);
    return 0;
#endif
}


#ifdef ENABLE_HCOMM
constexpr const char *kHcommHostMemTag = "host_buf";
constexpr const char *kHcommDeviceMemTag = "device_hbm";
constexpr const char *kHcommChannelName = "rdma_urma_bench_hcomm";

int BuildHcommEndpoint(const Options &opt, bool isHost, EndpointDesc *desc)
{
    HcommResult hret = EndpointDescInit(desc, 1);
    if (hret != 0) return FailHcomm("EndpointDescInit", hret, __LINE__);

    desc->protocol = HcommProtocolCode(opt.hcommProtocol);
    const std::string &addr = isHost ? opt.hcommHostIp : opt.hcommDeviceIp;
    int ret = FillHcommAddress(desc, addr);
    if (ret != 0) return ret;

    if (isHost) {
        desc->loc.locType = ENDPOINT_LOC_TYPE_HOST;
        desc->loc.host.id = opt.hcommHostId;
    } else {
        const uint32_t devPhyId = opt.hcommDevicePhyId >= 0 ?
            static_cast<uint32_t>(opt.hcommDevicePhyId) : static_cast<uint32_t>(opt.device);
        desc->loc.locType = ENDPOINT_LOC_TYPE_DEVICE;
        desc->loc.device.devPhyId = devPhyId;
        desc->loc.device.superDevId = opt.hcommSuperDevId;
        desc->loc.device.serverIdx = opt.hcommServerIdx;
        desc->loc.device.superPodIdx = opt.hcommSuperPodIdx;
    }
    return 0;
}

int BuildHcommChannelDesc(const Options &opt, const EndpointDesc &remote, HcommSocketRole role,
    HcommChannelDesc *desc)
{
    HcommResult hret = HcommChannelDescInit(desc, 1);
    if (hret != 0) return FailHcomm("HcommChannelDescInit", hret, __LINE__);
    desc->remoteEndpoint = remote;
    desc->notifyNum = opt.hcommNotifyNum == 0 ? 1 : opt.hcommNotifyNum;
    desc->exchangeAllMems = true;
    desc->memHandles = nullptr;
    desc->memHandleNum = 0;
    desc->socket = nullptr;
    desc->role = role;
    desc->port = static_cast<uint16_t>(opt.hcommPort);
    desc->channelName = kHcommChannelName;
    desc->qos = 0;
    if (remote.protocol == COMM_PROTOCOL_ROCE) {
        desc->roceAttr.queueNum = 1;
        desc->roceAttr.retryCnt = 7;
        desc->roceAttr.retryInterval = 100;
        desc->roceAttr.tc = 0;
        desc->roceAttr.sl = 0;
        desc->roceAttr.qpThreshold = 0;
    } else {
        desc->ubAttr.sqDepth = 0xFFFFFFFFU;
    }
    return 0;
}

int CreateHcommThreadAndChannel(const Options &opt, EndpointHandle endpoint, const EndpointDesc &remote,
    HcommSocketRole role, ::CommEngine engine, ThreadHandle *thread, ChannelHandle *channel)
{
    uint32_t notifyNum = opt.hcommNotifyNum == 0 ? 1 : opt.hcommNotifyNum;
    HcommResult hret = HcommThreadAlloc(engine, 1, &notifyNum, thread);
    if (hret != 0) return FailHcomm("HcommThreadAlloc", hret, __LINE__);

    HcommChannelDesc desc{};
    int ret = BuildHcommChannelDesc(opt, remote, role, &desc);
    if (ret != 0) return ret;
    hret = HcommChannelCreate(endpoint, engine, &desc, 1, channel);
    if (hret != 0) return FailHcomm("HcommChannelCreate", hret, __LINE__);
    return 0;
}

int FindHcommRemoteMem(ChannelHandle channel, const char *tag, uint64_t minSize, CommMem *out)
{
    uint32_t memNum = 0;
    CommMem *remoteMems = nullptr;
    char **memInfos = nullptr;
    HcommResult hret = HcommChannelGetRemoteMems(channel, &memNum, &remoteMems, &memInfos);
    if (hret != 0) return FailHcomm("HcommChannelGetRemoteMems", hret, __LINE__);
    for (uint32_t i = 0; i < memNum; ++i) {
        const char *memTag = memInfos == nullptr ? nullptr : memInfos[i];
        if (memTag != nullptr && std::strcmp(memTag, tag) == 0 && remoteMems[i].size >= minSize) {
            *out = remoteMems[i];
            return 0;
        }
    }
    std::cerr << "HCOMM remote mem tag not found: tag=" << tag
              << " min_size=" << minSize << " remote_mem_num=" << memNum << std::endl;
    for (uint32_t i = 0; i < memNum; ++i) {
        const char *memTag = memInfos == nullptr ? nullptr : memInfos[i];
        std::cerr << "  remote_mem[" << i << "] tag=" << (memTag == nullptr ? "<null>" : memTag)
                  << " type=" << static_cast<int>(remoteMems[i].type)
                  << " addr=" << remoteMems[i].addr
                  << " size=" << remoteMems[i].size << std::endl;
    }
    return Fail("HCOMM remote device memory not found", 1, __LINE__);
}

struct HcommP2pSession {
    EndpointDesc hostDesc{};
    EndpointDesc deviceDesc{};
    EndpointHandle hostEndpoint = nullptr;
    EndpointHandle deviceEndpoint = nullptr;
    HcommMemHandle hostMem = nullptr;
    HcommMemHandle deviceMem = nullptr;
    ThreadHandle hostThread = 0;
    ThreadHandle deviceThread = 0;
    ChannelHandle hostChannel = 0;
    ChannelHandle deviceChannel = 0;
    CommMem remoteDeviceMem{};
    uint64_t transferSeq = 0;
    bool initialized = false;

    int Init(const Options &opt, const Buffers &buf)
    {
        int ret = BuildHcommEndpoint(opt, true, &hostDesc);
        if (ret != 0) return ret;
        ret = BuildHcommEndpoint(opt, false, &deviceDesc);
        if (ret != 0) return ret;

        HcommResult hret = HcommEndpointCreate(&hostDesc, &hostEndpoint);
        if (hret != 0) return FailHcomm("HcommEndpointCreate(host)", hret, __LINE__);
        hret = HcommEndpointCreate(&deviceDesc, &deviceEndpoint);
        if (hret != 0) return FailHcomm("HcommEndpointCreate(device)", hret, __LINE__);

        CommMem hostMemDesc{COMM_MEM_TYPE_HOST, buf.host, buf.dataBytes};
        hret = HcommMemReg(hostEndpoint, kHcommHostMemTag, &hostMemDesc, &hostMem);
        if (hret != 0) return FailHcomm("HcommMemReg(host_buf)", hret, __LINE__);

        CommMem deviceMemDesc{COMM_MEM_TYPE_DEVICE, buf.commDst, buf.dataBytes};
        hret = HcommMemReg(deviceEndpoint, kHcommDeviceMemTag, &deviceMemDesc, &deviceMem);
        if (hret != 0) return FailHcomm("HcommMemReg(device_hbm)", hret, __LINE__);

        int serverRet = 0;
        std::thread server([&]() {
            aclError aclRet = aclrtSetDevice(opt.device);
            if (aclRet != ACL_SUCCESS) {
                serverRet = Fail("aclrtSetDevice(server thread)", static_cast<int>(aclRet), __LINE__);
                return;
            }
            serverRet = CreateHcommThreadAndChannel(opt, deviceEndpoint, hostDesc, HCOMM_SOCKET_ROLE_SERVER,
                COMM_ENGINE_AICPU, &deviceThread, &deviceChannel);
        });
        std::this_thread::sleep_for(std::chrono::milliseconds(100));
        ret = CreateHcommThreadAndChannel(opt, hostEndpoint, deviceDesc, HCOMM_SOCKET_ROLE_CLIENT,
            COMM_ENGINE_CPU, &hostThread, &hostChannel);
        server.join();
        if (ret != 0) return ret;
        if (serverRet != 0) return serverRet;

        ret = FindHcommRemoteMem(hostChannel, kHcommDeviceMemTag, buf.dataBytes, &remoteDeviceMem);
        if (ret != 0) return ret;
        initialized = true;
        std::cout << "hcomm_p2p_remote_device_mem addr=" << remoteDeviceMem.addr
                  << " size=" << remoteDeviceMem.size << std::endl;
        return 0;
    }

    int TransferOnce(const Options &opt, const Buffers &buf)
    {
        if (!initialized) return Fail("HCOMM P2P session is not initialized", 1, __LINE__);
        int32_t ret = 0;
        const bool doWrite = IsHcommWriteCommOp(opt.commOpName) ||
            (IsHcommReadWriteCommOp(opt.commOpName) && ((transferSeq & 1ULL) == 0ULL));
        if (doWrite) {
            ret = HcommWriteNbi(hostChannel, remoteDeviceMem.addr, buf.host, buf.dataBytes);
            if (ret != 0) return FailHcomm("HcommWriteNbi", ret, __LINE__);
        } else {
            ret = HcommReadNbi(hostChannel, buf.host, remoteDeviceMem.addr, buf.dataBytes);
            if (ret != 0) return FailHcomm("HcommReadNbi", ret, __LINE__);
        }
        ret = HcommChannelFence(hostChannel);
        if (ret != 0) return FailHcomm("HcommChannelFence", ret, __LINE__);
        ++transferSeq;
        return 0;
    }

    void Finalize()
    {
        if (hostChannel != 0) {
            ChannelHandle channel = hostChannel;
            (void)HcommChannelDestroy(&channel, 1);
            hostChannel = 0;
        }
        if (deviceChannel != 0) {
            ChannelHandle channel = deviceChannel;
            (void)HcommChannelDestroy(&channel, 1);
            deviceChannel = 0;
        }
        if (hostThread != 0) {
            ThreadHandle thread = hostThread;
            (void)HcommThreadFree(&thread, 1);
            hostThread = 0;
        }
        if (deviceThread != 0) {
            ThreadHandle thread = deviceThread;
            (void)HcommThreadFree(&thread, 1);
            deviceThread = 0;
        }
        if (hostMem != nullptr && hostEndpoint != nullptr) {
            (void)HcommMemUnreg(hostEndpoint, hostMem);
            hostMem = nullptr;
        }
        if (deviceMem != nullptr && deviceEndpoint != nullptr) {
            (void)HcommMemUnreg(deviceEndpoint, deviceMem);
            deviceMem = nullptr;
        }
        if (hostEndpoint != nullptr) {
            (void)HcommEndpointDestroy(hostEndpoint);
            hostEndpoint = nullptr;
        }
        if (deviceEndpoint != nullptr) {
            (void)HcommEndpointDestroy(deviceEndpoint);
            deviceEndpoint = nullptr;
        }
        initialized = false;
    }
};
#else
struct HcommP2pSession {};
#endif

int RunHcommP2pBaseline(const Options &opt, const Buffers &buf, HcommP2pSession *session, RunResult *result)
{
#ifndef ENABLE_HCOMM
    (void)opt;
    (void)buf;
    (void)session;
    (void)result;
    return Fail("HCOMM support not enabled. Rebuild with -DENABLE_HCOMM=ON", 1, __LINE__);
#else
    if (session == nullptr || !session->initialized) {
        return Fail("HCOMM P2P session is not initialized", 1, __LINE__);
    }
    const uint64_t start = HostNowNs();
    for (uint32_t i = 0; i < opt.commIters; ++i) {
        int ret = session->TransferOnce(opt, buf);
        if (ret != 0) return ret;
    }
    const uint64_t end = HostNowNs();
    result->status = kStatusOk;
    result->commUs = static_cast<double>(end - start) / 1000.0;
    result->commCopies = opt.commIters;
    result->commBytes = buf.dataBytes * static_cast<uint64_t>(opt.commIters);
    result->commBwGBps = BytesToGBps(result->commBytes, result->commUs);
    return 0;
#endif
}

void LaunchHbmKernel(const Options &opt, const Buffers &buf, aclrtStream stream)
{
    const HbmBenchTiling tiling{
        buf.elements,
        opt.tile,
        opt.repeat,
        HbmOpCode(opt.hbmOpName),
        opt.blocks,
    };
    aiv_hbm_bandwidth<<<opt.blocks, nullptr, stream>>>(
        reinterpret_cast<uint8_t *>(buf.src), reinterpret_cast<uint8_t *>(buf.dst), tiling);
}

int RunHbmBaseline(const Options &opt, const Buffers &buf, aclrtStream stream, RunResult *result)
{
    CHECK_ACL(aclrtSynchronizeStream(stream));
    const uint64_t start = HostNowNs();
    LaunchHbmKernel(opt, buf, stream);
    CHECK_ACL(aclrtSynchronizeStream(stream));
    const uint64_t end = HostNowNs();
    result->status = kStatusOk;
    result->hbmUs = static_cast<double>(end - start) / 1000.0;
    result->hbmBwGBps = BytesToGBps(HbmBytesPerRun(opt, buf), result->hbmUs);
    return 0;
}

int RunAclWriteBaseline(const Options &opt, const Buffers &buf, aclrtStream stream, RunResult *result)
{
    CHECK_ACL(aclrtSynchronizeStream(stream));
    const uint64_t start = HostNowNs();
    for (uint32_t i = 0; i < opt.commIters; ++i) {
        CHECK_ACL(aclrtMemcpyAsync(buf.commDst, buf.dataBytes, buf.host, buf.dataBytes,
            ACL_MEMCPY_HOST_TO_DEVICE, stream));
        CHECK_ACL(aclrtSynchronizeStream(stream));
    }
    const uint64_t end = HostNowNs();
    result->status = kStatusOk;
    result->commUs = static_cast<double>(end - start) / 1000.0;
    result->commCopies = opt.commIters;
    result->commBytes = buf.dataBytes * static_cast<uint64_t>(opt.commIters);
    result->commBwGBps = BytesToGBps(result->commBytes, result->commUs);
    return 0;
}

int RunHixlBaseline(const Options &opt, const Buffers &buf, HixlSession *session, RunResult *result)
{
#ifndef ENABLE_HIXL
    (void)opt;
    (void)buf;
    (void)session;
    (void)result;
    return Fail("HIXL support not enabled. Rebuild with -DENABLE_HIXL=ON", 1, __LINE__);
#else
    if (session == nullptr || !session->initialized) {
        return Fail("HIXL session is not initialized", 1, __LINE__);
    }
    const uint64_t start = HostNowNs();
    for (uint32_t i = 0; i < opt.commIters; ++i) {
        int ret = session->TransferOnce(opt, buf);
        if (ret != 0) return ret;
    }
    const uint64_t end = HostNowNs();
    result->status = kStatusOk;
    result->commUs = static_cast<double>(end - start) / 1000.0;
    result->commCopies = opt.commIters;
    result->commBytes = buf.dataBytes * static_cast<uint64_t>(opt.commIters);
    result->commBwGBps = BytesToGBps(result->commBytes, result->commUs);
    return 0;
#endif
}

int RunCommBaseline(const Options &opt, const Buffers &buf, aclrtStream stream,
    HixlSession *hixlSession, HcommP2pSession *hcommSession, RunResult *result)
{
    if (opt.commOpName == "acl_write_hbm") {
        return RunAclWriteBaseline(opt, buf, stream, result);
    }
    if (IsHcommCommOp(opt.commOpName)) {
        return RunHcommP2pBaseline(opt, buf, hcommSession, result);
    }
    return RunHixlBaseline(opt, buf, hixlSession, result);
}

struct CopyWorkerResult {
    uint32_t status = kStatusOk;
    int ret = 0;
    uint64_t copies = 0;
    uint64_t bytes = 0;
    double us = 0.0;
};

void CopyWorker(const Options &opt, const Buffers &buf, aclrtContext ctx, aclrtStream stream,
    std::atomic<bool> *start, std::atomic<bool> *stop, CopyWorkerResult *result)
{
    aclError ret = aclrtSetCurrentContext(ctx);
    if (ret != ACL_SUCCESS) {
        result->status = kStatusAclError;
        result->ret = static_cast<int>(ret);
        return;
    }
    while (!start->load(std::memory_order_acquire)) {
        std::this_thread::yield();
    }
    const uint64_t begin = HostNowNs();
    while (!stop->load(std::memory_order_acquire)) {
        ret = aclrtMemcpyAsync(buf.commDst, buf.dataBytes, buf.host, buf.dataBytes,
            ACL_MEMCPY_HOST_TO_DEVICE, stream);
        if (ret != ACL_SUCCESS) {
            result->status = kStatusAclError;
            result->ret = static_cast<int>(ret);
            break;
        }
        ret = aclrtSynchronizeStream(stream);
        if (ret != ACL_SUCCESS) {
            result->status = kStatusAclError;
            result->ret = static_cast<int>(ret);
            break;
        }
        ++result->copies;
        result->bytes += buf.dataBytes;
    }
    const uint64_t end = HostNowNs();
    result->us = static_cast<double>(end - begin) / 1000.0;
}

void HcommWorker(const Options &opt, const Buffers &buf, HcommP2pSession *session,
    std::atomic<bool> *start, std::atomic<bool> *stop, CopyWorkerResult *result)
{
#ifndef ENABLE_HCOMM
    (void)opt;
    (void)buf;
    (void)session;
    (void)start;
    (void)stop;
    result->status = kStatusParamInvalid;
    result->ret = 1;
#else
    if (session == nullptr || !session->initialized) {
        result->status = kStatusParamInvalid;
        result->ret = 1;
        return;
    }
    while (!start->load(std::memory_order_acquire)) {
        std::this_thread::yield();
    }
    const uint64_t begin = HostNowNs();
    while (!stop->load(std::memory_order_acquire)) {
        int ret = session->TransferOnce(opt, buf);
        if (ret != 0) {
            result->status = kStatusAclError;
            result->ret = ret;
            break;
        }
        ++result->copies;
        result->bytes += buf.dataBytes;
    }
    const uint64_t end = HostNowNs();
    result->us = static_cast<double>(end - begin) / 1000.0;
#endif
}

void HixlWorker(const Options &opt, const Buffers &buf, HixlSession *session, aclrtContext ctx,
    std::atomic<bool> *start, std::atomic<bool> *stop, CopyWorkerResult *result)
{
#ifndef ENABLE_HIXL
    (void)opt;
    (void)buf;
    (void)session;
    (void)ctx;
    (void)start;
    (void)stop;
    result->status = kStatusParamInvalid;
    result->ret = 1;
#else
    aclError aclRet = aclrtSetCurrentContext(ctx);
    if (aclRet != ACL_SUCCESS) {
        result->status = kStatusAclError;
        result->ret = static_cast<int>(aclRet);
        return;
    }
    if (session == nullptr || !session->initialized) {
        result->status = kStatusParamInvalid;
        result->ret = 1;
        return;
    }
    while (!start->load(std::memory_order_acquire)) {
        std::this_thread::yield();
    }
    const uint64_t begin = HostNowNs();
    while (!stop->load(std::memory_order_acquire)) {
        int ret = session->TransferOnce(opt, buf);
        if (ret != 0) {
            result->status = kStatusAclError;
            result->ret = ret;
            break;
        }
        ++result->copies;
        result->bytes += buf.dataBytes;
    }
    const uint64_t end = HostNowNs();
    result->us = static_cast<double>(end - begin) / 1000.0;
#endif
}

int RunAclInterference(const Options &opt, const Buffers &buf, aclrtStream hbmStream,
    aclrtStream commStream, RunResult *result)
{
    CHECK_ACL(aclrtSynchronizeStream(hbmStream));
    CHECK_ACL(aclrtSynchronizeStream(commStream));

    aclrtContext ctx = nullptr;
    CHECK_ACL(aclrtGetCurrentContext(&ctx));

    std::atomic<bool> start{false};
    std::atomic<bool> stop{false};
    CopyWorkerResult copyResult;
    std::thread worker(CopyWorker, std::cref(opt), std::cref(buf), ctx, commStream,
        &start, &stop, &copyResult);

    const uint64_t hbmStart = HostNowNs();
    start.store(true, std::memory_order_release);
    LaunchHbmKernel(opt, buf, hbmStream);
    aclError syncRet = aclrtSynchronizeStream(hbmStream);
    const uint64_t hbmEnd = HostNowNs();
    stop.store(true, std::memory_order_release);
    worker.join();
    if (syncRet != ACL_SUCCESS) {
        return Fail("aclrtSynchronizeStream(hbmStream)", static_cast<int>(syncRet), __LINE__);
    }
    if (copyResult.status != kStatusOk) {
        return Fail("CopyWorker", copyResult.ret, __LINE__);
    }

    result->status = kStatusOk;
    result->hbmUs = static_cast<double>(hbmEnd - hbmStart) / 1000.0;
    result->hbmBwGBps = BytesToGBps(HbmBytesPerRun(opt, buf), result->hbmUs);
    result->commUs = copyResult.us;
    result->commCopies = copyResult.copies;
    result->commBytes = copyResult.bytes;
    result->commBwGBps = BytesToGBps(result->commBytes, result->commUs);
    return 0;
}

int RunHcommInterference(const Options &opt, const Buffers &buf, aclrtStream hbmStream,
    HcommP2pSession *hcommSession, RunResult *result)
{
    CHECK_ACL(aclrtSynchronizeStream(hbmStream));

    std::atomic<bool> start{false};
    std::atomic<bool> stop{false};
    CopyWorkerResult copyResult;
    std::thread worker(HcommWorker, std::cref(opt), std::cref(buf), hcommSession,
        &start, &stop, &copyResult);

    const uint64_t hbmStart = HostNowNs();
    start.store(true, std::memory_order_release);
    LaunchHbmKernel(opt, buf, hbmStream);
    aclError syncRet = aclrtSynchronizeStream(hbmStream);
    const uint64_t hbmEnd = HostNowNs();
    stop.store(true, std::memory_order_release);
    worker.join();
    if (syncRet != ACL_SUCCESS) {
        return Fail("aclrtSynchronizeStream(hbmStream)", static_cast<int>(syncRet), __LINE__);
    }
    if (copyResult.status != kStatusOk) {
        return Fail("HcommWorker", copyResult.ret, __LINE__);
    }

    result->status = kStatusOk;
    result->hbmUs = static_cast<double>(hbmEnd - hbmStart) / 1000.0;
    result->hbmBwGBps = BytesToGBps(HbmBytesPerRun(opt, buf), result->hbmUs);
    result->commUs = copyResult.us;
    result->commCopies = copyResult.copies;
    result->commBytes = copyResult.bytes;
    result->commBwGBps = BytesToGBps(result->commBytes, result->commUs);
    return 0;
}

int RunHixlInterference(const Options &opt, const Buffers &buf, aclrtStream hbmStream,
    HixlSession *hixlSession, RunResult *result)
{
    CHECK_ACL(aclrtSynchronizeStream(hbmStream));

    aclrtContext ctx = nullptr;
    CHECK_ACL(aclrtGetCurrentContext(&ctx));

    std::atomic<bool> start{false};
    std::atomic<bool> stop{false};
    CopyWorkerResult copyResult;
    std::thread worker(HixlWorker, std::cref(opt), std::cref(buf), hixlSession, ctx,
        &start, &stop, &copyResult);

    const uint64_t hbmStart = HostNowNs();
    start.store(true, std::memory_order_release);
    LaunchHbmKernel(opt, buf, hbmStream);
    aclError syncRet = aclrtSynchronizeStream(hbmStream);
    const uint64_t hbmEnd = HostNowNs();
    stop.store(true, std::memory_order_release);
    worker.join();
    if (syncRet != ACL_SUCCESS) {
        return Fail("aclrtSynchronizeStream(hbmStream)", static_cast<int>(syncRet), __LINE__);
    }
    if (copyResult.status != kStatusOk) {
        return Fail("HixlWorker", copyResult.ret, __LINE__);
    }

    result->status = kStatusOk;
    result->hbmUs = static_cast<double>(hbmEnd - hbmStart) / 1000.0;
    result->hbmBwGBps = BytesToGBps(HbmBytesPerRun(opt, buf), result->hbmUs);
    result->commUs = copyResult.us;
    result->commCopies = copyResult.copies;
    result->commBytes = copyResult.bytes;
    result->commBwGBps = BytesToGBps(result->commBytes, result->commUs);
    return 0;
}

int RunInterference(const Options &opt, const Buffers &buf, aclrtStream hbmStream,
    aclrtStream commStream, HixlSession *hixlSession, HcommP2pSession *hcommSession, RunResult *result)
{
    if (opt.commOpName == "acl_write_hbm") {
        return RunAclInterference(opt, buf, hbmStream, commStream, result);
    }
    if (IsHcommCommOp(opt.commOpName)) {
        return RunHcommInterference(opt, buf, hbmStream, hcommSession, result);
    }
    return RunHixlInterference(opt, buf, hbmStream, hixlSession, result);
}

void PrintConfig(const Options &opt, const Buffers &buf)
{
    std::cout << "config:"
              << " device=" << opt.device
              << " mode=" << opt.mode
              << " hbm_op=" << opt.hbmOpName
              << " comm_op=" << opt.commOpName
              << " bytes=" << buf.dataBytes
              << " elements=" << buf.elements
              << " tile=" << opt.tile
              << " repeat=" << opt.repeat
              << " blocks=" << opt.blocks
              << " comm_iters=" << opt.commIters
              << " warmup=" << opt.warmup
              << " iters=" << opt.iters;
    if (opt.mode == "hcomm_smoke" || IsHcommCommOp(opt.commOpName)) {
        std::cout << " hcomm_protocol=" << opt.hcommProtocol
                  << " hcomm_host_ip=" << opt.hcommHostIp
                  << " hcomm_device_ip=" << opt.hcommDeviceIp
                  << " hcomm_device_phy_id=" << opt.hcommDevicePhyId
                  << " hcomm_host_id=" << opt.hcommHostId
                  << " hcomm_create_channel=" << opt.hcommCreateChannel
                  << " hcomm_role=" << opt.hcommRole
                  << " hcomm_port=" << opt.hcommPort
                  << " hcomm_notify_num=" << opt.hcommNotifyNum;
    }
    if (IsHixlCommOp(opt.commOpName)) {
        std::cout << " hixl_local_engine=" << opt.hixlLocalEngine
                  << " hixl_server_engine=" << opt.hixlServerEngine
                  << " hixl_protocols=" << opt.hixlProtocols
                  << " hixl_timeout_ms=" << opt.hixlTimeoutMs;
        if (IsHixlPeerCommOp(opt.commOpName)) {
            std::cout << " hixl_peer_device=" << opt.hixlPeerDevice;
        }
        if (IsHixlHostCommOp(opt.commOpName)) {
            std::cout << " hixl_host_roce_ip=" << (opt.hixlHostRoceIp.empty() ? "unset" : opt.hixlHostRoceIp)
                      << " hixl_net_instance_id=" << opt.hixlNetInstanceId;
        }
        if (!opt.hixlLocalCommRes.empty()) {
            std::cout << " hixl_local_comm_res=set";
        }
        if (!opt.hixlSourceLocalCommRes.empty()) {
            std::cout << " hixl_source_local_comm_res=set";
        }
        if (!opt.hixlTargetLocalCommRes.empty()) {
            std::cout << " hixl_target_local_comm_res=set";
        }
        if (!opt.hixlBufferPool.empty()) {
            std::cout << " hixl_buffer_pool=" << opt.hixlBufferPool;
        }
    }
    std::cout << std::endl;
}

void PrintRun(const Options &opt, const RunResult &result)
{
    std::cout << opt.mode
              << " status=" << result.status
              << " hbm_us=" << std::fixed << std::setprecision(2) << result.hbmUs
              << " hbm_bw_GBps=" << result.hbmBwGBps
              << " comm_us=" << result.commUs
              << " comm_bw_GBps=" << result.commBwGBps
              << " comm_copies=" << result.commCopies
              << " comm_bytes=" << result.commBytes
              << std::endl;
}
} // namespace

int32_t main(int32_t argc, char **argv)
{
    Options opt;
    if (!ParseOptions(argc, argv, &opt)) {
        Usage(argv[0]);
        return 1;
    }

    CHECK_ACL(aclInit(nullptr));
    CHECK_ACL(aclrtSetDevice(opt.device));

    aclrtStream hbmStream = nullptr;
    aclrtStream commStream = nullptr;
    CHECK_ACL(aclrtCreateStream(&hbmStream));
    CHECK_ACL(aclrtCreateStream(&commStream));

    Buffers buf;
    int ret = InitBuffers(opt, &buf);
    if (ret != 0) return ret;
    PrintConfig(opt, buf);

    HixlSession hixlSession;
    HcommP2pSession hcommSession;
    if (opt.mode == "hcomm_smoke") {
        RunResult result;
        ret = RunHcommSmoke(opt, buf, &result);
        if (ret == 0) {
            PrintRun(opt, result);
        }
        FreeBuffers(&buf);
        if (commStream != nullptr) (void)aclrtDestroyStream(commStream);
        if (hbmStream != nullptr) (void)aclrtDestroyStream(hbmStream);
        (void)aclrtResetDevice(opt.device);
        (void)aclFinalize();
        return ret;
    }

    if (NeedComm(opt) && IsHixlCommOp(opt.commOpName)) {
#ifdef ENABLE_HIXL
        ret = hixlSession.Init(opt, buf);
        if (ret != 0) {
            hixlSession.Finalize(opt);
            FreeBuffers(&buf);
            if (commStream != nullptr) (void)aclrtDestroyStream(commStream);
            if (hbmStream != nullptr) (void)aclrtDestroyStream(hbmStream);
            (void)aclrtResetDevice(opt.device);
            (void)aclFinalize();
            return ret;
        }
#else
        std::cerr << "HIXL comm op requested, but this binary was built without ENABLE_HIXL." << std::endl;
        FreeBuffers(&buf);
        if (commStream != nullptr) (void)aclrtDestroyStream(commStream);
        if (hbmStream != nullptr) (void)aclrtDestroyStream(hbmStream);
        (void)aclrtResetDevice(opt.device);
        (void)aclFinalize();
        return 1;
#endif
    }

    if (NeedComm(opt) && IsHcommCommOp(opt.commOpName)) {
#ifdef ENABLE_HCOMM
        ret = hcommSession.Init(opt, buf);
        if (ret != 0) {
            hcommSession.Finalize();
#ifdef ENABLE_HIXL
            hixlSession.Finalize(opt);
#endif
            FreeBuffers(&buf);
            if (commStream != nullptr) (void)aclrtDestroyStream(commStream);
            if (hbmStream != nullptr) (void)aclrtDestroyStream(hbmStream);
            (void)aclrtResetDevice(opt.device);
            (void)aclFinalize();
            return ret;
        }
#else
        std::cerr << "HCOMM comm op requested, but this binary was built without ENABLE_HCOMM." << std::endl;
#ifdef ENABLE_HIXL
        hixlSession.Finalize(opt);
#endif
        FreeBuffers(&buf);
        if (commStream != nullptr) (void)aclrtDestroyStream(commStream);
        if (hbmStream != nullptr) (void)aclrtDestroyStream(hbmStream);
        (void)aclrtResetDevice(opt.device);
        (void)aclFinalize();
        return 1;
#endif
    }

    std::vector<double> hbmBws;
    std::vector<double> commBws;
    RunResult last;
    const uint32_t totalLoops = opt.warmup + opt.iters;
    for (uint32_t loop = 0; loop < totalLoops; ++loop) {
        RunResult result;
        if (opt.mode == "hbm_baseline") {
            ret = RunHbmBaseline(opt, buf, hbmStream, &result);
        } else if (opt.mode == "comm_baseline") {
            ret = RunCommBaseline(opt, buf, commStream, &hixlSession, &hcommSession, &result);
        } else {
            ret = RunInterference(opt, buf, hbmStream, commStream, &hixlSession, &hcommSession, &result);
        }
        if (ret != 0) {
#ifdef ENABLE_HCOMM
            hcommSession.Finalize();
#endif
#ifdef ENABLE_HIXL
            hixlSession.Finalize(opt);
#endif
            FreeBuffers(&buf);
            if (commStream != nullptr) (void)aclrtDestroyStream(commStream);
            if (hbmStream != nullptr) (void)aclrtDestroyStream(hbmStream);
            (void)aclrtResetDevice(opt.device);
            (void)aclFinalize();
            return ret;
        }
        if (loop >= opt.warmup) {
            std::cout << "iter=" << (loop - opt.warmup) << std::endl;
            PrintRun(opt, result);
            hbmBws.push_back(result.hbmBwGBps);
            commBws.push_back(result.commBwGBps);
            last = result;
        }
    }

    std::cout << "summary:"
              << " hbm_bw_avg_GBps=" << Average(hbmBws)
              << " comm_bw_avg_GBps=" << Average(commBws)
              << std::endl;
    std::cout << "last_";
    PrintRun(opt, last);

#ifdef ENABLE_HCOMM
    hcommSession.Finalize();
#endif
#ifdef ENABLE_HIXL
    hixlSession.Finalize(opt);
#endif
    FreeBuffers(&buf);
    if (commStream != nullptr) (void)aclrtDestroyStream(commStream);
    if (hbmStream != nullptr) (void)aclrtDestroyStream(hbmStream);
    (void)aclrtResetDevice(opt.device);
    (void)aclFinalize();
    return 0;
}
