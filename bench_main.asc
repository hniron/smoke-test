#ifndef GM_ADDR
#define GM_ADDR __gm__ uint8_t *
#endif

using namespace AscendC;

constexpr int32_t kBufferNum = 2;
constexpr uint32_t kDefaultTasks = 4;
constexpr uint32_t kDefaultElements = 262144;
constexpr uint32_t kDefaultTile = 1024;
constexpr uint32_t kDefaultRepeat = 1;
constexpr uint32_t kDefaultIters = 5;
constexpr uint32_t kDefaultWarmup = 1;
constexpr uint64_t kDefaultTimeoutMs = 5000;
constexpr uint64_t kDefaultReadStrideWords = 1;

struct AivBenchTiling {
    uint32_t taskCount;
    uint32_t elementsPerTask;
    uint32_t tileLength;
    uint32_t repeat;
};

template<HardEvent event>
__aicore__ inline void LocalSync()
{
    int32_t eventId = static_cast<int32_t>(GetTPipePtr()->FetchEventID(event));
    SetFlag<event>(eventId);
    WaitFlag<event>(eventId);
}

class KernelStageAdd {
public:
    __aicore__ inline KernelStageAdd() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, GM_ADDR flags, AivBenchTiling tiling)
    {
        InitData(x, y, z, tiling);
        flagGm_.SetGlobalBuffer((__gm__ int32_t *)flags, taskCount_ * kFlagPadCount);
        pipe_.InitBuffer(flagQueue_, 1, kFlagPadCount * sizeof(int32_t));
    }

    __aicore__ inline void InitNoFlag(GM_ADDR x, GM_ADDR y, GM_ADDR z, AivBenchTiling tiling)
    {
        InitData(x, y, z, tiling);
    }

    __aicore__ inline void Process()
    {
        for (uint32_t task = 0; task < taskCount_; ++task) {
            RunStage(task);
            SetStageFlag(task);
        }
    }

    __aicore__ inline void ProcessOne(uint32_t task)
    {
        RunStage(task);
        SetStageFlag(task);
    }

    __aicore__ inline void ProcessOneNoFlag(uint32_t task)
    {
        RunStage(task);
    }

private:
    __aicore__ inline void InitData(GM_ADDR x, GM_ADDR y, GM_ADDR z, AivBenchTiling tiling)
    {
        taskCount_ = tiling.taskCount;
        elementsPerTask_ = tiling.elementsPerTask;
        tileLength_ = tiling.tileLength;
        repeat_ = tiling.repeat;
        xGm_.SetGlobalBuffer((__gm__ float *)x, taskCount_ * elementsPerTask_);
        yGm_.SetGlobalBuffer((__gm__ float *)y, taskCount_ * elementsPerTask_);
        zGm_.SetGlobalBuffer((__gm__ float *)z, taskCount_ * elementsPerTask_);
        pipe_.InitBuffer(inQueueX_, kBufferNum, tileLength_ * sizeof(float));
        pipe_.InitBuffer(inQueueY_, kBufferNum, tileLength_ * sizeof(float));
        pipe_.InitBuffer(outQueueZ_, kBufferNum, tileLength_ * sizeof(float));
    }

    __aicore__ inline void CopyIn(uint32_t base)
    {
        LocalTensor<float> xLocal = inQueueX_.AllocTensor<float>();
        LocalTensor<float> yLocal = inQueueY_.AllocTensor<float>();
        DataCopy(xLocal, xGm_[base], tileLength_);
        DataCopy(yLocal, yGm_[base], tileLength_);
        inQueueX_.EnQue(xLocal);
        inQueueY_.EnQue(yLocal);
    }

    __aicore__ inline void Compute()
    {
        LocalTensor<float> xLocal = inQueueX_.DeQue<float>();
        LocalTensor<float> yLocal = inQueueY_.DeQue<float>();
        LocalTensor<float> zLocal = outQueueZ_.AllocTensor<float>();
        Add(zLocal, xLocal, yLocal, tileLength_);
        outQueueZ_.EnQue<float>(zLocal);
        inQueueX_.FreeTensor(xLocal);
        inQueueY_.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t base)
    {
        LocalTensor<float> zLocal = outQueueZ_.DeQue<float>();
        DataCopy(zGm_[base], zLocal, tileLength_);
        outQueueZ_.FreeTensor(zLocal);
    }

    __aicore__ inline void RunStage(uint32_t task)
    {
        const uint32_t stageBase = task * elementsPerTask_;
        for (uint32_t r = 0; r < repeat_; ++r) {
            for (uint32_t offset = 0; offset < elementsPerTask_; offset += tileLength_) {
                const uint32_t base = stageBase + offset;
                CopyIn(base);
                Compute();
                CopyOut(base);
            }
        }
        PipeBarrier<PIPE_ALL>();
    }

    __aicore__ inline void SetStageFlag(uint32_t task)
    {
        LocalTensor<int32_t> local = flagQueue_.AllocTensor<int32_t>();
        Duplicate<int32_t>(local, 0, kFlagPadCount);
        local.SetValue(0, static_cast<int32_t>(task + 1U));
        LocalSync<HardEvent::S_MTE3>();
        DataCopy(flagGm_[task * kFlagPadCount], local, kFlagPadCount);
        flagQueue_.FreeTensor(local);
        PipeBarrier<PIPE_ALL>();
    }

private:
    TPipe pipe_;
    TQue<TPosition::VECIN, kBufferNum> inQueueX_;
    TQue<TPosition::VECIN, kBufferNum> inQueueY_;
    TQue<TPosition::VECOUT, kBufferNum> outQueueZ_;
    TQue<TPosition::VECOUT, 1> flagQueue_;
    GlobalTensor<float> xGm_;
    GlobalTensor<float> yGm_;
    GlobalTensor<float> zGm_;
    GlobalTensor<int32_t> flagGm_;
    uint32_t taskCount_;
    uint32_t elementsPerTask_;
    uint32_t tileLength_;
    uint32_t repeat_;
};

extern "C" __global__ __aicore__ void aiv_multi_stage_add(GM_ADDR x, GM_ADDR y, GM_ADDR z, GM_ADDR flags,
    AivBenchTiling tiling)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    KernelStageAdd op;
    op.Init(x, y, z, flags, tiling);
    op.Process();
}

extern "C" __global__ __aicore__ void aiv_one_stage_add(GM_ADDR x, GM_ADDR y, GM_ADDR z, GM_ADDR flags,
    uint32_t taskIndex, AivBenchTiling tiling)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    KernelStageAdd op;
    op.Init(x, y, z, flags, tiling);
    op.ProcessOne(taskIndex);
}

extern "C" __global__ __aicore__ void aiv_one_stage_add_no_flag(GM_ADDR x, GM_ADDR y, GM_ADDR z,
    uint32_t taskIndex, AivBenchTiling tiling)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    KernelStageAdd op;
    op.InitNoFlag(x, y, z, tiling);
    op.ProcessOneNoFlag(taskIndex);
}

extern "C" __global__ __aicore__ void aiv_snoop()
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    PipeBarrier<PIPE_ALL>();
}

namespace {
struct Options {
    int32_t device = 0;
    uint32_t tasks = kDefaultTasks;
    uint32_t elements = kDefaultElements;
    uint32_t tile = kDefaultTile;
    uint32_t repeat = kDefaultRepeat;
    uint32_t iters = kDefaultIters;
    uint32_t warmup = kDefaultWarmup;
    uint64_t timeoutMs = kDefaultTimeoutMs;
    uint64_t readStride = kDefaultReadStrideWords;
    std::string aicpuJson = "./libaiv_aicpu_poll_kernel.json";
    std::string mode = "all";
};


struct DeviceBuffers {
    void *x = nullptr;
    void *y = nullptr;
    void *z = nullptr;
    void *flags = nullptr;
    void *seenNs = nullptr;
    void *pollIters = nullptr;
    void *status = nullptr;
    void *config = nullptr;
    size_t dataBytes = 0;
    size_t flagsBytes = 0;
    size_t timeBytes = 0;
    size_t configBytes = 0;
};

struct RunResult {
    double hostTotalUs = 0.0;
    std::vector<uint64_t> seenNs;
    std::vector<uint64_t> pollIters;
    uint32_t status = 0;
};

uint64_t HostNowNs()
{
    return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
        std::chrono::steady_clock::now().time_since_epoch()).count());
}

int Fail(const char *expr, int ret, int line)
{
    std::cerr << "FAIL line " << line << ": " << expr << " ret=" << ret << std::endl;
    const char *recent = aclGetRecentErrMsg();
    if (recent != nullptr && recent[0] != '\0') {
        std::cerr << "ACL recent error: " << recent << std::endl;
    }
    return ret == 0 ? 1 : ret;
}

#define CHECK_ACL(expr) do { aclError _ret = (expr); if (_ret != ACL_SUCCESS) return Fail(#expr, static_cast<int>(_ret), __LINE__); } while (0)

aclError LogAclDeviceCount()
{
    uint32_t count = 0;
    aclError ret = aclrtGetDeviceCount(&count);
    std::cerr << "aclrtGetDeviceCount ret=" << static_cast<int>(ret);
    if (ret == ACL_SUCCESS) {
        std::cerr << " count=" << count;
    }
    std::cerr << std::endl;
    return ret;
}

bool ParseU32(const char *arg, const char *name, uint32_t *out)
{
    const size_t n = std::strlen(name);
    if (std::strncmp(arg, name, n) != 0 || arg[n] != '=') {
        return false;
    }
    *out = static_cast<uint32_t>(std::strtoul(arg + n + 1, nullptr, 0));
    return true;
}

bool ParseU64(const char *arg, const char *name, uint64_t *out)
{
    const size_t n = std::strlen(name);
    if (std::strncmp(arg, name, n) != 0 || arg[n] != '=') {
        return false;
    }
    *out = std::strtoull(arg + n + 1, nullptr, 0);
    return true;
}

bool ParseI32(const char *arg, const char *name, int32_t *out)
{
    const size_t n = std::strlen(name);
    if (std::strncmp(arg, name, n) != 0 || arg[n] != '=') {
        return false;
    }
    *out = static_cast<int32_t>(std::strtol(arg + n + 1, nullptr, 0));
    return true;
}

bool ParseStr(const char *arg, const char *name, std::string *out)
{
    const size_t n = std::strlen(name);
    if (std::strncmp(arg, name, n) != 0 || arg[n] != '=') {
        return false;
    }
    *out = arg + n + 1;
    return true;
}

void Usage(const char *prog)
{
    std::cerr
        << "usage: " << prog << " [--device=0] [--tasks=4] [--elements=262144]\n"
        << "       [--tile=1024] [--repeat=1] [--iters=5] [--warmup=1]\n"
        << "       [--timeout-ms=5000] [--read-stride=1]\n"
        << "       [--mode=all|shared|event_sync_pure|event_sync_with_flag_check|aicpu_noop|aiv_snoop|aicpu_read_bench|aicpu_read_chase]\n"
        << "       [--aicpu-json=legacy_ignored_for_cust_aicpu]\n"
        << "       CUST AICPU modes require ASCEND_CUSTOM_OPP_PATH to point at build/custom_opp/vendors/cust.\n";
}

bool ParseOptions(int argc, char **argv, Options *opt)
{
    for (int i = 1; i < argc; ++i) {
        if (ParseI32(argv[i], "--device", &opt->device) ||
            ParseU32(argv[i], "--tasks", &opt->tasks) ||
            ParseU32(argv[i], "--elements", &opt->elements) ||
            ParseU32(argv[i], "--tile", &opt->tile) ||
            ParseU32(argv[i], "--repeat", &opt->repeat) ||
            ParseU32(argv[i], "--iters", &opt->iters) ||
            ParseU32(argv[i], "--warmup", &opt->warmup) ||
            ParseU64(argv[i], "--timeout-ms", &opt->timeoutMs) ||
            ParseU64(argv[i], "--read-stride", &opt->readStride) ||
            ParseStr(argv[i], "--aicpu-json", &opt->aicpuJson) ||
            ParseStr(argv[i], "--mode", &opt->mode)) {
            continue;
        }
        return false;
    }
    const bool validMode = opt->mode == "all" || opt->mode == "shared" ||
        opt->mode == "event_sync_pure" || opt->mode == "event_sync_with_flag_check" ||
        opt->mode == "aicpu_noop" || opt->mode == "aiv_snoop" || opt->mode == "aiv_noop" ||
        opt->mode == "aicpu_read_bench" || opt->mode == "aicpu_read_chase";
    if (!validMode) {
        return false;
    }
    if (opt->mode == "aicpu_read_bench" || opt->mode == "aicpu_read_chase") {
        const uint64_t dataWords = static_cast<uint64_t>(opt->tasks) * static_cast<uint64_t>(opt->elements);
        return opt->tasks > 0 && opt->elements > 0 && opt->repeat > 0 && opt->iters > 0 &&
            opt->readStride > 0 && dataWords <= 0xffffffffULL;
    }
    return opt->tasks > 0 && opt->elements > 0 && opt->tile > 0 && opt->repeat > 0 &&
        opt->iters > 0 && opt->readStride > 0 && (opt->elements % opt->tile == 0);
}

bool NeedShared(const Options &opt)
{
    return opt.mode == "all" || opt.mode == "shared";
}

bool NeedEventSyncPure(const Options &opt)
{
    return opt.mode == "all" || opt.mode == "event_sync_pure";
}

bool NeedEventSyncWithFlagCheck(const Options &opt)
{
    return opt.mode == "all" || opt.mode == "event_sync_with_flag_check";
}

bool NeedAicpuNoop(const Options &opt)
{
    return opt.mode == "aicpu_noop";
}

bool NeedAivSnoop(const Options &opt)
{
    return opt.mode == "aiv_snoop" || opt.mode == "aiv_noop";
}

bool NeedAicpuReadBench(const Options &opt)
{
    return opt.mode == "aicpu_read_bench";
}

bool NeedAicpuReadChase(const Options &opt)
{
    return opt.mode == "aicpu_read_chase";
}

bool NeedAicpuReadOnly(const Options &opt)
{
    return NeedAicpuReadBench(opt) || NeedAicpuReadChase(opt);
}

bool NeedAicpuKernels(const Options &opt)
{
    return NeedShared(opt) || NeedEventSyncPure(opt) || NeedEventSyncWithFlagCheck(opt) ||
        NeedAicpuNoop(opt) || NeedAicpuReadOnly(opt);
}

bool CustomOppPathConfigured()
{
    const char *path = std::getenv("ASCEND_CUSTOM_OPP_PATH");
    return path != nullptr && path[0] != '\0';
}

void DestroyTensorResources(aclTensorDesc **descs, size_t descCount, aclDataBuffer **buffers, size_t bufferCount)
{
    for (size_t i = 0; i < bufferCount; ++i) {
        if (buffers[i] != nullptr) {
            (void)aclDestroyDataBuffer(buffers[i]);
        }
    }
    for (size_t i = 0; i < descCount; ++i) {
        if (descs[i] != nullptr) {
            (void)aclDestroyTensorDesc(descs[i]);
        }
    }
}

void *ConfigPtr(const DeviceBuffers &buf, size_t int64Offset)
{
    return static_cast<void *>(static_cast<uint8_t *>(buf.config) + int64Offset * sizeof(int64_t));
}

int CopyConfig(const DeviceBuffers &buf, size_t int64Offset, const int64_t *values, size_t count)
{
    CHECK_ACL(aclrtMemcpy(ConfigPtr(buf, int64Offset), count * sizeof(int64_t), values,
        count * sizeof(int64_t), ACL_MEMCPY_HOST_TO_DEVICE));
    return 0;
}

int ExecuteCustomAicpu(const char *opName, uint32_t inputCount, aclTensorDesc **inputDescs,
    aclDataBuffer **inputBuffers, uint32_t outputCount, aclTensorDesc **outputDescs,
    aclDataBuffer **outputBuffers, aclTensorDesc **allDescs, size_t descCount,
    aclDataBuffer **allBuffers, size_t bufferCount, aclrtStream stream)
{
    for (size_t i = 0; i < descCount; ++i) {
        if (allDescs[i] == nullptr) {
            DestroyTensorResources(allDescs, descCount, allBuffers, bufferCount);
            return Fail("aclCreateTensorDesc(custom aicpu)", 1, __LINE__);
        }
    }
    for (size_t i = 0; i < bufferCount; ++i) {
        if (allBuffers[i] == nullptr) {
            DestroyTensorResources(allDescs, descCount, allBuffers, bufferCount);
            return Fail("aclCreateDataBuffer(custom aicpu)", 1, __LINE__);
        }
    }

    aclopAttr *attr = aclopCreateAttr();
    if (attr == nullptr) {
        DestroyTensorResources(allDescs, descCount, allBuffers, bufferCount);
        return Fail("aclopCreateAttr(custom aicpu)", 1, __LINE__);
    }
    aclError ret = aclopCompileAndExecute(opName, inputCount, inputDescs, inputBuffers,
        outputCount, outputDescs, outputBuffers, attr, ACL_ENGINE_SYS, ACL_COMPILE_SYS, nullptr, stream);
    (void)aclopDestroyAttr(attr);
    DestroyTensorResources(allDescs, descCount, allBuffers, bufferCount);
    if (ret != ACL_SUCCESS) {
        std::cerr << "custom_aicpu_op=" << opName << std::endl;
        return Fail("aclopCompileAndExecute(custom aicpu)", static_cast<int>(ret), __LINE__);
    }
    return 0;
}

int LaunchAicpuNoop(const DeviceBuffers &buf, aclrtStream stream)
{
    const int64_t configValues[] = {0};
    int ret = CopyConfig(buf, 0, configValues, 1);
    if (ret != 0) return ret;

    int64_t configDims[] = {1};
    int64_t statusDims[] = {1};
    aclTensorDesc *inputDescs[] = {aclCreateTensorDesc(ACL_INT64, 1, configDims, ACL_FORMAT_ND)};
    aclTensorDesc *outputDescs[] = {aclCreateTensorDesc(ACL_INT32, 1, statusDims, ACL_FORMAT_ND)};
    aclDataBuffer *inputBuffers[] = {aclCreateDataBuffer(ConfigPtr(buf, 0), sizeof(int64_t))};
    aclDataBuffer *outputBuffers[] = {aclCreateDataBuffer(buf.status, sizeof(uint32_t))};
    aclTensorDesc *allDescs[] = {inputDescs[0], outputDescs[0]};
    aclDataBuffer *allBuffers[] = {inputBuffers[0], outputBuffers[0]};
    return ExecuteCustomAicpu(kAicpuNoopOpName, 1, inputDescs, inputBuffers, 1, outputDescs, outputBuffers,
        allDescs, 2, allBuffers, 2, stream);
}

int LaunchAicpuPollFlags(const Options &opt, const DeviceBuffers &buf, aclrtStream stream)
{
    const int64_t configValues[] = {static_cast<int64_t>(opt.tasks), static_cast<int64_t>(kFlagPadCount),
        static_cast<int64_t>(opt.timeoutMs * 1000000ULL)};
    int ret = CopyConfig(buf, 0, configValues, 3);
    if (ret != 0) return ret;

    int64_t flagDims[] = {static_cast<int64_t>(opt.tasks), static_cast<int64_t>(kFlagPadCount)};
    int64_t configDims[] = {3};
    int64_t vectorDims[] = {static_cast<int64_t>(opt.tasks)};
    int64_t statusDims[] = {1};
    aclTensorDesc *inputDescs[] = {
        aclCreateTensorDesc(ACL_INT32, 2, flagDims, ACL_FORMAT_ND),
        aclCreateTensorDesc(ACL_INT64, 1, configDims, ACL_FORMAT_ND),
    };
    aclTensorDesc *outputDescs[] = {
        aclCreateTensorDesc(ACL_INT64, 1, vectorDims, ACL_FORMAT_ND),
        aclCreateTensorDesc(ACL_INT64, 1, vectorDims, ACL_FORMAT_ND),
        aclCreateTensorDesc(ACL_INT32, 1, statusDims, ACL_FORMAT_ND),
    };
    aclDataBuffer *inputBuffers[] = {
        aclCreateDataBuffer(buf.flags, buf.flagsBytes),
        aclCreateDataBuffer(ConfigPtr(buf, 0), 3 * sizeof(int64_t)),
    };
    aclDataBuffer *outputBuffers[] = {
        aclCreateDataBuffer(buf.seenNs, buf.timeBytes),
        aclCreateDataBuffer(buf.pollIters, buf.timeBytes),
        aclCreateDataBuffer(buf.status, sizeof(uint32_t)),
    };
    aclTensorDesc *allDescs[] = {inputDescs[0], inputDescs[1], outputDescs[0], outputDescs[1], outputDescs[2]};
    aclDataBuffer *allBuffers[] = {inputBuffers[0], inputBuffers[1], outputBuffers[0], outputBuffers[1],
        outputBuffers[2]};
    return ExecuteCustomAicpu(kAicpuPollFlagsOpName, 2, inputDescs, inputBuffers, 3, outputDescs, outputBuffers,
        allDescs, 5, allBuffers, 5, stream);
}

int LaunchAicpuStampOnly(const Options &opt, const DeviceBuffers &buf, uint32_t taskIndex, aclrtStream stream)
{
    const size_t configOffset = static_cast<size_t>(taskIndex) * 2U;
    const int64_t configValues[] = {static_cast<int64_t>(taskIndex)};
    int ret = CopyConfig(buf, configOffset, configValues, 1);
    if (ret != 0) return ret;

    int64_t flagDims[] = {static_cast<int64_t>(opt.tasks), static_cast<int64_t>(kFlagPadCount)};
    int64_t configDims[] = {1};
    int64_t vectorDims[] = {static_cast<int64_t>(opt.tasks)};
    int64_t statusDims[] = {1};
    aclTensorDesc *inputDescs[] = {
        aclCreateTensorDesc(ACL_INT32, 2, flagDims, ACL_FORMAT_ND),
        aclCreateTensorDesc(ACL_INT64, 1, configDims, ACL_FORMAT_ND),
    };
    aclTensorDesc *outputDescs[] = {
        aclCreateTensorDesc(ACL_INT64, 1, vectorDims, ACL_FORMAT_ND),
        aclCreateTensorDesc(ACL_INT32, 1, statusDims, ACL_FORMAT_ND),
    };
    aclDataBuffer *inputBuffers[] = {
        aclCreateDataBuffer(buf.flags, buf.flagsBytes),
        aclCreateDataBuffer(ConfigPtr(buf, configOffset), sizeof(int64_t)),
    };
    aclDataBuffer *outputBuffers[] = {
        aclCreateDataBuffer(buf.seenNs, buf.timeBytes),
        aclCreateDataBuffer(buf.status, sizeof(uint32_t)),
    };
    aclTensorDesc *allDescs[] = {inputDescs[0], inputDescs[1], outputDescs[0], outputDescs[1]};
    aclDataBuffer *allBuffers[] = {inputBuffers[0], inputBuffers[1], outputBuffers[0], outputBuffers[1]};
    return ExecuteCustomAicpu(kAicpuStampOnlyOpName, 2, inputDescs, inputBuffers, 2, outputDescs, outputBuffers,
        allDescs, 4, allBuffers, 4, stream);
}

int LaunchAicpuStampFlag(const Options &opt, const DeviceBuffers &buf, uint32_t taskIndex, aclrtStream stream)
{
    const size_t configOffset = static_cast<size_t>(taskIndex) * 2U;
    const int64_t configValues[] = {static_cast<int64_t>(taskIndex), static_cast<int64_t>(kFlagPadCount)};
    int ret = CopyConfig(buf, configOffset, configValues, 2);
    if (ret != 0) return ret;

    int64_t flagDims[] = {static_cast<int64_t>(opt.tasks), static_cast<int64_t>(kFlagPadCount)};
    int64_t configDims[] = {2};
    int64_t vectorDims[] = {static_cast<int64_t>(opt.tasks)};
    int64_t statusDims[] = {1};
    aclTensorDesc *inputDescs[] = {
        aclCreateTensorDesc(ACL_INT32, 2, flagDims, ACL_FORMAT_ND),
        aclCreateTensorDesc(ACL_INT64, 1, configDims, ACL_FORMAT_ND),
    };
    aclTensorDesc *outputDescs[] = {
        aclCreateTensorDesc(ACL_INT64, 1, vectorDims, ACL_FORMAT_ND),
        aclCreateTensorDesc(ACL_INT32, 1, statusDims, ACL_FORMAT_ND),
    };
    aclDataBuffer *inputBuffers[] = {
        aclCreateDataBuffer(buf.flags, buf.flagsBytes),
        aclCreateDataBuffer(ConfigPtr(buf, configOffset), 2 * sizeof(int64_t)),
    };
    aclDataBuffer *outputBuffers[] = {
        aclCreateDataBuffer(buf.seenNs, buf.timeBytes),
        aclCreateDataBuffer(buf.status, sizeof(uint32_t)),
    };
    aclTensorDesc *allDescs[] = {inputDescs[0], inputDescs[1], outputDescs[0], outputDescs[1]};
    aclDataBuffer *allBuffers[] = {inputBuffers[0], inputBuffers[1], outputBuffers[0], outputBuffers[1]};
    return ExecuteCustomAicpu(kAicpuStampFlagOpName, 2, inputDescs, inputBuffers, 2, outputDescs, outputBuffers,
        allDescs, 4, allBuffers, 4, stream);
}

int LaunchAicpuReadBench(const Options &opt, const DeviceBuffers &buf, aclrtStream stream)
{
    const uint64_t dataWords = static_cast<uint64_t>(opt.tasks) * static_cast<uint64_t>(opt.elements);
    const int64_t configValues[] = {static_cast<int64_t>(dataWords), static_cast<int64_t>(dataWords),
        static_cast<int64_t>(opt.repeat), static_cast<int64_t>(opt.readStride)};
    int ret = CopyConfig(buf, 0, configValues, 4);
    if (ret != 0) return ret;

    int64_t dataDims[] = {static_cast<int64_t>(dataWords)};
    int64_t configDims[] = {4};
    int64_t scalarDims[] = {1};
    aclTensorDesc *inputDescs[] = {
        aclCreateTensorDesc(ACL_INT32, 1, dataDims, ACL_FORMAT_ND),
        aclCreateTensorDesc(ACL_INT64, 1, configDims, ACL_FORMAT_ND),
    };
    aclTensorDesc *outputDescs[] = {
        aclCreateTensorDesc(ACL_INT64, 1, scalarDims, ACL_FORMAT_ND),
        aclCreateTensorDesc(ACL_INT64, 1, scalarDims, ACL_FORMAT_ND),
        aclCreateTensorDesc(ACL_INT32, 1, scalarDims, ACL_FORMAT_ND),
    };
    aclDataBuffer *inputBuffers[] = {
        aclCreateDataBuffer(buf.x, buf.dataBytes),
        aclCreateDataBuffer(ConfigPtr(buf, 0), 4 * sizeof(int64_t)),
    };
    aclDataBuffer *outputBuffers[] = {
        aclCreateDataBuffer(buf.seenNs, sizeof(uint64_t)),
        aclCreateDataBuffer(buf.pollIters, sizeof(uint64_t)),
        aclCreateDataBuffer(buf.status, sizeof(uint32_t)),
    };
    aclTensorDesc *allDescs[] = {inputDescs[0], inputDescs[1], outputDescs[0], outputDescs[1], outputDescs[2]};
    aclDataBuffer *allBuffers[] = {inputBuffers[0], inputBuffers[1], outputBuffers[0], outputBuffers[1],
        outputBuffers[2]};
    return ExecuteCustomAicpu(kAicpuReadBenchOpName, 2, inputDescs, inputBuffers, 3, outputDescs, outputBuffers,
        allDescs, 5, allBuffers, 5, stream);
}

int LaunchAicpuReadChase(const Options &opt, const DeviceBuffers &buf, aclrtStream stream)
{
    const uint64_t dataWords = static_cast<uint64_t>(opt.tasks) * static_cast<uint64_t>(opt.elements);
    const int64_t configValues[] = {static_cast<int64_t>(dataWords),
        static_cast<int64_t>(dataWords * static_cast<uint64_t>(opt.repeat)), 0};
    int ret = CopyConfig(buf, 0, configValues, 3);
    if (ret != 0) return ret;

    int64_t dataDims[] = {static_cast<int64_t>(dataWords)};
    int64_t configDims[] = {3};
    int64_t scalarDims[] = {1};
    aclTensorDesc *inputDescs[] = {
        aclCreateTensorDesc(ACL_INT32, 1, dataDims, ACL_FORMAT_ND),
        aclCreateTensorDesc(ACL_INT64, 1, configDims, ACL_FORMAT_ND),
    };
    aclTensorDesc *outputDescs[] = {
        aclCreateTensorDesc(ACL_INT64, 1, scalarDims, ACL_FORMAT_ND),
        aclCreateTensorDesc(ACL_INT64, 1, scalarDims, ACL_FORMAT_ND),
        aclCreateTensorDesc(ACL_INT32, 1, scalarDims, ACL_FORMAT_ND),
    };
    aclDataBuffer *inputBuffers[] = {
        aclCreateDataBuffer(buf.x, buf.dataBytes),
        aclCreateDataBuffer(ConfigPtr(buf, 0), 3 * sizeof(int64_t)),
    };
    aclDataBuffer *outputBuffers[] = {
        aclCreateDataBuffer(buf.seenNs, sizeof(uint64_t)),
        aclCreateDataBuffer(buf.pollIters, sizeof(uint64_t)),
        aclCreateDataBuffer(buf.status, sizeof(uint32_t)),
    };
    aclTensorDesc *allDescs[] = {inputDescs[0], inputDescs[1], outputDescs[0], outputDescs[1], outputDescs[2]};
    aclDataBuffer *allBuffers[] = {inputBuffers[0], inputBuffers[1], outputBuffers[0], outputBuffers[1],
        outputBuffers[2]};
    return ExecuteCustomAicpu(kAicpuReadChaseOpName, 2, inputDescs, inputBuffers, 3, outputDescs, outputBuffers,
        allDescs, 5, allBuffers, 5, stream);
}

int InitBuffers(const Options &opt, DeviceBuffers *buf)
{
    const uint64_t totalElements = static_cast<uint64_t>(opt.tasks) * opt.elements;
    buf->dataBytes = totalElements * sizeof(float);
    buf->flagsBytes = static_cast<size_t>(opt.tasks) * kFlagPadCount * sizeof(uint32_t);
    buf->timeBytes = static_cast<size_t>(opt.tasks) * sizeof(uint64_t);
    const size_t configWords = std::max<size_t>(4, static_cast<size_t>(opt.tasks) * 2U);
    buf->configBytes = configWords * sizeof(int64_t);
    const bool readOnly = NeedAicpuReadOnly(opt);

    CHECK_ACL(aclrtMalloc(&buf->x, buf->dataBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    if (!readOnly) {
        CHECK_ACL(aclrtMalloc(&buf->y, buf->dataBytes, ACL_MEM_MALLOC_HUGE_FIRST));
        CHECK_ACL(aclrtMalloc(&buf->z, buf->dataBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    }
    CHECK_ACL(aclrtMalloc(&buf->flags, buf->flagsBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc(&buf->seenNs, buf->timeBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc(&buf->pollIters, buf->timeBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc(&buf->status, sizeof(uint32_t), ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc(&buf->config, buf->configBytes, ACL_MEM_MALLOC_HUGE_FIRST));

    if (NeedAicpuReadChase(opt)) {
        const size_t dataWords = static_cast<size_t>(totalElements);
        std::vector<uint32_t> order(dataWords);
        for (size_t i = 0; i < dataWords; ++i) {
            order[i] = static_cast<uint32_t>(i);
        }
        uint64_t seed = 0x9e3779b97f4a7c15ULL ^ totalElements;
        for (size_t i = dataWords - 1; i > 0; --i) {
            seed ^= seed << 13U;
            seed ^= seed >> 7U;
            seed ^= seed << 17U;
            const size_t j = static_cast<size_t>(seed % static_cast<uint64_t>(i + 1));
            const uint32_t tmp = order[i];
            order[i] = order[j];
            order[j] = tmp;
        }
        std::vector<uint32_t> chain(dataWords);
        for (size_t i = 0; i < dataWords; ++i) {
            chain[order[i]] = order[(i + 1) % dataWords];
        }
        CHECK_ACL(aclrtMemcpy(buf->x, buf->dataBytes, chain.data(), buf->dataBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    } else {
        std::vector<float> host(totalElements, 1.0f);
        CHECK_ACL(aclrtMemcpy(buf->x, buf->dataBytes, host.data(), buf->dataBytes, ACL_MEMCPY_HOST_TO_DEVICE));
        if (!readOnly) {
            CHECK_ACL(aclrtMemcpy(buf->y, buf->dataBytes, host.data(), buf->dataBytes, ACL_MEMCPY_HOST_TO_DEVICE));
        }
    }
    return 0;
}

void FreeBuffers(DeviceBuffers *buf)
{
    if (buf->x != nullptr) (void)aclrtFree(buf->x);
    if (buf->y != nullptr) (void)aclrtFree(buf->y);
    if (buf->z != nullptr) (void)aclrtFree(buf->z);
    if (buf->flags != nullptr) (void)aclrtFree(buf->flags);
    if (buf->seenNs != nullptr) (void)aclrtFree(buf->seenNs);
    if (buf->pollIters != nullptr) (void)aclrtFree(buf->pollIters);
    if (buf->status != nullptr) (void)aclrtFree(buf->status);
    if (buf->config != nullptr) (void)aclrtFree(buf->config);
}

int ResetResultBuffers(const DeviceBuffers &buf)
{
    CHECK_ACL(aclrtMemset(buf.flags, buf.flagsBytes, 0, buf.flagsBytes));
    CHECK_ACL(aclrtMemset(buf.seenNs, buf.timeBytes, 0, buf.timeBytes));
    CHECK_ACL(aclrtMemset(buf.pollIters, buf.timeBytes, 0, buf.timeBytes));
    CHECK_ACL(aclrtMemset(buf.status, sizeof(uint32_t), 0, sizeof(uint32_t)));
    return 0;
}

int CopyResult(const Options &opt, const DeviceBuffers &buf, double hostUs, RunResult *result)
{
    result->hostTotalUs = hostUs;
    result->seenNs.assign(opt.tasks, 0);
    result->pollIters.assign(opt.tasks, 0);
    CHECK_ACL(aclrtMemcpy(result->seenNs.data(), buf.timeBytes, buf.seenNs, buf.timeBytes, ACL_MEMCPY_DEVICE_TO_HOST));
    CHECK_ACL(aclrtMemcpy(result->pollIters.data(), buf.timeBytes, buf.pollIters, buf.timeBytes, ACL_MEMCPY_DEVICE_TO_HOST));
    CHECK_ACL(aclrtMemcpy(&result->status, sizeof(uint32_t), buf.status, sizeof(uint32_t), ACL_MEMCPY_DEVICE_TO_HOST));
    return 0;
}

int RunAicpuNoop(const DeviceBuffers &buf, aclrtStream aivStream, aclrtStream aicpuStream, double *hostUs)
{
    CHECK_ACL(aclrtSynchronizeStream(aivStream));
    CHECK_ACL(aclrtSynchronizeStream(aicpuStream));
    CHECK_ACL(aclrtMemset(buf.status, sizeof(uint32_t), 0, sizeof(uint32_t)));

    const uint64_t start = HostNowNs();
    int ret = LaunchAicpuNoop(buf, aicpuStream);
    if (ret != 0) return ret;
    CHECK_ACL(aclrtSynchronizeStream(aicpuStream));
    const uint64_t end = HostNowNs();
    *hostUs = static_cast<double>(end - start) / 1000.0;
    return 0;
}

int RunAivSnoop(aclrtStream aivStream, double *hostUs)
{
    CHECK_ACL(aclrtSynchronizeStream(aivStream));

    const uint64_t start = HostNowNs();
    aiv_snoop<<<1, nullptr, aivStream>>>();
    CHECK_ACL(aclrtSynchronizeStream(aivStream));
    const uint64_t end = HostNowNs();
    *hostUs = static_cast<double>(end - start) / 1000.0;
    return 0;
}

int RunAicpuReadBench(const Options &opt, const DeviceBuffers &buf,
    aclrtStream aivStream, aclrtStream aicpuStream, RunResult *result)
{
    CHECK_ACL(aclrtSynchronizeStream(aivStream));
    CHECK_ACL(aclrtSynchronizeStream(aicpuStream));
    int ret = ResetResultBuffers(buf);
    if (ret != 0) return ret;

    const uint64_t start = HostNowNs();
    ret = LaunchAicpuReadBench(opt, buf, aicpuStream);
    if (ret != 0) return ret;
    CHECK_ACL(aclrtSynchronizeStream(aicpuStream));
    const uint64_t end = HostNowNs();
    return CopyResult(opt, buf, static_cast<double>(end - start) / 1000.0, result);
}

int RunAicpuReadChase(const Options &opt, const DeviceBuffers &buf,
    aclrtStream aivStream, aclrtStream aicpuStream, RunResult *result)
{
    CHECK_ACL(aclrtSynchronizeStream(aivStream));
    CHECK_ACL(aclrtSynchronizeStream(aicpuStream));
    int ret = ResetResultBuffers(buf);
    if (ret != 0) return ret;

    const uint64_t start = HostNowNs();
    ret = LaunchAicpuReadChase(opt, buf, aicpuStream);
    if (ret != 0) return ret;
    CHECK_ACL(aclrtSynchronizeStream(aicpuStream));
    const uint64_t end = HostNowNs();
    return CopyResult(opt, buf, static_cast<double>(end - start) / 1000.0, result);
}

int RunShared(const Options &opt, const DeviceBuffers &buf, aclrtStream aivStream,
    aclrtStream aicpuStream, RunResult *result)
{
    CHECK_ACL(aclrtSynchronizeStream(aivStream));
    CHECK_ACL(aclrtSynchronizeStream(aicpuStream));
    CHECK_ACL(aclrtMemset(buf.z, buf.dataBytes, 0, buf.dataBytes));
    int ret = ResetResultBuffers(buf);
    if (ret != 0) return ret;

    const AivBenchTiling tiling{opt.tasks, opt.elements, opt.tile, opt.repeat};
    const uint64_t start = HostNowNs();
    ret = LaunchAicpuPollFlags(opt, buf, aicpuStream);
    if (ret != 0) return ret;
    aiv_multi_stage_add<<<1, nullptr, aivStream>>>(reinterpret_cast<uint8_t *>(buf.x), reinterpret_cast<uint8_t *>(buf.y), reinterpret_cast<uint8_t *>(buf.z), reinterpret_cast<uint8_t *>(buf.flags), tiling);
    CHECK_ACL(aclrtSynchronizeStream(aivStream));
    CHECK_ACL(aclrtSynchronizeStream(aicpuStream));
    const uint64_t end = HostNowNs();
    return CopyResult(opt, buf, static_cast<double>(end - start) / 1000.0, result);
}

int RunEventSyncPure(const Options &opt, const DeviceBuffers &buf, aclrtStream aivStream,
    aclrtStream aicpuStream, const std::vector<aclrtEvent> &events, RunResult *result)
{
    CHECK_ACL(aclrtSynchronizeStream(aivStream));
    CHECK_ACL(aclrtSynchronizeStream(aicpuStream));
    CHECK_ACL(aclrtMemset(buf.z, buf.dataBytes, 0, buf.dataBytes));
    int ret = ResetResultBuffers(buf);
    if (ret != 0) return ret;

    const AivBenchTiling tiling{opt.tasks, opt.elements, opt.tile, opt.repeat};
    const uint64_t start = HostNowNs();
    for (uint32_t i = 0; i < opt.tasks; ++i) {
        aiv_one_stage_add_no_flag<<<1, nullptr, aivStream>>>(reinterpret_cast<uint8_t *>(buf.x),
            reinterpret_cast<uint8_t *>(buf.y), reinterpret_cast<uint8_t *>(buf.z), i, tiling);
        CHECK_ACL(aclrtRecordEvent(events[i], aivStream));
        CHECK_ACL(aclrtStreamWaitEvent(aicpuStream, events[i]));
        ret = LaunchAicpuStampOnly(opt, buf, i, aicpuStream);
        if (ret != 0) return ret;
    }
    CHECK_ACL(aclrtSynchronizeStream(aivStream));
    CHECK_ACL(aclrtSynchronizeStream(aicpuStream));
    const uint64_t end = HostNowNs();
    return CopyResult(opt, buf, static_cast<double>(end - start) / 1000.0, result);
}

int RunEventSyncWithFlagCheck(const Options &opt, const DeviceBuffers &buf,
    aclrtStream aivStream, aclrtStream aicpuStream, const std::vector<aclrtEvent> &events, RunResult *result)
{
    CHECK_ACL(aclrtSynchronizeStream(aivStream));
    CHECK_ACL(aclrtSynchronizeStream(aicpuStream));
    CHECK_ACL(aclrtMemset(buf.z, buf.dataBytes, 0, buf.dataBytes));
    int ret = ResetResultBuffers(buf);
    if (ret != 0) return ret;

    const AivBenchTiling tiling{opt.tasks, opt.elements, opt.tile, opt.repeat};
    const uint64_t start = HostNowNs();
    for (uint32_t i = 0; i < opt.tasks; ++i) {
        aiv_one_stage_add<<<1, nullptr, aivStream>>>(reinterpret_cast<uint8_t *>(buf.x),
            reinterpret_cast<uint8_t *>(buf.y), reinterpret_cast<uint8_t *>(buf.z),
            reinterpret_cast<uint8_t *>(buf.flags), i, tiling);
        CHECK_ACL(aclrtRecordEvent(events[i], aivStream));
        CHECK_ACL(aclrtStreamWaitEvent(aicpuStream, events[i]));
        ret = LaunchAicpuStampFlag(opt, buf, i, aicpuStream);
        if (ret != 0) return ret;
    }
    CHECK_ACL(aclrtSynchronizeStream(aivStream));
    CHECK_ACL(aclrtSynchronizeStream(aicpuStream));
    const uint64_t end = HostNowNs();
    return CopyResult(opt, buf, static_cast<double>(end - start) / 1000.0, result);
}

double Average(const std::vector<double> &values)
{
    if (values.empty()) {
        return 0.0;
    }
    return std::accumulate(values.begin(), values.end(), 0.0) / static_cast<double>(values.size());
}

std::vector<double> SeenIntervalsUs(const RunResult &result)
{
    std::vector<double> intervals;
    for (size_t i = 1; i < result.seenNs.size(); ++i) {
        if (result.seenNs[i] != 0 && result.seenNs[i - 1] != 0 && result.seenNs[i] >= result.seenNs[i - 1]) {
            intervals.push_back(static_cast<double>(result.seenNs[i] - result.seenNs[i - 1]) / 1000.0);
        }
    }
    return intervals;
}

void PrintRun(const char *name, const Options &opt, const RunResult &result)
{
    const auto intervals = SeenIntervalsUs(result);
    std::cout << name
              << " status=" << result.status
              << " host_total_us=" << std::fixed << std::setprecision(2) << result.hostTotalUs
              << " host_per_task_us=" << (result.hostTotalUs / static_cast<double>(opt.tasks))
              << " aicpu_seen_interval_avg_us=" << Average(intervals)
              << std::endl;
}

void PrintReadBenchRun(const char *name, const Options &opt, const RunResult &result)
{
    const uint64_t dataWords = static_cast<uint64_t>(opt.tasks) * static_cast<uint64_t>(opt.elements);
    const uint64_t totalReads = dataWords * static_cast<uint64_t>(opt.repeat);
    const uint64_t elapsedNs = result.seenNs.empty() ? 0 : result.seenNs[0];
    const uint64_t checksum = result.pollIters.empty() ? 0 : result.pollIters[0];
    const double elapsedUs = static_cast<double>(elapsedNs) / 1000.0;
    const double nsPerRead = totalReads == 0 ? 0.0 : static_cast<double>(elapsedNs) / static_cast<double>(totalReads);
    std::cout << name
              << " status=" << result.status
              << " host_total_us=" << std::fixed << std::setprecision(2) << result.hostTotalUs
              << " aicpu_elapsed_us=" << elapsedUs
              << " ns_per_read=" << nsPerRead
              << " read_count=" << totalReads
              << " data_words=" << dataWords
              << " read_stride_words=" << opt.readStride
              << " checksum=" << checksum
              << std::endl;
}

void PrintReadChaseRun(const char *name, const Options &opt, const RunResult &result)
{
    const uint64_t dataWords = static_cast<uint64_t>(opt.tasks) * static_cast<uint64_t>(opt.elements);
    const uint64_t steps = dataWords * static_cast<uint64_t>(opt.repeat);
    const uint64_t elapsedNs = result.seenNs.empty() ? 0 : result.seenNs[0];
    const uint64_t checksum = result.pollIters.empty() ? 0 : result.pollIters[0];
    const double elapsedUs = static_cast<double>(elapsedNs) / 1000.0;
    const double nsPerRead = steps == 0 ? 0.0 : static_cast<double>(elapsedNs) / static_cast<double>(steps);
    std::cout << name
              << " status=" << result.status
              << " host_total_us=" << std::fixed << std::setprecision(2) << result.hostTotalUs
              << " aicpu_elapsed_us=" << elapsedUs
              << " ns_per_chase_read=" << nsPerRead
              << " chase_steps=" << steps
              << " data_words=" << dataWords
              << " checksum=" << checksum
              << std::endl;
}
} // namespace

int32_t main(int32_t argc, char **argv)
{
    Options opt;
    if (!ParseOptions(argc, argv, &opt)) {
        Usage(argv[0]);
        return 1;
    }

    std::cout << "config:"
              << " device=" << opt.device
              << " tasks=" << opt.tasks
              << " elements=" << opt.elements
              << " tile=" << opt.tile
              << " repeat=" << opt.repeat
              << " iters=" << opt.iters
              << " warmup=" << opt.warmup
              << " timeout_ms=" << opt.timeoutMs
              << " read_stride=" << opt.readStride
              << " mode=" << opt.mode
              << " aicpu_json=" << opt.aicpuJson
              << std::endl;

    CHECK_ACL(aclInit(nullptr));
    CHECK_ACL(LogAclDeviceCount());
    CHECK_ACL(aclrtSetDevice(opt.device));

    const bool runAivSnoop = NeedAivSnoop(opt);
    const bool runShared = NeedShared(opt);
    const bool runPureSync = NeedEventSyncPure(opt);
    const bool runFlagCheckSync = NeedEventSyncWithFlagCheck(opt);
    const bool runAicpuNoop = NeedAicpuNoop(opt);
    const bool runAicpuReadBench = NeedAicpuReadBench(opt);
    const bool runAicpuReadChase = NeedAicpuReadChase(opt);
    const bool needAicpuKernels = NeedAicpuKernels(opt);
    if (needAicpuKernels && !CustomOppPathConfigured()) {
        std::cerr << "FAIL: CUST AICPU modes require ASCEND_CUSTOM_OPP_PATH to point at "
                  << "build/custom_opp/vendors/cust before launching the benchmark." << std::endl;
        return 1;
    }

    aclrtStream aivStream = nullptr;
    aclrtStream aicpuStream = nullptr;
    CHECK_ACL(aclrtCreateStream(&aivStream));
    if (needAicpuKernels) {
        CHECK_ACL(aclrtCreateStream(&aicpuStream));
    }

    int ret = 0;

    DeviceBuffers buf;
    if (!runAivSnoop) {
        ret = InitBuffers(opt, &buf);
        if (ret != 0) return ret;
    }

    std::vector<aclrtEvent> events;
    if (!runAivSnoop) {
        events.assign(opt.tasks, nullptr);
        for (uint32_t i = 0; i < opt.tasks; ++i) {
            CHECK_ACL(aclrtCreateEvent(&events[i]));
        }
    }

    std::vector<double> aivSnoopUs;
    std::vector<double> sharedUs;
    std::vector<double> pureSyncUs;
    std::vector<double> flagCheckSyncUs;
    std::vector<double> noopUs;
    std::vector<double> readBenchUs;
    std::vector<double> readChaseUs;
    RunResult lastShared;
    RunResult lastPureSync;
    RunResult lastFlagCheckSync;
    RunResult lastReadBench;
    RunResult lastReadChase;
    const uint32_t totalLoops = opt.warmup + opt.iters;
    for (uint32_t loop = 0; loop < totalLoops; ++loop) {
        RunResult shared;
        RunResult pureSync;
        RunResult flagCheckSync;
        RunResult readBench;
        RunResult readChase;
        double aivSnoop = 0.0;
        double noop = 0.0;
        if (runAivSnoop) {
            ret = RunAivSnoop(aivStream, &aivSnoop);
            if (ret != 0) return ret;
        }
        if (runAicpuNoop) {
            ret = RunAicpuNoop(buf, aivStream, aicpuStream, &noop);
            if (ret != 0) return ret;
        }
        if (runAicpuReadBench) {
            ret = RunAicpuReadBench(opt, buf, aivStream, aicpuStream, &readBench);
            if (ret != 0) return ret;
        }
        if (runAicpuReadChase) {
            ret = RunAicpuReadChase(opt, buf, aivStream, aicpuStream, &readChase);
            if (ret != 0) return ret;
        }
        if (runShared) {
            ret = RunShared(opt, buf, aivStream, aicpuStream, &shared);
            if (ret != 0) return ret;
        }
        if (runPureSync) {
            ret = RunEventSyncPure(opt, buf, aivStream, aicpuStream, events, &pureSync);
            if (ret != 0) return ret;
        }
        if (runFlagCheckSync) {
            ret = RunEventSyncWithFlagCheck(opt, buf, aivStream, aicpuStream, events, &flagCheckSync);
            if (ret != 0) return ret;
        }
        if (loop >= opt.warmup) {
            std::cout << "iter=" << (loop - opt.warmup) << std::endl;
            if (runAivSnoop) {
                aivSnoopUs.push_back(aivSnoop);
                std::cout << "aiv_snoop status=0 host_total_us=" << std::fixed << std::setprecision(2) << aivSnoop
                          << " host_per_launch_us=" << aivSnoop << std::endl;
            }
            if (runAicpuNoop) {
                noopUs.push_back(noop);
                std::cout << "aicpu_noop status=0 host_total_us=" << std::fixed << std::setprecision(2) << noop
                          << " host_per_task_us=" << noop
                          << " aicpu_seen_interval_avg_us=0" << std::endl;
            }
            if (runAicpuReadBench) {
                readBenchUs.push_back(readBench.hostTotalUs);
                lastReadBench = readBench;
                PrintReadBenchRun("aicpu_read_bench", opt, readBench);
            }
            if (runAicpuReadChase) {
                readChaseUs.push_back(readChase.hostTotalUs);
                lastReadChase = readChase;
                PrintReadChaseRun("aicpu_read_chase", opt, readChase);
            }
            if (runShared) {
                sharedUs.push_back(shared.hostTotalUs);
                lastShared = shared;
                PrintRun("shared", opt, shared);
            }
            if (runPureSync) {
                pureSyncUs.push_back(pureSync.hostTotalUs);
                lastPureSync = pureSync;
                PrintRun("event_sync_pure", opt, pureSync);
            }
            if (runFlagCheckSync) {
                flagCheckSyncUs.push_back(flagCheckSync.hostTotalUs);
                lastFlagCheckSync = flagCheckSync;
                PrintRun("event_sync_with_flag_check", opt, flagCheckSync);
            }
        }
    }

    const double aivSnoopAvg = Average(aivSnoopUs);
    const double sharedAvg = Average(sharedUs);
    const double pureSyncAvg = Average(pureSyncUs);
    const double flagCheckSyncAvg = Average(flagCheckSyncUs);
    const double noopAvg = Average(noopUs);
    const double readBenchAvg = Average(readBenchUs);
    const double readChaseAvg = Average(readChaseUs);
    std::cout << "summary:";
    if (runAivSnoop) {
        std::cout << " aiv_snoop_avg_us=" << aivSnoopAvg;
    }
    if (runAicpuNoop) {
        std::cout << " aicpu_noop_avg_us=" << noopAvg;
    }
    if (runAicpuReadBench) {
        std::cout << " aicpu_read_bench_host_avg_us=" << readBenchAvg;
    }
    if (runAicpuReadChase) {
        std::cout << " aicpu_read_chase_host_avg_us=" << readChaseAvg;
    }
    if (runShared) {
        std::cout << " shared_avg_us=" << sharedAvg;
    }
    if (runPureSync) {
        std::cout << " event_sync_pure_avg_us=" << pureSyncAvg;
    }
    if (runFlagCheckSync) {
        std::cout << " event_sync_with_flag_check_avg_us=" << flagCheckSyncAvg;
    }
    if (runShared && runPureSync) {
        std::cout << " speedup_event_pure_over_shared=" << (sharedAvg > 0.0 ? pureSyncAvg / sharedAvg : 0.0);
    }
    if (runShared && runFlagCheckSync) {
        std::cout << " speedup_event_flag_check_over_shared=" <<
            (sharedAvg > 0.0 ? flagCheckSyncAvg / sharedAvg : 0.0);
    }
    std::cout << std::endl;
    if (runAicpuReadBench) {
        PrintReadBenchRun("last_aicpu_read_bench_detail", opt, lastReadBench);
    }
    if (runAicpuReadChase) {
        PrintReadChaseRun("last_aicpu_read_chase_detail", opt, lastReadChase);
    }
    if (runShared) {
        PrintRun("last_shared_detail", opt, lastShared);
    }
    if (runPureSync) {
        PrintRun("last_event_sync_pure_detail", opt, lastPureSync);
    }
    if (runFlagCheckSync) {
        PrintRun("last_event_sync_with_flag_check_detail", opt, lastFlagCheckSync);
    }

    for (auto event : events) {
        if (event != nullptr) (void)aclrtDestroyEvent(event);
    }
    FreeBuffers(&buf);
    if (aivStream != nullptr) (void)aclrtDestroyStream(aivStream);
    if (aicpuStream != nullptr) (void)aclrtDestroyStream(aicpuStream);
    (void)aclrtResetDevice(opt.device);
    (void)aclFinalize();
    return 0;
}
